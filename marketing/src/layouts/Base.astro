---
import '../styles/global.css';
import UtilityBar from '../components/UtilityBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConversionPanel from '../components/ConversionPanel.astro';
import T from '../components/T.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  heroDark?: boolean;
  showConversion?: boolean;
  active?: string;
}
const {
  title = 'Seonbae — Verified tutors from Korea’s top universities',
  description = 'Live online tutoring from verified Seoul National University, Korea University, and Yonsei University students. Built for Korean learners studying IB, AP, A Level, IGCSE, and tests abroad.',
  heroDark = false,
  showConversion = true,
  active = Astro.url.pathname,
} = Astro.props;
// Absolute URLs for share cards. KakaoTalk, Slack, and iMessage all refuse a
// relative og:image, and Google needs a canonical to attribute the site icon.
const site = Astro.site ?? new URL('https://seonbaetutor.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;
// `?still` renders reveal elements in their final state (used for headless capture).
const still = Astro.url.searchParams.has('still');
---
<!doctype html>
<html lang="ko" data-lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- One icon everywhere. These are the real Seonbae mark baked onto white
         (see scripts/generate-brand-assets.mjs); the transparent /logo.png used
         to be served here, which is why search results showed a different mark. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- Chrome reads the manifest, not the <link rel=icon> list, when it builds
         a home-screen or new-tab shortcut tile. Without it the tile falls back
         to whatever icon the local favicon cache happens to hold. -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#163a51" />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/cookie-consent.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Seonbae" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Seonbae" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f2f0ea" />
    {still && <style is:global>.reveal{opacity:1 !important;transform:none !important;transition:none !important;} html{scroll-behavior:auto !important;}</style>}

    <!-- Set language before paint so the toggle never flashes. Saved choice
         wins; first-time visits open in Korean across every route. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('seonbae-lang');
          var lang = saved || 'ko';
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);
        } catch (e) {
          document.documentElement.setAttribute('data-lang', 'ko');
          document.documentElement.setAttribute('lang', 'ko');
        }
      })();
    </script>

    <!-- Start the session check before paint. Auth controls render as a fixed
         skeleton until this settles, so a returning user never sees a brief
         and incorrect Log in label. -->
    <script is:inline>
      window.__seonbaeSessionPromise = fetch('/api/auth/session', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      }).then(function (response) {
        return response.ok ? response.json() : { authenticated: false };
      }).catch(function () {
        return { authenticated: false };
      });
    </script>

    <!-- Hanken Grotesk is self-hosted (see global.css) so nothing third-party
         blocks first paint. Preload the latin file the first screen needs. -->
    <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Pretendard (Korean) loads without blocking: the print media trick lets
         the browser paint first, then swaps the stylesheet in. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link"><T en="Skip to content" ko="본문으로 바로가기" /></a>
    <UtilityBar />
    <Header heroDark={heroDark} active={active} />
    <main id="main">
      <slot />
    </main>
    {showConversion && <ConversionPanel />}
    <Footer />
    <CookieConsent />

    <style is:global>
      .skip-link {
        position: absolute;
        left: 16px;
        top: -60px;
        z-index: 200;
        background: var(--violet);
        color: #fff;
        padding: 10px 16px;
        border-radius: var(--r-pill);
        font-weight: 600;
        font-size: 0.9rem;
        transition: top 0.18s ease;
      }
      .skip-link:focus { top: 16px; }
    </style>

    <script>
      // Language toggle: persist the choice and flip the root flag. All visible
      // strings react through CSS (html[data-lang]), so no re-render is needed.
      document.querySelectorAll('[data-set-lang]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-set-lang') || 'en';
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);
          try { localStorage.setItem('seonbae-lang', lang); } catch (e) {}
          window.dispatchEvent(new CustomEvent('seonbae:language-change', { detail: { lang } }));
        });
      });

      const syncLocalizedAttributes = () => {
        const lang = document.documentElement.dataset.lang === 'en' ? 'en' : 'ko';
        document.querySelectorAll<HTMLElement>('[data-placeholder-en]').forEach((node) => {
          node.setAttribute('placeholder', node.dataset[lang === 'ko' ? 'placeholderKo' : 'placeholderEn'] ?? '');
        });
        document.querySelectorAll<HTMLElement>('[data-aria-en]').forEach((node) => {
          node.setAttribute('aria-label', node.dataset[lang === 'ko' ? 'ariaKo' : 'ariaEn'] ?? '');
        });
        document.querySelectorAll<HTMLOptionElement>('[data-label-en]').forEach((option) => {
          option.textContent = option.dataset[lang === 'ko' ? 'labelKo' : 'labelEn'] ?? option.value;
        });
      };
      syncLocalizedAttributes();
      window.addEventListener('seonbae:language-change', syncLocalizedAttributes);

      // Scroll reveal for .reveal elements.
      //
      // Content must never depend on an animation firing. A fractional
      // threshold can never be met by an element taller than the viewport (the
      // 8000px rate card left the whole pricing page blank), and an observer
      // can fail outright in embedded/offscreen frames. So: reveal on scroll
      // by measurement, with the observer only as an enhancement, and a
      // guaranteed sweep on load.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = [...document.querySelectorAll('.reveal')] as HTMLElement[];

      const show = (el: HTMLElement) => {
        if (el.classList.contains('is-in')) return;
        el.style.transitionDelay = el.dataset.delay ?? '0ms';
        el.classList.add('is-in');
      };

      if (reduce) {
        els.forEach(show);
      } else {
        const sweep = () => {
          let pending = false;
          for (const el of els) {
            if (el.classList.contains('is-in')) continue;
            if (el.getBoundingClientRect().top < window.innerHeight * 0.92) show(el);
            else pending = true;
          }
          if (!pending) window.removeEventListener('scroll', onScroll);
        };

        let queued = false;
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => { queued = false; sweep(); });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        sweep();

        // Last resort: nothing stays invisible, whatever the environment.
        setTimeout(() => els.forEach(show), 3000);
      }
    </script>
    <script src="/site-auth.js" defer></script>
    <script src="/cookie-consent.js" defer></script>
  </body>
</html>
