---
// Resolve bilingual copy on the server. Each locale URL contains only the
// requested language, so crawlers, assistive technology and no-JS visitors all
// receive the same text.
//
//   <h1 class="display"><T en="Hello" ko="안녕하세요" /></h1>
//   <T en="Read" ko="읽기" tag="span" />
//
// Use `tag` when the pair must be block level on its own (e.g. two <p>).
interface Props {
  en: string;
  ko: string;
  tag?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { en, ko, tag = 'span', class: cls = '' } = Astro.props;
const Tag = tag as any;
import { localeFromPath, pick } from '../i18n/locale';
const locale = localeFromPath(Astro.url.pathname);
const value = pick(locale, en, ko);
---
<Tag lang={locale} class:list={[{ kr: locale === 'ko' }, cls]}>{value}</Tag>
