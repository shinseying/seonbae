---
// Thin navy utility strip above the header (standing facts), in the spirit of
// eduvet's top bar. Scrolls away; the header below it is what stays sticky.
import T from './T.astro';
import { ui } from '../i18n/home';
---
<div class="utilbar">
  <div class="container utilbar__inner">
    <p class="utilbar__left">
      <T en={ui.utilLeft.en} ko={ui.utilLeft.ko} />
    </p>
  </div>
</div>

<style>
  .utilbar {
    background: var(--footer);
    color: var(--on-dark-soft);
    font-size: 0.76rem;
    border-bottom: 1px solid rgba(240, 238, 235, 0.08);
  }
  .utilbar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 33px;
  }
  .utilbar__left { display: inline-flex; align-items: center; letter-spacing: 0.13em; font-weight: 700; }
  @media (max-width: 760px) {
    .utilbar__inner { gap: 10px; min-height: 29px; }
    .utilbar__left { font-size: 0.72rem; }
  }
</style>
