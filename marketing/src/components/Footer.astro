---
import Logo from './Logo.astro';
import T from './T.astro';
import { ui } from '../i18n/home';
import { footerLearn, footerCompany } from '../lib/nav';
import { localeFromPath, localePath } from '../i18n/locale';

const year = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const link = (href: string) => localePath(href, locale);
const loginHref = locale === 'en' ? '/login?lang=en' : '/login';
const signupHref = locale === 'en' ? '/login?mode=signup&lang=en' : '/login?mode=signup';
const tutorSignupHref = locale === 'en' ? '/login?mode=signup&role=tutor&lang=en' : '/login?mode=signup&role=tutor';
const socials = [
  { name: 'Instagram', href: '#', path: 'M12 8.5A3.5 3.5 0 1 0 12 15.5 3.5 3.5 0 0 0 12 8.5Zm5-2a1 1 0 1 0 0 2 1 1 0 0 0 0-2ZM7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm0 2a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Z' },
  { name: 'LinkedIn', href: '#', path: 'M6.94 5A1.94 1.94 0 1 1 3.06 5a1.94 1.94 0 0 1 3.88 0ZM3.4 8.5h3.1V21H3.4Zm5.1 0h2.97v1.7h.04c.41-.78 1.42-1.6 2.93-1.6 3.13 0 3.71 2.06 3.71 4.74V21h-3.1v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H8.5Z' },
  { name: 'KakaoTalk', href: '#', path: 'M12 4C7 4 3 7.13 3 11c0 2.42 1.63 4.55 4.1 5.8-.15.5-.7 2.42-.75 2.66-.06.3.11.3.23.22.1-.07 2.5-1.7 3.53-2.4.6.08 1.23.13 1.89.13 5 0 9-3.13 9-7 0-3.87-4-7-9-7Z' },
];
---
<footer class="footer">
  <div class="container footer-inner">
    <!-- Brand block, then three plainly labelled link columns. No decorative
         artwork: a footer's job is to be scanned, not admired. -->
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo tone="light" href="/about" />
        <p class="footer-promise"><T en={ui.footer.promise.en} ko={ui.footer.promise.ko} /></p>

        <form class="newsletter" aria-label="Newsletter signup">
          <label for="footer-email" class="newsletter-label"><T en={ui.footer.newsletterLabel.en} ko={ui.footer.newsletterLabel.ko} /></label>
          <div class="newsletter-row">
            <input id="footer-email" type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
            <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit"><T en={ui.footer.subscribe.en} ko={ui.footer.subscribe.ko} /></button>
          </div>
          <p class="newsletter-note" role="status" hidden data-done><T en={ui.footer.newsletterDone.en} ko={ui.footer.newsletterDone.ko} /></p>
        </form>
      </div>

      <nav class="footer-links" aria-label="Footer">
        <div>
          <h3 class="footer-col-title"><T en={ui.footer.colLearn.en} ko={ui.footer.colLearn.ko} /></h3>
          <ul>{footerLearn.map((i) => <li><a href={link(i.href)}><T en={i.label} ko={i.labelKo} /></a></li>)}</ul>
        </div>
        <div>
          <h3 class="footer-col-title"><T en={ui.footer.colCompany.en} ko={ui.footer.colCompany.ko} /></h3>
          <ul>{footerCompany.map((i) => <li><a href={link(i.href)}><T en={i.label} ko={i.labelKo} /></a></li>)}</ul>
        </div>
        <div>
          <h3 class="footer-col-title"><T en="Get started" ko="시작하기" /></h3>
          <ul>
            <li><a href={link('/get-matched')}><T en="Find a tutor" ko="선배 찾기" /></a></li>
            <li><a href={tutorSignupHref}><T en="Tutor sign up" ko="튜터 회원가입" /></a></li>
            <li><a href="/portal"><T en="Portal" ko="포털" /></a></li>
            <li><a href={loginHref}><T en="Log in" ko="로그인" /></a></li>
            <li><a href={signupHref}><T en="Sign up" ko="회원가입" /></a></li>
            <li><a href={link('/pricing#faq')}><T en="FAQ" ko="자주 묻는 질문" /></a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-base">
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.href} aria-label={s.name} title={s.name}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="footer-copy">© {year} Seonbae · <T en={ui.footer.base.en} ko={ui.footer.base.ko} /></p>
      <p class="footer-legal"><a href={link('/privacy')}><T en="Privacy policy" ko="개인정보 처리방침" /></a> · <a href={link('/terms')}><T en="Terms" ko="이용약관" /></a> · <button type="button" data-cookie-settings><T en="Cookie settings" ko="쿠키 설정" /></button> · <a href={link('/verification')}><T en={ui.footer.legalVerify.en} ko={ui.footer.legalVerify.ko} /></a> · <a href={link('/contact')}><T en={ui.footer.legalContact.en} ko={ui.footer.legalContact.ko} /></a> · seonbaetutor.com</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer);
    color: var(--on-dark);
    padding-block: clamp(52px, 7vw, 84px) 28px;
  }
  .footer :global(h1), .footer :global(h2), .footer :global(h3) { color: var(--on-dark); }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(36px, 6vw, 88px);
    padding-bottom: 44px;
  }
  .footer-brand { max-width: 420px; }
  .footer-promise {
    margin-top: 18px;
    color: var(--on-dark-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .newsletter { margin-top: 30px; }
  .newsletter-label { display: block; font-size: 0.9rem; color: var(--on-dark-soft); margin-bottom: 10px; }
  .newsletter-row {
    display: flex;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line-dark);
    border-radius: var(--r-pill);
    padding: 5px 5px 5px 18px;
    max-width: 400px;
  }
  .newsletter-row input {
    flex: 1;
    background: none;
    border: none;
    color: var(--on-dark);
    outline: none;
    font-size: 16px;
    min-width: 0;
  }
  .newsletter-row input::placeholder { color: rgba(244, 241, 232, 0.4); }
  .newsletter-row button {
    border: none;
    background: var(--mint);
    color: #0a1a2f;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: filter 0.16s ease;
    white-space: nowrap;
  }
  .newsletter-row button:hover { filter: brightness(1.06); }
  .newsletter-note { margin-top: 10px; font-size: 0.88rem; color: var(--mint); }

  .socials { display: flex; gap: 8px; }
  .socials a {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    color: var(--on-dark-soft);
    transition: color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  .socials a:hover { color: var(--footer); background: var(--on-dark); border-color: var(--on-dark); }

  .footer-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .footer-col-title {
    font-family: var(--body);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .footer-links ul { display: flex; flex-direction: column; gap: 12px; }
  .footer-links a { color: var(--on-dark); font-size: 0.98rem; transition: color 0.16s ease; }
  .footer-links a:hover { color: var(--mint); }

  .footer-base {
    border-top: 1px solid var(--line-dark);
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    color: var(--on-dark-soft);
    font-size: 0.85rem;
  }
  .footer-copy { flex: 1 1 auto; }
  .footer-legal a, .footer-legal button { color: var(--on-dark-soft); text-decoration: underline; text-underline-offset: 3px; }
  .footer-legal button { padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }
  .footer-legal a:hover, .footer-legal button:hover { color: var(--on-dark); }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-links { grid-template-columns: 1fr 1fr; gap: 28px 24px; }
  }
  @media (max-width: 520px) {
    .footer-base { flex-direction: column; align-items: flex-start; }
  }
  @media (min-width: 768px) {
    .newsletter-row input { font-size: .95rem; }
  }
</style>

<script>
  import { submitForm } from '../lib/forms';

  const form = document.querySelector('.newsletter') as HTMLFormElement | null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const note = form.querySelector('[data-done]') as HTMLElement | null;
    const input = form.querySelector('input[type="email"]') as HTMLInputElement | null;
    if (!input?.checkValidity()) { input?.reportValidity(); return; }

    try {
      await submitForm(form, 'Newsletter signup from seonbaetutor.com');
      if (note) {
        note.textContent = document.documentElement.dataset.lang === 'ko'
          ? '신청이 완료되었습니다. 곧 소식을 전해드릴게요.'
          : 'Thanks. We will be in touch soon.';
        note.hidden = false;
      }
      input.value = '';
    } catch {
      if (note) {
        note.textContent = document.documentElement.dataset.lang === 'ko'
          ? '신청하지 못했습니다. admissions@seonbaetutor.com으로 문의해 주세요.'
          : 'Could not sign you up. Please email admissions@seonbaetutor.com.';
        note.hidden = false;
      }
    }
  });
</script>
