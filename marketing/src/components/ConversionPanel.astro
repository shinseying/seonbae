---
import Contour from './Contour.astro';
import Avatar from './Avatar.astro';
import T from './T.astro';
import { ui } from '../i18n/home';
import { localeFromPath, localePath } from '../i18n/locale';

interface Props {
  eyebrow?: string;
  heading?: string;
  copy?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  eyebrow = 'Your next step',
  heading = 'The right tutor is one conversation away.',
  copy = 'Share your goal and we will match you with a verified tutor from the top universities in Korea. You will see their record before you ever book a lesson.',
  ctaLabel = 'Get matched',
  ctaHref = '/get-matched',
} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const link = (href: string) => localePath(href, locale);

const orbit = [
  { name: 'Jiwoo H.', accent: 'mint' as const },
  { name: 'Minseo K.', accent: 'lavender' as const },
  { name: 'Daniel P.', accent: 'violet' as const },
  { name: 'Haeun L.', accent: 'butter' as const },
];
---
<section class="section conv bg-white">
  <div class="container">
    <div class="conv-panel has-contour">
      <Contour color="rgba(146,94,0,0.16)" opacity={0.55} variant="b" />

      <div class="conv-orbit" aria-hidden="true">
        {orbit.map((p, i) => (
          <span class={`orbit-dot orbit-dot--${i + 1}`}>
            <Avatar name={p.name} accent={p.accent} size={i % 2 === 0 ? 66 : 54} />
          </span>
        ))}
      </div>

      <div class="conv-content">
        <span class="eyebrow"><T en={ui.conversion.eyebrow.en} ko={ui.conversion.eyebrow.ko} /></span>
        <h2 class="h2 conv-heading"><T en={ui.conversion.heading.en} ko={ui.conversion.heading.ko} /></h2>
        <p class="lead conv-copy"><T en={ui.conversion.copy.en} ko={ui.conversion.copy.ko} /></p>
        <div class="cta-row conv-cta">
          <a href={link('/get-matched')} class="btn btn--primary btn--lg">
            <span><T en={ui.conversion.cta.en} ko={ui.conversion.cta.ko} /></span>
            <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
          <a href={link('/how-it-works')} class="textlink">
            <span><T en={ui.seeHow.en} ko={ui.seeHow.ko} /></span>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Honey panel on a white section, the same on every page that uses it. */
  .conv-panel {
    position: relative;
    background: #fdf3dd;
    border-radius: var(--r-xl);
    padding: clamp(44px, 7vw, 96px) clamp(24px, 6vw, 88px);
    overflow: hidden;
    text-align: center;
  }
  .conv-content { position: relative; z-index: 2; max-width: 620px; margin-inline: auto; }
  .conv-heading { margin-top: 16px; }
  .conv-copy { margin-top: 16px; color: #71603a; }
  .conv-cta { justify-content: center; margin-top: 28px; }
  .conv .eyebrow { color: #a07b2a; }

  .conv-orbit { position: absolute; inset: 0; z-index: 1; }
  .orbit-dot { position: absolute; }
  .orbit-dot--1 { top: 15%; left: 8%; }
  .orbit-dot--2 { bottom: 16%; left: 13%; }
  .orbit-dot--3 { top: 18%; right: 9%; }
  .orbit-dot--4 { bottom: 14%; right: 14%; }

  @media (max-width: 900px) {
    .orbit-dot--2, .orbit-dot--3 { display: none; }
    .orbit-dot--1 { top: 6%; left: 6%; }
    .orbit-dot--4 { bottom: 6%; right: 6%; }
  }
  @media (max-width: 560px) {
    .conv-orbit { display: none; }
  }
</style>
