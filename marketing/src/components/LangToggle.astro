---
// Real locale links keep each language shareable, crawlable, and usable with
// JavaScript disabled.
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
import { localeFromPath, pathForLocale } from '../i18n/locale';
const locale = localeFromPath(Astro.url.pathname);
---
<!-- ?lang= makes the switch work without JavaScript: middleware stores the
     choice in the seonbae-lang cookie and strips the parameter. -->
<div class:list={['langtoggle', cls]} role="group" aria-label="Language">
  <a href={`${pathForLocale(Astro.url.pathname, 'ko')}?lang=ko`} lang="ko" data-set-lang="ko" data-clean-href={pathForLocale(Astro.url.pathname, 'ko')} aria-label="한국어" aria-current={locale === 'ko' ? 'page' : undefined}>KO</a>
  <a href={`${pathForLocale(Astro.url.pathname, 'en')}?lang=en`} lang="en" data-set-lang="en" data-clean-href={pathForLocale(Astro.url.pathname, 'en')} aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) => {
    if (link.dataset.localePreferenceBound) return;
    link.dataset.localePreferenceBound = 'true';
    link.addEventListener('click', (event) => {
      const lang = link.dataset.setLang === 'en' ? 'en' : 'ko';
      document.cookie = `seonbae-lang=${lang}; path=/; max-age=31536000; samesite=lax${location.protocol === 'https:' ? '; secure' : ''}`;
      try { localStorage.setItem('seonbae-lang', lang); } catch {}
      // With the cookie set, go straight to the clean URL and skip the
      // middleware hop. Modified clicks keep the ?lang= link for a new tab.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      location.assign(link.dataset.cleanHref || link.pathname);
    });
  });
</script>

<style>
  .langtoggle {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    background: rgba(12, 12, 12, 0.05);
    border-radius: var(--r-pill);
    gap: 2px;
    flex: none;
  }
  .langtoggle a {
    border: none;
    background: none;
    padding: 6px 11px;
    border-radius: var(--r-pill);
    font-family: var(--body);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    line-height: 1;
  }
  .langtoggle a[lang='ko'] { font-family: var(--kr); }
  .langtoggle a:hover { color: var(--ink); }

  /* Active pill, chosen purely from the root language flag. Default = KO. */
  .langtoggle [aria-current='page'] {
    background: var(--white);
    color: var(--violet);
    box-shadow: var(--shadow-sm);
  }

  /* On the transparent (hero-dark) header, lift contrast. */
  .site-header:not(.is-solid) .langtoggle {
    background: rgba(255, 255, 255, 0.12);
  }
  .site-header:not(.is-solid) .langtoggle a { color: var(--on-dark-soft); }
  .site-header:not(.is-solid) .langtoggle a:hover { color: #fff; }
  .site-header:not(.is-solid) .langtoggle [aria-current='page'] {
    background: rgba(255, 255, 255, 0.92);
    color: var(--violet);
  }
</style>
