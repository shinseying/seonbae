---
// Seonbae wordmark + the supplied brand marks. Each tone uses its original
// artwork rather than recolouring one raster in CSS.
interface Props {
  tone?: 'ink' | 'light';
  href?: string;
  class?: string;
}
const { tone = 'ink', href = '/', class: cls = '' } = Astro.props;
const wordColor = tone === 'light' ? 'var(--on-dark)' : 'var(--ink)';
const mark = tone === 'light' ? '/logo-light.png' : '/logo.png';
import { localeFromPath, localePath } from '../i18n/locale';
const resolvedHref = localePath(href, localeFromPath(Astro.url.pathname));
---

<a href={resolvedHref} class={`logo ${cls}`} aria-label={href === '/' ? 'Seonbae home' : 'About Seonbae'}>
  <img src={mark} alt="" class="logo__img" width="58" height="45" />
  <span class="logo__word" style={`color:${wordColor}`}>Seonbae</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .logo__img { width: 58px; height: 45px; flex: none; object-fit: contain; }
  .logo__word {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.48rem;
    letter-spacing: -0.03em;
  }
</style>
