---
// Pill buttons with trailing circular arrow disc, plus a text-link variant.
interface Props {
  href?: string;
  label: string;
  labelKo?: string;
  variant?: 'primary' | 'secondary' | 'ghost-dark' | 'text' | 'text-light';
  size?: 'md' | 'lg';
  class?: string;
  arrow?: 'diag' | 'right';
}
const {
  href = '#',
  label,
  labelKo,
  variant = 'primary',
  size = 'md',
  class: cls = '',
  arrow = 'diag',
} = Astro.props;

const isText = variant === 'text' || variant === 'text-light';
import T from './T.astro';
import { localeFromPath, localePath } from '../i18n/locale';
const resolvedHref = localePath(href, localeFromPath(Astro.url.pathname));
const arrowPath =
  arrow === 'diag'
    ? 'M6 14L14 6M14 6H7M14 6V13'
    : 'M4 10h11M11 6l4 4-4 4';
---

{isText ? (
  <a href={resolvedHref} class={`textlink ${variant === 'text-light' ? 'textlink--light' : ''} ${cls}`}>
    <span>{labelKo ? <T en={label} ko={labelKo} /> : label}</span>
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d={arrowPath} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
) : (
  <a
    href={resolvedHref}
    class={`btn btn--${variant} ${size === 'lg' ? 'btn--lg' : ''} ${cls}`}
  >
    <span>{labelKo ? <T en={label} ko={labelKo} /> : label}</span>
    <span class="btn__disc" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="none">
        <path d={arrowPath} stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </a>
)}
