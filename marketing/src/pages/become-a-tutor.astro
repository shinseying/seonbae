---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';

const criteria = [
  { t: { en: 'SKY students', ko: 'SKY 재학생' }, c: { en: 'Students who study at Seoul National University, Yonsei University, or Korea University.', ko: '서울대학교, 연세대학교, 고려대학교에 재학 중인 학생.' } },
  { t: { en: 'Top performers', ko: '최상위 성적' }, c: { en: 'SAT 1500+, a 7 in your IB subject, IELTS 8.0+, or an equal top result.', ko: 'SAT 1500점 이상, IB 해당 과목 7점, IELTS 8.0 이상, 또는 그에 준하는 최상위 성적.' } },
  { t: { en: 'A passion to teach', ko: '열정적인 선생님' }, c: { en: 'We want tutors who are eager to teach, not people doing it only for the money.', ko: '물론 돈도 좋지만, 선배는 열정적인 선생님이어야 합니다.' } },
];

const steps = [
  { n: '01', t: { en: 'Apply', ko: '지원' }, c: { en: 'Tell us your university, subjects, and results.', ko: '대학, 과목, 성적을 알려주세요.' } },
  { n: '02', t: { en: 'Verify', ko: '검증' }, c: { en: 'We check enrolment, scores, and identity.', ko: '재학, 성적, 신원을 확인합니다.' } },
  { n: '03', t: { en: 'Interview', ko: '인터뷰' }, c: { en: 'A short interview and a sample lesson.', ko: '짧은 인터뷰와 샘플 수업.' } },
  { n: '04', t: { en: 'Teach', ko: '수업 시작' }, c: { en: 'Set your availability and take your first match.', ko: '가능 시간을 정하고 첫 매칭을 받습니다.' } },
];

const keep = [
  { t: { en: 'Fair, fixed pay', ko: '공정하고 고정된 보수' }, c: { en: 'Each subject pays a set amount per hour. What you see is what you keep.', ko: '과목마다 시간당 정해진 금액. 보이는 그대로 받습니다.' } },
  { t: { en: 'Always the full amount', ko: '언제나 전액' }, c: { en: 'Seonbae carries the currency spread, so you receive the full won amount.', ko: '환율 차이는 선배가 부담합니다. 언제나 원화 전액을 받습니다.' } },
  { t: { en: 'Your schedule', ko: '나의 일정' }, c: { en: 'Set your own hours and subjects. Accept or decline each match.', ko: '가능 시간과 과목을 직접 정하고, 매칭을 수락하거나 거절합니다.' } },
];
---
<Base title="Become a tutor | Seonbae" active="/become-a-tutor" description="Teach with Seonbae. Verified tutors from Seoul National University, Korea University, and Yonsei University, paid fairly for every lesson.">
  <!-- Hero -->
  <section class="section bt-hero">
    <div class="container bt-hero__inner">
      <div class="reveal is-in">
        <span class="eyebrow"><T en="Teach with Seonbae" ko="선배로 함께하기" /></span>
        <h1 class="display bt-title"><T en="Be the mentor someone needed." ko="누군가에게 꼭 필요한 선배가 되어주세요." /></h1>
        <p class="lead" style="margin-top:20px"><T en="Teach the subject you topped, on your own schedule. Get paid fairly, and let the platform handle everything unrelated to the lesson." ko="자신 있는 과목을 원하는 시간에, 만족스러운 보수로 가르치세요. 수업 이외의 일은 저희가 도맡아 합니다." /></p>
        <div class="cta-row" style="margin-top:30px">
          <a href="#apply" class="btn btn--primary btn--lg">
            <span><T en="Apply to teach" ko="지원하기" /></span>
            <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we look for -->
  <section class="section bg-white">
    <div class="container">
      <div class="sec-intro reveal">
        <span class="eyebrow"><T en="Tutor criteria" ko="선배의 기준" /></span>
        <h2 class="h2"><T en="Who we look for" ko="이런 분을 찾습니다." /></h2>
      </div>
      <div class="grid three-col">
        {criteria.map((k) => (
          <article class="bt-card reveal">
            <h3 class="card-title"><T en={k.t.en} ko={k.t.ko} /></h3>
            <p class="body"><T en={k.c.en} ko={k.c.ko} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section bg-cream">
    <div class="container">
      <div class="sec-intro reveal">
        <span class="eyebrow"><T en="How applying works" ko="지원 절차" /></span>
        <h2 class="h2"><T en="Four steps to your first lesson." ko="첫 수업까지, 네 단계." /></h2>
      </div>
      <div class="grid four-col bt-steps">
        {steps.map((s) => (
          <div class="bt-step reveal">
            <span class="bt-step__n">{s.n}</span>
            <h3 class="bt-step__t"><T en={s.t.en} ko={s.t.ko} /></h3>
            <p class="body"><T en={s.c.en} ko={s.c.ko} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What you keep -->
  <section class="section bg-white">
    <div class="container">
      <div class="sec-intro reveal">
        <span class="eyebrow"><T en="What you keep" ko="당신이 받는 것" /></span>
        <h2 class="h2"><T en="Paid fairly, every time." ko="언제나 정당한 보수." /></h2>
      </div>
      <div class="grid three-col">
        {keep.map((k) => (
          <article class="bt-card surface-butter reveal">
            <h3 class="card-title"><T en={k.t.en} ko={k.t.ko} /></h3>
            <p class="body"><T en={k.c.en} ko={k.c.ko} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Apply -->
  <!-- The application itself, not a hand-off. Centred and wide on purpose: it
       is the only thing this page asks anyone to do. -->
  <section class="section bg-cream apply" id="apply">
    <div class="container">
      <form class="apply-form card reveal" novalidate>
        <h2 class="h2 apply-form__title"><T en="Apply to tutor." ko="지원서 작성" /></h2>

        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="form-grid">
          <div class="form-field">
            <label for="ap-name"><T en="Full name" ko="이름" /></label>
            <input id="ap-name" name="fullName" class="form-control" type="text" required autocomplete="name" minlength="2" maxlength="80" />
          </div>
          <div class="form-field">
            <label for="ap-phone"><T en="Mobile number" ko="휴대전화번호" /></label>
            <input id="ap-phone" name="phone" class="form-control" type="tel" required autocomplete="tel" inputmode="tel" maxlength="24" placeholder="01012345678" />
          </div>
        </div>

        <div class="form-field">
          <label for="ap-email"><T en="University email" ko="학교 이메일" /></label>
          <input id="ap-email" name="email" class="form-control" type="email" required autocomplete="email" maxlength="254" placeholder="you@snu.ac.kr" aria-describedby="ap-email-hint" />
          <p class="apply-hint" id="ap-email-hint"><T en="Must end in .ac.kr. Enrolment is verified against this address." ko="ac.kr로 끝나는 주소만 가능합니다. 재학 여부를 이 주소로 확인합니다." /></p>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <label for="ap-uni"><T en="University" ko="대학" /></label>
            <select id="ap-uni" name="university" class="form-control" required>
              <option value="서울대학교" data-label-en="Seoul National University" data-label-ko="서울대학교">서울대학교</option>
              <option value="고려대학교" data-label-en="Korea University" data-label-ko="고려대학교">고려대학교</option>
              <option value="연세대학교" data-label-en="Yonsei University" data-label-ko="연세대학교">연세대학교</option>
            </select>
          </div>
          <div class="form-field">
            <label for="ap-major"><T en="Course and year" ko="전공과 학년" /></label>
            <input id="ap-major" name="major" class="form-control" type="text" required maxlength="120" data-placeholder-en="International Studies, 2nd year" data-placeholder-ko="국제학부 2학년" />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <label for="ap-curriculum"><T en="Curriculum" ko="지원 커리큘럼" /></label>
            <select id="ap-curriculum" name="curriculum" class="form-control" required>
              <option>IB</option>
              <option>AP</option>
              <option>A-Level</option>
              <option>IGCSE</option>
              <option>SAT</option>
              <option>ACT</option>
              <option>TOEFL</option>
              <option>IELTS</option>
            </select>
          </div>
          <div class="form-field">
            <label for="ap-languages"><T en="Languages you teach in" ko="수업 가능 언어" /></label>
            <input id="ap-languages" name="languages" class="form-control" type="text" required maxlength="80" data-placeholder-en="Korean, English" data-placeholder-ko="한국어, 영어" />
          </div>
        </div>

        <div class="form-field">
          <label for="ap-format"><T en="Lesson format you prefer" ko="선호하는 수업 형식" /></label>
          <select id="ap-format" name="lessonFormat" class="form-control" required>
            <option value="온라인 1:1" data-label-en="Online 1:1" data-label-ko="온라인 1:1">온라인 1:1</option>
            <option value="온라인 소그룹" data-label-en="Online small group" data-label-ko="온라인 소그룹">온라인 소그룹</option>
            <option value="대면 1:1" data-label-en="In person 1:1" data-label-ko="대면 1:1">대면 1:1</option>
            <option value="온라인·대면 모두" data-label-en="Online or in person" data-label-ko="온라인·대면 모두">온라인·대면 모두</option>
          </select>
        </div>

        <fieldset class="form-field subject-scores">
          <legend><T en="Scores for the subjects you want to teach" ko="가르칠 과목의 과목별 성적" /></legend>
          <p class="apply-hint"><T en="One row per subject, with the score for that subject. This is what your public card shows." ko="가르칠 과목마다 한 줄씩, 그 과목의 성적을 입력해 주세요. 공개 카드에 표시되는 내용입니다." /></p>
          <div data-subject-rows></div>
          <button type="button" class="subject-add" data-subject-add aria-label="과목 추가">
            <span aria-hidden="true">+</span>
          </button>
        </fieldset>

        <div class="form-field">
          <label for="ap-credential"><T en="Score report" ko="성적 증명" /></label>
          <input id="ap-credential" name="credential" class="form-control apply-file" type="file" required accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" aria-describedby="ap-credential-hint" />
          <p class="apply-hint" id="ap-credential-hint"><T en="One file covering the scores above. PDF, JPG, or PNG. Up to 10 MB." ko="위 성적을 확인할 수 있는 파일 하나. PDF, JPG 또는 PNG. 최대 10MB." /></p>
        </div>

        <div class="form-field">
          <label for="ap-letter"><T en="Certificate of enrolment" ko="학적증명서" /></label>
          <input id="ap-letter" name="acceptanceLetter" class="form-control apply-file" type="file" required accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" aria-describedby="ap-letter-hint" />
          <p class="apply-hint" id="ap-letter-hint"><T en="PDF, JPG, or PNG. Up to 10 MB." ko="PDF, JPG 또는 PNG. 최대 10MB." /></p>
        </div>

        <div class="form-field">
          <label for="ap-intro"><T en="Teaching experience" ko="소개 및 수업 경험" /></label>
          <textarea id="ap-intro" name="introduction" class="form-control" required rows="5" maxlength="2000" data-placeholder-en="Why you are applying, what you have taught, and when you are free." data-placeholder-ko="지원 동기와 수업 경험, 가능한 시간대를 적어 주세요."></textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--lg apply-submit">
          <span data-submit-label><T en="Submit application" ko="지원서 제출" /></span>
          <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </button>

        <p class="apply-status" role="status" aria-live="polite" data-status hidden></p>
        <p class="apply-note"><T en="Accounts are created by the Seonbae team after review. Submitting this form does not create a login." ko="계정은 심사 후 선배 팀이 직접 만들어 드립니다. 이 폼을 제출해도 계정이 생성되지는 않습니다." /></p>
      </form>
    </div>
  </section>

</Base>

<style>
  .bt-hero { padding-block: clamp(40px, 6vw, 92px); }
  .bt-hero__inner { max-width: 62rem; }
  .bt-title { font-size: clamp(2.4rem, 5vw, 4rem); margin-top: 18px; }
  .sec-intro { max-width: 720px; margin-bottom: clamp(30px, 4vw, 50px); }
  .sec-intro .h2 { margin-top: 14px; }

  .bt-card {
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xl);
    padding: clamp(24px, 2.6vw, 34px);
    display: flex; flex-direction: column; gap: 10px;
  }
  .bt-card.surface-butter { border-color: transparent; }

  .bt-steps { margin-top: 8px; }
  .bt-step { display: flex; flex-direction: column; gap: 8px; }
  .bt-step__n { font-family: var(--display); font-weight: 800; font-size: 1rem; color: var(--violet); background: var(--violet-soft); width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 4px; }
  .bt-step__t { font-family: var(--display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; }

  /* One column, centred, and wide enough that the form is the page, not a
     sidebar on it. Field sizing is bumped over the site default because this
     is the only thing anyone does here. */
  .apply { padding-block: clamp(52px, 7vw, 104px); }
  .apply-form {
    max-width: 46rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(28px, 4vw, 56px);
    box-shadow: var(--shadow-md);
  }
  .apply-form__title { margin-bottom: 4px; font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .apply-form .form-control { padding: 14px 16px; font-size: 1rem; }
  .apply-form textarea.form-control { min-height: 132px; }
  .apply-file { padding: 11px 14px; line-height: 1.4; }
  .apply-file::file-selector-button {
    margin-right: 12px;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--r-sm);
    background: var(--violet);
    color: #fff;
    font-family: var(--body);
    font-weight: 700;
    font-size: 0.86rem;
    cursor: pointer;
  }
  .apply-hint { margin-top: 2px; font-size: 0.84rem; color: var(--muted); line-height: 1.45; }
  .apply-optional { font-weight: 500; color: var(--muted-soft); }
  .apply-submit { width: 100%; justify-content: space-between; margin-top: 6px; }
  .apply-submit[disabled] { opacity: 0.65; cursor: progress; }
  .apply-status { padding: 13px 16px; border-radius: var(--r-sm); font-size: 0.94rem; line-height: 1.5; }
  .apply-status[data-tone='error'] { background: #fbeeea; color: #8f302b; }
  .apply-status[data-tone='ok'] { background: var(--sage); color: var(--sage-ink); }
  .apply-note { color: var(--muted); font-size: 0.86rem; line-height: 1.55; }
  .apply-form .form-control:invalid:not(:placeholder-shown) { border-color: #bd332d; }

  /* Scores by subject. The rows are built in JS, so these selectors have to be
     global: Astro's scoping attribute is only stamped on server-rendered
     markup, and without :global the row would fall back to unstyled blocks. */
  .subject-scores { border: 0; padding: 0; margin: 0; }
  .subject-scores legend { font-weight: 600; margin-bottom: 4px; padding: 0; }
  /* The page's own .form-control sizing is scoped too, so the JS-built inputs
     need it restated globally to match the fields around them. */
  .subject-scores :global(.subject-row .form-control) { padding: 14px 16px; font-size: 1rem; }
  .subject-scores :global(.subject-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr) auto;
    gap: 10px;
    align-items: center;
    margin-top: 10px;
  }
  /* Same pill as the file pickers below, so every control in the form reads as
     one family. */
  .subject-scores :global(.subject-remove) {
    padding: 12px 18px;
    border: 0;
    border-radius: var(--r-sm);
    background: var(--violet);
    color: #fff;
    font-family: var(--body);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }
  .subject-scores :global(.subject-remove:hover) { background: var(--coral); }
  .subject-add {
    margin-top: 12px;
    justify-self: start;
    width: fit-content;
    padding: 12px 22px;
    border: 0;
    border-radius: var(--r-sm);
    background: var(--violet);
    color: #fff;
    font-family: var(--body);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .subject-add:hover { background: var(--coral); }
  @media (max-width: 620px) {
    .subject-scores :global(.subject-row) { grid-template-columns: minmax(0, 1fr) auto; }
    .subject-scores :global(.subject-row__score) { grid-column: 1; }
  }

</style>

<script>
  const form = document.querySelector('.apply-form') as HTMLFormElement | null;
  const submit = form?.querySelector('.apply-submit') as HTMLButtonElement | null;
  const submitLabel = form?.querySelector('[data-submit-label]') as HTMLElement | null;
  const status = form?.querySelector('[data-status]') as HTMLElement | null;
  const language = () => document.documentElement.dataset.lang === 'en' ? 'en' : 'ko';
  const t = (en: string, ko: string) => language() === 'en' ? en : ko;

  const refreshLanguage = () => {
    const lang = language();
    document.querySelectorAll<HTMLOptionElement>('[data-label-en]').forEach((option) => {
      option.textContent = lang === 'en' ? (option.dataset.labelEn || '') : (option.dataset.labelKo || '');
    });
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-placeholder-en]').forEach((field) => {
      field.placeholder = lang === 'en' ? (field.dataset.placeholderEn || '') : (field.dataset.placeholderKo || '');
    });
  };
  refreshLanguage();
  document.querySelectorAll('[data-set-lang]').forEach((button) => {
    button.addEventListener('click', () => requestAnimationFrame(refreshLanguage));
  });

  // One row per subject the applicant wants to teach: the score and its proof
  // travel together, so the reviewer never has to match a file to a subject.
  const rowHost = form?.querySelector('[data-subject-rows]') as HTMLElement | null;
  const addRowButton = form?.querySelector('[data-subject-add]') as HTMLButtonElement | null;

  // Subject and score sit on one line so the score reads as belonging to the
  // subject next to it. The proof for these scores is a single file below.
  const addSubjectRow = () => {
    if (!rowHost) return;
    const row = document.createElement('div');
    row.className = 'subject-row';
    row.innerHTML = `
      <input class="form-control subject-row__name" type="text" name="subjectName" required maxlength="80"
        data-placeholder-en="Subject" data-placeholder-ko="과목"
        aria-label="${t('Subject', '과목')}" />
      <input class="form-control subject-row__score" type="text" name="subjectScore" required maxlength="24"
        data-placeholder-en="Score" data-placeholder-ko="성적"
        aria-label="${t('Score', '성적')}" />
      <button type="button" class="subject-remove" aria-label="${t('Remove subject', '과목 삭제')}">&times;</button>
    `;
    row.querySelector('.subject-remove')?.addEventListener('click', () => {
      row.remove();
      // Always leave one row so the fieldset never looks broken.
      if (rowHost.children.length === 0) addSubjectRow();
    });
    rowHost.appendChild(row);
    refreshLanguage();
  };

  addRowButton?.addEventListener('click', addSubjectRow);
  addSubjectRow();

  const show = (message: string, tone: 'ok' | 'error') => {
    if (!status) return;
    status.textContent = message;
    status.dataset.tone = tone;
    status.hidden = false;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    // Honeypot: bots fill hidden fields, people do not.
    const data = new FormData(form);
    if (String(data.get('company') || '')) return;
    data.delete('company');

    if (submit) submit.disabled = true;
    if (submitLabel) submitLabel.textContent = t('Sending', '제출 중');
    if (status) status.hidden = true;

    try {
      const response = await fetch('/api/tutor-applications', { method: 'POST', body: data });
      const result = await response.json().catch(() => null);
      if (!response.ok) throw new Error(result?.error || t('The application could not be sent.', '지원서를 접수하지 못했습니다.'));

      form.reset();
      // The thank-you step asks where the applicant heard about us, and needs
      // the signed handle to attach the answer to this application.
      const handle = result && result.id && result.token
        ? `?id=${encodeURIComponent(result.id)}&t=${encodeURIComponent(result.token)}`
        : '';
      window.location.assign(`/become-a-tutor/thank-you${handle}`);
      return;
    } catch (error) {
      show(error instanceof Error ? error.message : t('Please try again shortly.', '잠시 후 다시 시도해 주세요.'), 'error');
    } finally {
      if (submit) submit.disabled = false;
      if (submitLabel) submitLabel.textContent = t('Submit application', '지원서 제출');
    }
  });
</script>
