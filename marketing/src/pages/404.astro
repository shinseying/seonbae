---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Contour from '../components/Contour.astro';
import T from '../components/T.astro';
---
<Base title="Page not found | Seonbae" titleKo="페이지를 찾을 수 없습니다 | 선배" active="none" showConversion={false}>
  <section class="nf has-contour">
    <Contour color="rgba(0,58,108,0.12)" opacity={0.5} variant="a" />
    <div class="container nf-inner">
      <div class="nf-art" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none">
          <g stroke="var(--violet)" stroke-width="3" stroke-linecap="round">
            <path d="M50 100a50 50 0 0 1 100 0" />
            <path d="M50 100v14" />
            <path d="M150 100v14" />
          </g>
          <line x1="34" y1="122" x2="166" y2="122" stroke="var(--violet)" stroke-width="2.4" stroke-linecap="round" opacity="0.5" />
          <path d="M64 146a40 40 0 0 0 72 0" stroke="var(--mint)" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="2 8" />
        </svg>
      </div>
      <Eyebrow label="404" />
      <h1 class="display nf-title"><T en="Looks like this lesson wandered off." ko="찾으시는 페이지가 길을 잃었나 봐요." /></h1>
      <p class="lead nf-copy"><T en="The page you are after is not here. It may have moved, or the link had a typo. Let us get you back on track." ko="페이지가 이동했거나 주소가 잘못 입력되었을 수 있습니다. 다시 올바른 곳으로 안내해 드릴게요." /></p>
      <div class="cta-row nf-cta">
        <Button href="/" label="Back to home" labelKo="홈으로" variant="secondary" arrow="right" />
        <Button href="/get-matched" label="Find a tutor" labelKo="선배 찾기" variant="primary" arrow="diag" />
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; background: var(--canvas); overflow: hidden; min-height: 78vh; display: flex; align-items: center; padding-block: clamp(48px, 8vw, 100px); }
  .nf-inner { position: relative; z-index: 1; text-align: center; max-width: 680px; margin-inline: auto; }
  .nf-inner .eyebrow { justify-content: center; }
  .nf-art { width: 108px; margin: 0 auto 26px; }
  .nf-title { font-size: clamp(2.4rem, 5vw, 4rem); margin-top: 8px; }
  .nf-copy { margin: 20px auto 0; max-width: 500px; }
  .nf-cta { justify-content: center; margin-top: 30px; }
</style>
