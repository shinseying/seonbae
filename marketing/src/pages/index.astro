---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IconBlob from '../components/IconBlob.astro';
import MarkedTitle from '../components/MarkedTitle.astro';
import T from '../components/T.astro';
import { home, ui } from '../i18n/home';
import { subjectCount } from '../data/rates';
import { leadership, TUTOR_CARD_PHOTO } from '../data/people';

import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

// Drop a file named hero.* into marketing/public and the hero uses it. Any of
// these extensions works, so the photo does not have to be re-encoded to JPEG.
const heroFile = ['jpg', 'jpeg', 'png', 'webp', 'avif']
  .map((extension) => `hero.${extension}`)
  .find((name) => fs.existsSync(fileURLToPath(new URL(`../../public/${name}`, import.meta.url))));

// The preview shows tutors, not the founding team, so it does not track the
// leadership list one to one. Ian holds the first slot; the other two entries
// are founders who also teach.
const tutorPreview = [
  {
    name: 'Ian Bae',
    hangul: '배이안',
    university: 'Korea University',
    universityKo: '고려대학교',
    photo: TUTOR_CARD_PHOTO,
    credentials: [{ en: 'IB 43/45', ko: 'IB 43/45' }],
    tutorCopy: {
      en: 'Sat the IB Diploma recently, so the papers and the marking are still fresh.',
      ko: 'IB 디플로마를 직접 치른 선배가 시험지와 채점 기준을 그대로 알려드립니다.',
    },
  },
  { ...leadership[1], photo: TUTOR_CARD_PHOTO },
  { ...leadership[2], photo: TUTOR_CARD_PHOTO },
];

const steps = [
  { t: { en: 'Tell us your goal', ko: '목표를 알려주세요' }, c: { en: 'Tell us your subject, current level, and the exam or result you are working toward.', ko: '과목, 성적대, 시험 준비까지 전부 말해주세요.' }, icon: 'target' },
  { t: { en: 'Find your match', ko: '선배를 찾아드려요' }, c: { en: 'Browse available tutors yourself, or let us match you based on subject, level, and availability.', ko: '직접 찾으셔도 좋아요. 고민된다면 마음 편히 맡겨주세요.' }, icon: 'match' },
  { t: { en: 'Learn and see progress', ko: '마음껏 배우고 성장하세요' }, c: { en: 'Lesson materials, feedback, and homework keep every next step clear.', ko: '자료와 피드백으로 든든히 지원해드릴게요.' }, icon: 'rise' },
];
const portalRows = [
  { tab: { en: 'Progress', ko: '성장' }, title: { en: 'See the progress', ko: '성장 과정' }, copy: { en: 'Every report in the pile is another step you took forward.', ko: '피드백 리포트가 쌓일수록, 과거의 실수와 멀어져요.' } },
  { tab: { en: 'Homework', ko: '숙제' }, title: { en: 'Homework', ko: '숙제' }, copy: { en: 'Set, submitted and marked in one place.', ko: '과제물 지급부터 제출까지 포털에서 해결해요.' } },
  { tab: { en: 'Lessons', ko: '수업' }, title: { en: 'Join the lesson', ko: '수업' }, copy: { en: 'The same button every week. No waiting for links.', ko: '버튼 한 번만 누르면 수업이 시작돼요.' } },
  { tab: { en: 'Shared', ko: '공유' }, title: { en: 'Shared', ko: '공유' }, copy: { en: 'Student accounts and their progress are visible on parent accounts post-verification.', ko: '학생 계정은 인증 후 학부모 계정과 연동 가능해요.' } },
];
const curriculaIcons = ['book', 'spark', 'globe', 'notes', 'star', 'chat'];
---
<Base title="Seonbae | Verified tutors from Korea's top universities" active="/">
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <!-- The photo is the hero ground. A cream wash runs across it from the left
         so the headline keeps its contrast while the subject stays visible on
         the right. -->
    <div class="hero__bg" aria-hidden="true">
      {heroFile && <img src={`/${heroFile}`} alt="" fetchpriority="high" decoding="async" />}
    </div>
    <div class="container hero__inner">
      <div class="hero__lead reveal is-in">
        <span class="eyebrow"><T en={home.hero.eyebrow.en} ko={home.hero.eyebrow.ko} /></span>
        <h1 class="hero__title"><T en={home.hero.titleA.en} ko={home.hero.titleA.ko} /></h1>
        <p class="hero__copy"><T en={home.hero.copy.en} ko={home.hero.copy.ko} /></p>
        <div class="cta-row hero__cta">
          <a href="/get-matched" class="btn btn--primary btn--lg">
            <span><T en={home.hero.ctaPrimary.en} ko={home.hero.ctaPrimary.ko} /></span>
            <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
          <a href="/how-it-works" class="textlink"><span><T en={home.hero.ctaSecondary.en} ko={home.hero.ctaSecondary.ko} /></span>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="hero__chip">
          <span class="hero__chip-ic" aria-hidden="true"><Icon name="verify" size={18} /></span>
          <span><strong><T en="Verified" ko="검증 완료" /></strong><br /><T en="IB 45 · held on file" ko="IB 45점 · 증빙 보관" /></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= STAT BAND (navy) ======================= -->
  <section class="statband">
    <div class="container statband__grid">
      {home.about.metrics.map((m) => (
        <div class="stat">
          {m.count != null
            ? <span class="stat__v" data-count={m.count} data-suffix={m.suffix ?? ''}>{m.value}{m.suffix}</span>
            : <span class="stat__v">{m.value}</span>}
          <span class="stat__l"><T en={m.label.en} ko={m.label.ko} /></span>
        </div>
      ))}
    </div>
  </section>

  <!-- ======================= STEP FLOW ======================= -->
  <section class="section flow-sec">
    <div class="container">
      <div class="ed-head reveal">
        <span class="eyebrow"><T en="How it works" ko="이용 안내" /></span>
        <h2 class="dhead"><T en="Three steps to the right tutor." ko="딱, 세 걸음만 딛으세요." /></h2>
      </div>
      <div class="flow">
        {steps.map((s, i) => (
          <div class={`flow__step tone-${i} reveal`} data-delay={`${i * 90}ms`}>
            <span class="flow__deco" aria-hidden="true">
              <span class="flow__ghost">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <span class="flow__n"><T en={`Step ${i + 1}`} ko={`${i + 1}단계`} /></span>
            <h3 class="flow__t"><T en={s.t.en} ko={s.t.ko} /></h3>
            <p class="body"><T en={s.c.en} ko={s.c.ko} /></p>
            {i < steps.length - 1 && (
              <span class="flow__link" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h14M13 7l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= CURRICULA - BENTO ======================= -->
  <section class="section bento-sec bg-cream">
    <div class="container">
      <div class="sec-head reveal">
        <div>
          <span class="eyebrow"><T en={home.curricula.eyebrow.en} ko={home.curricula.eyebrow.ko} /></span>
          <h2 class="dhead"><T en="Every curriculum we teach." ko="선배가 가르치는 모든 커리큘럼." /></h2>
        </div>
        <a href="/subjects" class="textlink"><span><T en={home.curricula.cta.en} ko={home.curricula.cta.ko} /></span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="bento">
        {home.curricula.items.map((c, i) => (
          <a href={c.href} class={`bento__cell tone-${i + 1} reveal`} data-delay={`${i * 60}ms`}>
            <div class="bento__body">
              <h3 class="bento__t"><MarkedTitle tone={((i % 6) + 1) as 1 | 2 | 3 | 4 | 5 | 6}><T en={c.title.en} ko={c.title.ko} /></MarkedTitle></h3>
              <p class="body"><T en={c.copy.en} ko={c.copy.ko} /></p>
            </div>
            <div class="bento__foot">
              <span class="tag tag--sage"><T en={c.levels.en} ko={c.levels.ko} /></span>
              <span class="bento__n"><T en={`${subjectCount(c.slug)} subjects`} ko={`${subjectCount(c.slug)}개 과목`} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= WHY - EDITORIAL PULL-QUOTE ======================= -->
  <section class="section why2-sec">
    <span class="why2-blob why2-blob--a" aria-hidden="true"></span>
    <span class="why2-blob why2-blob--b" aria-hidden="true"></span>
    <div class="container why2-grid">
      <blockquote class="pullquote reveal">
        <span class="eyebrow"><T en={home.why.eyebrow.en} ko={home.why.eyebrow.ko} /></span>
        <p><T en={home.why.heading.en} ko={home.why.heading.ko} /></p>
      </blockquote>
      <div class="why2-support reveal" data-delay="90ms">
        <p class="lead"><T en={home.why.lead.en} ko={home.why.lead.ko} /></p>
        <div class="why2-pair">
          <div><h3 class="mini-h"><T en={home.why.pair1Title.en} ko={home.why.pair1Title.ko} /></h3><p class="body"><T en={home.why.pair1Copy.en} ko={home.why.pair1Copy.ko} /></p></div>
          <div><h3 class="mini-h"><T en={home.why.pair2Title.en} ko={home.why.pair2Title.ko} /></h3><p class="body"><T en={home.why.pair2Copy.en} ko={home.why.pair2Copy.ko} /></p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= TUTOR PREVIEW ======================= -->
  <section class="section tutors-sec bg-sand">
    <div class="container">
      <div class="sec-head reveal">
        <div>
          <span class="eyebrow"><T en="Our tutors" ko="선배들" /></span>
          <h2 class="dhead"><T en="Better learning starts with the right fit." ko="나와 꼭 맞는 선배와 공부하세요." /></h2>
        </div>
        <a href="/tutors" class="textlink"><span><T en="Meet all tutors" ko="선배 전체 보기" /></span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="tutor-row">
        {tutorPreview.map((t, i) => (
          <article class="tcard reveal" data-delay={`${i * 80}ms`}>
            <div class="tcard__photo">
              <img src={t.photo} alt={t.name} width="800" height="800" loading="lazy" decoding="async" />
              <span class="tcard__verified"><Icon name="verify" size={15} /> <T en="Verified" ko="검증 완료" /></span>
            </div>
            <div class="tcard__body">
              <h3 class="tcard__name"><T en={t.name} ko={t.hangul} /><span class="tcard__kr"><T en={t.hangul} ko={t.name} /></span></h3>
              <p class="tcard__uni"><T en={t.university} ko={t.universityKo} /></p>
              <div class="tcard__accolades">
                {t.credentials.map((c) => <span class="tag tag--gold"><T en={c.en} ko={c.ko} /></span>)}
              </div>
              <p class="tcard__bio"><T en={t.tutorCopy.en} ko={t.tutorCopy.ko} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= ONE PORTAL ======================= -->
  <section class="section portal-home">
    <div class="container portal-home__grid">
      <div class="portal-home__copy reveal">
        <span class="eyebrow"><T en="One portal" ko="하나의 포털" /></span>
        <h2 class="dhead"><T en="Your Online Campus" ko="수업부터 숙제까지, 포털에서 진행해요" /></h2>
        <p class="lead"><T en="Tutoring usually runs through messages and files that are forgotten over time. On our portal, you can traverse through your learning journey at one glance." ko="과외 선생님과 학생이 문자로 소통하는 데에는 한계가 있어요. 옛날에 보냈던 파일이 없어지기도 하고, 연락을 유지하는 자체도 부담돼요. 포털에서는 학습 전반의 과정을 한 눈에 볼 수 있어요." /></p>

        <div class="portal-home__rows">
          {portalRows.map((row) => (
            <article class="portal-home__row">
              <span class="portal-home__tab"><T en={row.tab.en} ko={row.tab.ko} /></span>
              <div>
                <h3><T en={row.title.en} ko={row.title.ko} /></h3>
                <p><T en={row.copy.en} ko={row.copy.ko} /></p>
              </div>
            </article>
          ))}
        </div>

        <div class="cta-row portal-home__actions">
          <a href="/portal" class="btn btn--primary btn--lg">
            <span><T en="Open the portal" ko="포털 열기" /></span>
            <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </div>

      <div class="portal-window reveal" data-delay="90ms" aria-hidden="true">
        <div class="portal-window__bar">
          <span></span><span></span><span></span>
          <b>seonbaetutor.com</b>
        </div>
        <div class="portal-window__body">
          <nav class="portal-window__nav">
            <span class="is-active"><T en="Progress" ko="성장" /></span>
            <span><T en="Homework" ko="과제" /></span>
            <span><T en="Lessons" ko="수업" /></span>
            <span><T en="Billing" ko="결제" /></span>
          </nav>
          <div class="portal-window__main">
            <div class="portal-window__head">
              <div><h3>IB Physics HL</h3><p><T en="Checks this term" ko="이번 학기 점검" /></p></div>
              <span><T en="Every 4 weeks" ko="4주마다" /></span>
            </div>
            <div class="portal-window__score">
              <strong>6.4</strong>
              <span><T en="+1.8 since March" ko="3월 이후 +1.8" /></span>
            </div>
            <div class="portal-window__chart">
              <div class="portal-window__bars"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="portal-window__labels"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span></div>
            </div>
            <div class="portal-window__pills">
              <span><T en="Next lesson Thu 7pm" ko="다음 수업 목요일 오후 7시" /></span>
              <span><T en="Paid for March" ko="3월 결제 완료" /></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= WHAT WE PROMISE =======================
       Student testimonials belong here once real families have used us.
       Until then this space states what we are accountable for. -->
  <section class="section quote-sec">
    <div class="container">
      <div class="promise reveal">
        <h2 class="dhead"><T en="Why Seonbae works" ko="선배가 특별한 네 가지 이유" /></h2>
      </div>
      <div class="promise-grid">
        {[
          { icon: 'wallet', tone: 2, t: { en: 'Every price is published', ko: '가격이 투명해요' }, c: { en: 'All 125 subject rates are on the pricing page. You never have to ask what something costs.', ko: '모든 과목의 요금을 요금 페이지에서 확인할 수 있습니다.' } },
          { icon: 'match', tone: 1, t: { en: 'Thoughtful matching', ko: '매칭에 진심이에요' }, c: { en: 'A person carefully reviews every request so you can browse tutors or be matched by subject, level, and availability.', ko: '접수된 요청을 하나하나 신중하게 검토해 과목, 수준, 가능한 시간에 맞는 선배를 찾아드립니다.' } },
          { icon: 'shield', tone: 3, t: { en: 'Rematch after the first lesson', ko: '다시 매칭해도 괜찮아요' }, c: { en: 'If the fit is wrong, we match you again, no questions asked.', ko: '첫 수업이 마음에 들지 않았다면 다음 수업부터 다른 선배와 함께할 수 있습니다.' } },
          { icon: 'calendar', tone: 4, t: { en: 'Plans change', ko: '급한 일이 생겨도 괜찮아요' }, c: { en: 'Cancel up to 24 hours before, reschedule when possible, or receive a refund for an unused lesson.', ko: '24시간 전에 알려주시면 보강하거나 사용하지 않은 수업료를 다음 달 결제 금액에서 차감해 드립니다.' } },
        ].map((p, i) => (
          <article class="promise-card reveal" data-delay={`${i * 70}ms`}>
            <IconBlob name={p.icon} tone={p.tone as 1 | 2 | 3 | 4} size={86} />
            <h3 class="promise-t"><T en={p.t.en} ko={p.t.ko} /></h3>
            <p class="body"><T en={p.c.en} ko={p.c.ko} /></p>
          </article>
        ))}
      </div>
      <aside class="mock-band reveal">
        <div>
          <span class="eyebrow"><T en="Mock exams and level tests" ko="모의고사와 레벨 테스트" /></span>
          <h2 class="dhead"><T en="Practise under real conditions." ko="실전처럼 연습하세요." /></h2>
          <p class="body"><T en="We analyse more than 500 past and practice papers to identify recurring question types, marking criteria, scoring patterns, and the details that consistently earn points. Those patterns shape the mock exams and level tests we build, helping us assess not only how a student performed, but where and why marks were lost." ko="500개 이상의 기출 문제지를 분석했습니다. 자주 출제되는 문제 유형과 학제 특유의 채점 기준을 반영해 모의고사와 레벨 테스트를 만들고, 취약한 개념과 문제 유형까지 분석해 드립니다." /></p>
        </div>
        <a href="/mock-exams" class="btn btn--primary mock-band__cta"><T en="Choose a test" ko="시험 보기" /></a>
      </aside>
    </div>
  </section>

</Base>

<style>
  /* ======= shared editorial devices ======= */
  /* Accent words are navy, never gold: gold text reads decorative and fights
     the heading it sits in. */
  .ed { color: var(--ink); font-weight: 700; }
  .dhead { font-family: var(--serif); font-optical-sizing: auto; font-weight: 600; font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.1; letter-spacing: -0.01em; max-width: 24ch; }
  .tag { display: inline-flex; align-items: center; font-size: 0.74rem; font-weight: 600; padding: 4px 10px; border-radius: var(--r-pill); }
  .tag--sage { background: var(--sage); color: var(--sage-ink); }
  .tag--gold { background: var(--violet-soft); color: var(--violet); }
  .mini-h { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; }
  .flow__t { color: var(--ink); }
  .mock-band { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(24px, 5vw, 64px); align-items: center; margin-top: clamp(64px, 8vw, 104px); padding-top: clamp(40px, 5vw, 60px); border-top: 2px solid var(--ink); }
  .mock-band .dhead { margin-top: 12px; }
  .mock-band .body { margin-top: 16px; max-width: 66rem; }
  .mock-band__cta { align-self: center; justify-self: center; justify-content: center; min-width: 148px; padding: 13px 26px; text-align: center; transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease; }
  .mock-band__cta:hover { transform: scale(1.06); }
  .mock-band__cta:active { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) { .mock-band__cta:hover, .mock-band__cta:active { transform: none; } }
  @media (max-width: 760px) { .mock-band { grid-template-columns: 1fr; align-items: start; } }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(30px, 4vw, 48px); flex-wrap: wrap; }
  .sec-head .dhead { margin-top: 12px; }

  /* ======= HERO ======= */
  /* The photograph is shown whole. It is sized by height and pinned to the
     right, so at 1.333:1 it occupies the right 78% of the section and nothing
     is cropped — every bit of ceiling, wall, window and desk is on screen.

     The section's ratio keeps the two in step: 1.71:1 is roughly 1.333 / 0.78,
     so the photo lands on that 78% at every width and zoom. The cream holds
     solid just past the photo's left edge and hands over in eleven percent, so
     the room opens up early and the block stays out of its way. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    aspect-ratio: 171 / 100;
    min-height: 520px;
    max-height: 1050px;
    background: var(--hero);
    padding-block: clamp(48px, 6vw, 92px);
  }
  .hero__bg { position: absolute; inset: 0; z-index: 0; background: var(--hero); }
  .hero__bg img {
    position: absolute; top: 0; right: 0;
    height: 100%; width: auto; max-width: none;
    display: block;
  }
  .hero__bg::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      var(--hero) 0%,
      var(--hero) 26%,
