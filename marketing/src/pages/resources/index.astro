---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import T from '../../components/T.astro';
import { resourceCategoryKo } from '../../i18n/content';
import { localeFromPath, localePath } from '../../i18n/locale';

const resources = (await getCollection('resources')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [lead, ...rest] = resources;

const categories = ['All', 'Study Skills', 'Subject Help', 'Test Prep', 'Parent Guides', 'Getting Started'];
const slug = (c: string) => c.toLowerCase().replace(/ /g, '-');
const locale = localeFromPath(Astro.url.pathname);
const link = (href: string) => localePath(href, locale);
---
<Base active="/resources">
  <PageHero
    eyebrow="Resources"
    eyebrowKo="학습 자료"
    bg="yellow"
    illo="telescope"
    illoPos="right"
    copy="Practical notes on studying, subjects, and tests, written by our own research team of Seoul National University, Korea University, and Yonsei students. The same people build the progress checks our students sit, from a library of more than 500 past and mock papers."
    copyKo="서울대학교·고려대학교·연세대학교 학생으로 구성된 연구팀이 공부, 과목, 시험에 관한 실용적인 글을 씁니다. 같은 팀이 500개 이상의 기출 및 모의고사 자료를 바탕으로 학생들의 점검 시험도 만듭니다."
  >
    <T en="Clear advice for learning with confidence." ko="자신 있게 공부하기 위한 분명한 조언." />
  </PageHero>

  {lead && (
    <section class="section bg-white section--tight">
      <div class="container">
        <a href={link(`/resources/${lead.id}`)} class="lead-resource reveal">
          <div class="lead-resource__media">
            <ResourceCard entry={lead} variant="standard" />
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="section bg-white res-list" style="padding-top:0">
    <div class="container">
      <div class="filter-row reveal" role="tablist" aria-label="Filter by category">
        {categories.map((c, i) => (
          <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} class="filter-btn" data-filter={i === 0 ? 'all' : slug(c)}><T en={c} ko={c === 'All' ? '전체' : resourceCategoryKo[c] ?? c} /></button>
        ))}
      </div>
      <div class="res-grid" id="res-grid">
        {rest.map((r) => (
          <div class="res-cell reveal" data-cat={slug(r.data.category)}><ResourceCard entry={r} variant="standard" /></div>
        ))}
      </div>
      <p class="no-match" hidden><T en="Nothing here yet in that category. Try another." ko="이 분류에는 아직 글이 없습니다. 다른 분류를 선택해 주세요." /></p>
      <p class="paid-note reveal"><a href={link('/mock-exams')}><T en="The same research team also builds our mock exams and level tests, which are paid. Everything on this page stays free." ko="같은 연구팀이 유료 모의고사와 레벨 테스트도 만듭니다. 이 페이지의 모든 자료는 계속 무료입니다." /></a></p>
    </div>
  </section>
</Base>

<style>
  /* White ground, but the list still reads as its own page: a hairline and
     a step in rhythm do the separating instead of a colour block. */
  .res-list { border-top: 1px solid var(--line); margin-top: clamp(28px, 4vw, 48px); padding-top: clamp(32px, 4vw, 52px) !important; }
  .lead-resource { display: block; }
  .filter-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(28px, 4vw, 44px); }
  .filter-btn {
    border: 1px solid var(--line);
    background: var(--white);
    padding: 9px 18px;
    border-radius: var(--r-pill);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.16s ease;
  }
  .filter-btn:hover { color: var(--ink); border-color: rgba(12,12,12,0.24); }
  .filter-btn[aria-selected='true'] { background: var(--violet); color: #fff; border-color: var(--violet); }

  .res-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: clamp(20px, 3vw, 36px); }
  .res-cell.is-hidden { display: none; }
  .no-match { margin-top: 22px; color: var(--muted); }
  .paid-note { margin-top: clamp(44px, 6vw, 72px); padding-top: 24px; border-top: 1px solid var(--line); color: var(--muted); }
  .paid-note a { color: var(--violet); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 680px) { .res-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const cells = [...document.querySelectorAll('.res-cell')] as HTMLElement[];
  const buttons = [...document.querySelectorAll('.filter-btn')] as HTMLButtonElement[];
  const noMatch = document.querySelector('.no-match') as HTMLElement | null;
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-selected', 'false'));
      btn.setAttribute('aria-selected', 'true');
      const f = btn.dataset.filter ?? 'all';
      let shown = 0;
      cells.forEach((cell) => {
        const match = f === 'all' || cell.dataset.cat === f;
        cell.classList.toggle('is-hidden', !match);
        if (match) shown++;
      });
      if (noMatch) noMatch.hidden = shown > 0;
    });
  });
</script>
