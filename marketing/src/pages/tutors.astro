---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import T from '../components/T.astro';
import { localeFromPath, localePath } from '../i18n/locale';

const locale = localeFromPath(Astro.url.pathname);
const link = (href: string) => localePath(href, locale);
const isEnglish = locale === 'en';

const filters = [
  { key: 'all', label: 'All tutors' },
  { key: 'ib', label: 'IB Diploma' },
  { key: 'ap', label: 'Advanced Placement' },
  { key: 'alevel', label: 'A Level' },
  { key: 'igcse', label: 'IGCSE' },
  { key: 'tests', label: 'Tests & English' },
];
---
<Base active="/tutors">
  <script is:inline>
    try {
      if (new URLSearchParams(location.search).get('sandbox') === '1') {
        document.documentElement.dataset.tutorSandbox = 'loading';
      }
    } catch {}
  </script>

  <section class="sandbox-bar" id="tutor-sandbox" hidden aria-labelledby="sandbox-title">
    <div class="container sandbox-bar__inner">
      <div class="sandbox-bar__mark" aria-hidden="true">S</div>
      <div class="sandbox-bar__copy">
        <p class="sandbox-bar__eyebrow">SANDBOX · <T en="Nothing is saved" ko="저장되지 않은 미리보기" /></p>
        <h1 id="sandbox-title"><T en="Review the tutor directory before applying it." ko="실제 반영 전 튜터 명부를 확인하세요." /></h1>
        <p><span data-sandbox-file></span><span aria-hidden="true"> · </span><strong data-sandbox-count>0</strong> <T en="cards in this sandbox" ko="장의 샌드박스 카드" /></p>
        <div class="sandbox-legend" aria-label="Sandbox card status">
          <span data-state="existing"><i aria-hidden="true"></i><T en="Existing" ko="현재 카드" /><b data-sandbox-existing-count>0</b></span>
          <span data-state="new"><i aria-hidden="true"></i><T en="New draft" ko="새 카드" /><b data-sandbox-new-count>0</b></span>
          <span data-state="update"><i aria-hidden="true"></i><T en="Proposed update" ko="수정 카드" /><b data-sandbox-update-count>0</b></span>
        </div>
      </div>
      <div class="sandbox-bar__actions">
        <a href="/admin"><T en="Back to admin" ko="관리 화면으로" /></a>
        <button type="button" data-sandbox-apply disabled>
          <span><T en="Approve and apply to Supabase" ko="검토 완료 · Supabase에 반영" /></span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="m6.5 12.5 3.4 3.4 7.6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <p class="sandbox-bar__status" data-sandbox-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <PageHero
    eyebrow="Tutors"
    eyebrowKo="선배"
    copy="Meet your tutors. Every tutor is screened for university enrolment, high school results, and identity."
    copyKo="여러분의 선배들을 만나세요! 선배들은 재학 여부, 성적표, 신원까지 모두 확인된 튜터들입니다."
    bg="white"
    compact={true}
  >
    <T en="Meet your tutors." ko="여러분의 선배를 만나세요." />
  </PageHero>

  <!-- Search and curriculum choices stay together, so the directory can use
       the full width for tutor profiles. -->
  <section class="section bg-white">
    <div class="container directory-container">
      <div class="roster">
        <div class="roster__main">
          <div class="directory-tools reveal is-in">
            <label class="directory-search" for="tutor-search">
              <span><T en="Search tutors or subjects" ko="튜터 또는 과목 검색" /></span>
              <span class="directory-search__control">
                <input id="tutor-search" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder={isEnglish ? 'Try IB Chemistry, calculus, or a tutor name' : 'IB 화학, 미적분 또는 튜터 이름을 검색하세요'} />
                <button type="button" data-clear-search hidden aria-label={isEnglish ? 'Clear search' : '검색어 지우기'}>×</button>
              </span>
            </label>
            <label class="directory-sort" for="tutor-sort">
              <span><T en="Sort by" ko="정렬" /></span>
              <select id="tutor-sort">
                <option value="default"><T en="Recommended" ko="추천순" /></option>
                <option value="curriculum"><T en="Curriculum" ko="커리큘럼순" /></option>
                <option value="university"><T en="University" ko="대학교순" /></option>
                <option value="recent"><T en="Recently added" ko="최근 등록순" /></option>
              </select>
            </label>
          </div>

          <div class="filter-strip reveal is-in">
            <h2 class="filter-strip__title"><T en="Curriculum" ko="커리큘럼" /></h2>
            <div class="rail__list" role="group" aria-label={isEnglish ? 'Filter tutors by curriculum' : '커리큘럼별 튜터 필터'}>
              {filters.map((f, i) => (
                <button type="button" class="rail__btn" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <span class="rail__label" data-filter-label={f.key}><T en={f.label} ko={f.key === 'all' ? '전체' : f.key === 'ap' ? 'AP' : f.key === 'alevel' ? 'A레벨' : f.key === 'tests' ? 'SAT·ACT·영어' : f.label} /></span>
                  <span class="rail__n rail__n--loading" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </div>

          <div class="roster__bar reveal is-in">
            <div class="roster__state">
              <p class="roster__count"><strong id="tutor-count" class="count-skeleton" aria-hidden="true"></strong> <span data-count-label><T en="tutors listed" ko="명의 튜터" /></span></p>
              <div class="active-filters" data-active-filters aria-label={isEnglish ? 'Active filters' : '적용된 필터'}></div>
            </div>
            <p class="roster__unis" aria-hidden="true"><span class="unis-skeleton"></span></p>
          </div>

          <div class="tutor-grid is-loading" id="tutor-grid" aria-busy="true">
            {Array.from({ length: 6 }).map(() => (
              <div class="tutor-cell tutor-cell--skeleton" aria-hidden="true">
                <article class="tcardx tcardx--skeleton card">
                  <span class="skeleton-identity"><i></i><b><span></span><span></span></b></span>
                  <span class="skeleton-tags"><i></i><i></i><i></i></span>
                  <span class="skeleton-score-list"><i></i><i></i><i></i></span>
                  <span class="skeleton-line skeleton-line--bio"></span>
                  <span class="skeleton-line skeleton-line--button"></span>
                </article>
              </div>
            ))}
          </div>

          <p class="roster__note" id="roster-note" hidden><T en="Only active, verified records from the Seonbae registry appear here." ko="선배 명부에서 활성화된 검증 완료 튜터만 표시됩니다." /> <a href={link('/verification')}><T en="See the standard" ko="검증 기준 보기" /></a></p>
          <div class="no-match" hidden>
            <p data-no-match-copy><T en="No tutor matches those filters. Try a broader subject or clear the filters." ko="조건에 맞는 튜터가 없습니다. 더 넓은 과목명으로 검색하거나 필터를 지워보세요." /></p>
            <button type="button" data-clear-filters><T en="Clear filters" ko="필터 지우기" /></button>
          </div>
          <p class="sr-only" role="status" aria-live="polite" id="tutor-live"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- A flat band rather than another card, so the roster stays the page's -->
  <!-- only object of attention. -->
  <section class="section section--tight bg-cream">
    <div class="container">
      <div class="closing reveal">
        <div class="closing__say">
          <span class="eyebrow"><T en="Not sure who to pick" ko="누구를 고를지 고민되시나요?" /></span>
          <h2 class="h2"><T en="Tell us what you need, and we will find the right fit." ko="과목과 상황을 알려주시면, 저희가 매칭해 드립니다." /></h2>
          <p class="lead" style="margin-top:16px"><T en="Tell us your subject, level, goals, and availability. A person will review your request and match you with a tutor who fits." ko="과목, 수준, 목표, 가능한 시간을 알려주세요. 담당자가 직접 요청을 확인하고 잘 맞는 선배를 찾아드립니다." /></p>
        </div>
        <div class="closing__do">
          <a href={link('/get-matched')} class="btn btn--primary btn--lg"><span><T en="Request a consultation" ko="상담 신청" /></span><span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
          <a href={link('/how-it-works')} class="textlink"><span><T en="How matching works" ko="매칭 방식 보기" /></span></a>
        </div>
      </div>
    </div>
  </section>

  <dialog class="pf" id="profile-dialog" aria-labelledby="profile-heading">
    <div class="book__panel">
      <button type="button" class="book__close" data-close-profile><span aria-hidden="true">←</span><T en="Back to tutor list" ko="튜터 목록으로 돌아가기" /></button>
      <p class="book__eyebrow" id="profile-heading"><T en="Tutor profile" ko="튜터 프로필" /></p>
      <div data-profile-body></div>
    </div>
  </dialog>

  <dialog class="book" id="book-dialog" aria-labelledby="book-heading">
    <div class="book__panel">
      <button type="button" class="book__close" data-close-book aria-label="Close">×</button>
      <p class="book__eyebrow"><T en="Request a match" ko="매칭 요청" /></p>
      <h2 class="h3" id="book-heading"><span data-book-title></span></h2>

      <p class="book__gate" data-book-gate hidden></p>

      <h3 class="book__sub"><T en="Published hours" ko="등록된 가능 시간" /></h3>
      <div class="book__calendar" data-book-calendar></div>

      <form class="book__form" novalidate>
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-field">
          <label for="bk-subject"><T en="Subject" ko="과목" /></label>
          <input id="bk-subject" name="subject" class="form-control" type="text" required maxlength="100" placeholder={isEnglish ? 'IB Economics HL' : 'IB 경제 HL'} />
        </div>
        <div class="form-grid">
          <div class="form-field">
            <label for="bk-day"><T en="Preferred day" ko="희망 요일" /></label>
            <select id="bk-day" name="preferredDay" class="form-control" required>
              <option value="" disabled selected>{isEnglish ? 'Choose a day' : '요일 선택'}</option>
              <option value="mon">{isEnglish ? 'Monday' : '월요일'}</option>
              <option value="tue">{isEnglish ? 'Tuesday' : '화요일'}</option>
              <option value="wed">{isEnglish ? 'Wednesday' : '수요일'}</option>
              <option value="thu">{isEnglish ? 'Thursday' : '목요일'}</option>
              <option value="fri">{isEnglish ? 'Friday' : '금요일'}</option>
              <option value="sat">{isEnglish ? 'Saturday' : '토요일'}</option>
              <option value="sun">{isEnglish ? 'Sunday' : '일요일'}</option>
            </select>
          </div>
          <div class="form-field">
            <label for="bk-time"><T en="Preferred time" ko="희망 시각" /></label>
            <input id="bk-time" name="preferredTime" class="form-control" type="time" required step="900" />
          </div>
        </div>
        <div class="form-field">
          <label for="bk-note"><T en="Anything we should know" ko="전하고 싶은 내용" /> <span class="book__opt"><T en="optional" ko="선택" /></span></label>
          <textarea id="bk-note" name="note" class="form-control" rows="3" maxlength="1000"></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg book__submit">
          <span><T en="Send match request" ko="매칭 요청 보내기" /></span>
          <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </button>
        <p class="book__status" role="status" aria-live="polite" data-book-status hidden></p>
      </form>
    </div>
  </dialog>

  <dialog class="vid" id="video-dialog" aria-labelledby="video-heading">
    <div class="vid__panel">
      <button type="button" class="book__close" data-close-video aria-label="Close">×</button>
      <h2 class="h3 vid__title" id="video-heading"><span data-video-title></span></h2>
      <div class="vid__frame" data-video-frame></div>
    </div>
  </dialog>

</Base>

<style>
  /* The import preview is deliberately unmistakable and stays in normal flow,
     so it cannot cover the site header or any directory controls. */
  .sandbox-bar[hidden] { display: none; }
  .sandbox-bar { padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,.16); background: var(--ink); color: var(--white); }
  .sandbox-bar__inner { display: grid; grid-template-columns: 48px minmax(0,1fr) auto; gap: 14px 18px; align-items: center; }
  .sandbox-bar__mark { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.35); border-radius: 9px; background: rgba(255,255,255,.08); color: var(--yellow); font-family: var(--display); font-size: 1.25rem; font-weight: 900; }
  .sandbox-bar__eyebrow { margin: 0 0 4px; color: var(--yellow); font-size: .68rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .sandbox-bar__copy h1 { margin: 0; color: inherit; font-size: clamp(1rem,1.6vw,1.28rem); line-height: 1.25; }
  .sandbox-bar__copy>p:nth-of-type(2) { margin: 5px 0 0; color: rgba(255,255,255,.7); font-size: .78rem; }
  .sandbox-legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 9px; }
  .sandbox-legend>span { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,.8); font-size: .7rem; font-weight: 700; }
  .sandbox-legend i { width: 9px; height: 9px; flex: none; border: 2px solid currentColor; border-radius: 50%; background: currentColor; box-shadow: inset 0 0 0 2px var(--ink); }
  .sandbox-legend b { min-width: 1.35rem; padding: 2px 5px; border-radius: 4px; background: rgba(255,255,255,.1); color: #fff; font-variant-numeric: tabular-nums; text-align: center; }
  .sandbox-legend [data-state='existing'] { color: #a9d4f5; }
  .sandbox-legend [data-state='new'] { color: #aee3bc; }
  .sandbox-legend [data-state='update'] { color: #ffd38a; }
  .sandbox-bar__actions { display: flex; align-items: center; gap: 8px; }
  .sandbox-bar__actions a,.sandbox-bar__actions button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 15px; border-radius: 7px; font: inherit; font-size: .76rem; font-weight: 800; cursor: pointer; }
  .sandbox-bar__actions a { border: 1px solid rgba(255,255,255,.28); color: var(--white); }
  .sandbox-bar__actions button { min-height: 56px; gap: 12px; padding: 0 22px; border: 1px solid #2f7d4f; background: #2f7d4f; color: #fff; font-size: .82rem; box-shadow: 0 10px 24px rgba(0,0,0,.22); transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .sandbox-bar__actions button:hover:not(:disabled) { border-color: #286c45; background: #286c45; box-shadow: 0 13px 28px rgba(0,0,0,.26); transform: translateY(-1px); }
  .sandbox-bar__actions button:active:not(:disabled) { transform: translateY(0); box-shadow: 0 7px 16px rgba(0,0,0,.2); }
  .sandbox-bar__actions button svg { flex: none; }
  .sandbox-bar__actions button:disabled { cursor: wait; opacity: .6; }
  .sandbox-bar__actions a:focus-visible,.sandbox-bar__actions button:focus-visible { outline: 3px solid rgba(255,255,255,.5); outline-offset: 3px; }
  .sandbox-bar__status { grid-column: 2/-1; min-height: 1em; margin: -5px 0 0; color: rgba(255,255,255,.72); font-size: .74rem; }
  .sandbox-bar__status:empty { display: none; }
  .sandbox-bar__status[data-tone='error'] { color: #ffd0c8; }
  .sandbox-bar__status[data-tone='ok'] { color: #cfeac8; }
  :global(html[data-tutor-sandbox='loading']) #tutor-grid>* { visibility: hidden; }
  :global(html[data-tutor-sandbox]) .closing { opacity: .55; }
  :global(html[data-tutor-sandbox]) .rail__note { display: none; }

  /* ----- Directory grid --------------------------------------------------- */
  .directory-container {
    max-width: 1540px;
    padding-inline: clamp(20px, 3vw, 48px);
  }
  .roster { min-width: 0; }
  .filter-strip { margin: 18px 0 26px; }
  .filter-strip__title {
    margin-bottom: 10px; color: var(--muted); font-size: .72rem; font-weight: 750;
    letter-spacing: .12em; text-transform: uppercase;
  }
  .rail__list { display: flex; flex-wrap: wrap; gap: 8px; }
  .rail__btn {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 9px 15px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--white);
    cursor: pointer;
    color: var(--muted);
    transition: color .16s ease, border-color .16s ease, background-color .16s ease, box-shadow .16s ease;
  }
  .rail__label { font-weight: 650; font-size: .9rem; }
  .rail__n {
    min-width: 20px; padding: 1px 5px; border-radius: var(--r-pill); background: var(--canvas);
    color: var(--muted); font-family: var(--display); font-size: .7rem; font-weight: 700;
    font-variant-numeric: tabular-nums; text-align: center;
  }
  .rail__btn:hover { border-color: var(--violet); color: var(--ink); }
  .rail__btn:focus-visible { outline: 3px solid var(--mint); outline-offset: 2px; }
  .rail__btn[aria-pressed='true'] {
    border-color: var(--violet); background: var(--violet); color: #fff;
    box-shadow: 0 7px 18px rgba(52,63,114,.18);
  }
  .rail__btn[aria-pressed='true'] .rail__label { font-weight: 700; }
  .rail__btn[aria-pressed='true'] .rail__n { background: rgba(255,255,255,.18); color: #fff; }

  /* ----- Roster ----------------------------------------------------------- */
  .directory-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: 14px;
    align-items: end;
    margin-bottom: 20px;
  }
  .directory-search,
  .directory-sort { display: grid; gap: 8px; color: var(--ink); font-size: .78rem; font-weight: 750; }
  .directory-search__control { position: relative; display: block; }
  .directory-search input,
  .directory-sort select {
    width: 100%; min-height: 50px; border: 1px solid var(--line); border-radius: 14px;
    background: var(--white); color: var(--ink); font: inherit; font-size: 1rem;
    transition: border-color .16s ease, box-shadow .16s ease;
  }
  .directory-search input { padding: 0 48px 0 16px; }
  .directory-sort select { padding: 0 38px 0 14px; cursor: pointer; }
  .directory-search input:focus,
  .directory-sort select:focus { outline: 0; border-color: var(--violet); box-shadow: 0 0 0 3px var(--violet-soft); }
  .directory-search__control button {
    position: absolute; top: 50%; right: 3px; width: 44px; height: 44px; transform: translateY(-50%);
    border: 0; border-radius: 10px; background: transparent; color: var(--muted); font: inherit; font-size: 1.35rem; cursor: pointer;
  }
  .directory-search input::-webkit-search-cancel-button { appearance: none; }
  .directory-search__control button:hover { background: var(--violet-soft); color: var(--violet); }
  .directory-search__control button:focus-visible { outline: 3px solid var(--mint); outline-offset: 1px; }
  .roster__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: 16px;
    margin-bottom: clamp(18px, 2vw, 26px);
    border-bottom: 2px solid var(--ink);
  }
  .roster__state { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .roster__count { font-size: 0.95rem; color: var(--muted); }
  .roster__count strong { font-family: var(--display); font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); margin-right: 4px; font-variant-numeric: tabular-nums; }
  .roster__unis { font-size: 0.85rem; color: var(--muted); }
  .roster__main, .tutor-grid, .tutor-cell, .live-tutor-card { min-width: 0; }
  .roster__unis { overflow-wrap: anywhere; }
  .active-filters { display: flex; flex-wrap: wrap; gap: 7px; }
  .active-filter {
    min-height: 44px; display: inline-flex; align-items: center; gap: 7px; padding: 5px 10px 5px 12px;
    border: 1px solid rgba(52, 63, 114, .24); border-radius: var(--r-pill);
    background: var(--violet-soft); color: var(--violet); font: inherit; font-size: .78rem; font-weight: 750; cursor: pointer;
  }
  .active-filter:hover { border-color: var(--violet); }
  .active-filter:focus-visible { outline: 3px solid var(--mint); outline-offset: 2px; }

  .tutor-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 1.6vw, 22px); align-items: stretch; }
  .tutor-cell.is-hidden { display: none; }
  .live-tutor-card { display: flex; flex-direction: column; min-height: 100%; overflow: hidden; border-radius: 28px; border: 1px solid rgba(22, 48, 69, .12); box-shadow: 0 14px 36px rgba(22, 48, 69, .08); transition: transform .24s ease, box-shadow .24s ease, border-color .24s ease; }
  .live-tutor-card:hover { transform: translateY(-4px); border-color: rgba(22, 48, 69, .2); box-shadow: 0 22px 48px rgba(22, 48, 69, .13); }
  .live-tutor-card__visual {
    position: relative;
    min-height: 150px;
    aspect-ratio: 5 / 3;
    padding: 14px 14px 0;
    overflow: hidden;
    background: linear-gradient(150deg, var(--sage), var(--yellow-soft));
    color: #fff;
  }
  .live-tutor-card__photo { width: 100%; height: 100%; object-fit: contain; display: grid; place-items: center; border-radius: 20px 20px 0 0; color: var(--violet); font-family: var(--display); font-size: 2.2rem; font-weight: 800; transition: transform .35s ease; }
  .live-tutor-card:hover .live-tutor-card__photo { transform: scale(1.012); }
  .live-tutor-card__verified { position: absolute; z-index: 2; top: 14px; right: 14px; padding: 6px 11px; border-radius: var(--r-pill); border: 1px solid var(--line); background: rgba(255,253,247,.94); color: var(--violet); box-shadow: var(--shadow-sm); font-size: .72rem; font-weight: 800; }
  .live-tutor-card__body { display: flex; flex: 1; flex-direction: column; padding: 24px 26px 26px; }
  .live-tutor-card__id { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .live-tutor-card__id h3 { font-size: 1.28rem; }
  .live-tutor-card__uni { margin-top: 5px; color: var(--muted); font-size: .92rem; }
  .live-tutor-card__score { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line-soft); }
  .live-tutor-card__score strong { display: block; font-family: var(--display); font-size: 2.25rem; line-height: 1; color: var(--violet); }
  .live-tutor-card__score span { display: block; margin-top: 6px; color: var(--muted); font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; }
  .live-tutor-card__action { margin-top: 22px; white-space: normal; }
  .roster__note { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--line-soft); color: var(--muted); font-size: 0.95rem; line-height: 1.55; max-width: 68ch; }
  .roster__note a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }
  .no-match { margin-top: 24px; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--canvas); color: var(--muted); }
  .no-match p { max-width: 58ch; }
  .no-match button { min-height: 44px; margin-top: 12px; padding: 0; border: 0; background: none; color: var(--violet); font: inherit; font-weight: 750; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }

  .rail__n--loading,
  .count-skeleton,
  .unis-skeleton,
  .skeleton-line,
  .skeleton-identity i,
  .skeleton-identity b span,
  .skeleton-tags i,
  .skeleton-score-list i {
    display: block; border-radius: 7px;
    background: linear-gradient(100deg, var(--line-soft) 25%, rgba(255,255,255,.72) 45%, var(--line-soft) 65%);
    background-size: 220% 100%; animation: tutor-skeleton 1.25s ease-in-out infinite;
  }
  .rail__n--loading { width: 22px; height: 12px; }
  .count-skeleton { display: inline-block; width: 28px; height: 24px; vertical-align: -3px; }
  .unis-skeleton { width: 270px; max-width: 42vw; height: 14px; }
  .tcardx--skeleton { pointer-events: none; }
  .skeleton-identity { display: flex; align-items: center; gap: 12px; }
  .skeleton-identity i { width: 52px; height: 52px; flex: none; border-radius: 50%; }
  .skeleton-identity b { display: grid; flex: 1; gap: 8px; }
  .skeleton-identity b span:first-child { width: 66%; height: 17px; }
  .skeleton-identity b span:last-child { width: 82%; height: 12px; }
  .skeleton-tags { display: flex; gap: 7px; margin-top: 20px; }
  .skeleton-tags i { width: 30%; height: 30px; border-radius: var(--r-pill); }
  .skeleton-score-list { display: grid; gap: 1px; margin-top: 18px; }
  .skeleton-score-list i { width: 100%; height: 38px; }
  .skeleton-line--bio { width: 100%; height: 34px; margin-top: 20px; }
  .skeleton-line--button { width: 100%; height: 50px; margin-top: auto; border-radius: 14px; }
  @keyframes tutor-skeleton { to { background-position: -120% 0; } }

  /* ----- Closing band ----------------------------------------------------- */
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) auto;
    gap: clamp(24px, 4vw, 56px);
    align-items: end;
    padding-top: 30px;
    border-top: 2px solid var(--ink);
  }
  .closing__do { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }

  @media (max-width: 820px) {
    .sandbox-bar__inner { grid-template-columns: 42px minmax(0,1fr); }
    .sandbox-bar__mark { width: 42px; height: 42px; }
    .sandbox-bar__actions,.sandbox-bar__status { grid-column: 1/-1; }
    .sandbox-bar__actions { align-items: stretch; }
    .sandbox-bar__actions a,.sandbox-bar__actions button { flex: 1; }
    .directory-tools { grid-template-columns: 1fr; }
    .directory-sort { width: min(100%, 230px); }
    .filter-strip { margin-top: 16px; }
    .rail__list { flex-wrap: nowrap; max-width: 100%; padding-bottom: 4px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
    .rail__list::-webkit-scrollbar { display: none; }
    .rail__btn { flex: none; scroll-snap-align: start; }
    .closing { grid-template-columns: 1fr; align-items: start; }
  }
  @media (max-width: 900px) {
    .tutor-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .tutor-grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* ----- Tutor card ------------------------------------------------------- */
  .tcardx {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    height: 100%;
    padding: 24px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--white);
    box-shadow: 0 12px 30px rgba(22, 48, 69, .07);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .tcardx:hover { transform: translateY(-3px); border-color: rgba(52,63,114,.32); box-shadow: 0 20px 42px rgba(22, 48, 69, .12); }
  .tcardx__surface {
    position: absolute; inset: -1px; z-index: 1; padding: 0;
    border: 0; border-radius: inherit; background: transparent; cursor: pointer;
  }
  .tcardx__surface:focus-visible { outline: 3px solid var(--mint); outline-offset: 3px; }
  .tcardx > :not(.tcardx__surface) { z-index: 2; pointer-events: none; }

  .tcardx__verified {
    position: absolute; top: 20px; right: 20px;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 9px; border-radius: var(--r-pill); background: var(--violet-soft);
    color: var(--violet); font-size: .66rem; font-weight: 750;
  }
  /* Sandbox cards retain the public layout; a restrained outline and a named
     badge expose what will change without making colour carry the meaning. */
  .tutor-cell[data-preview-state='existing'] .tcardx { border-color: rgba(53,101,143,.52); box-shadow: 0 14px 36px rgba(53,101,143,.1); }
  .tutor-cell[data-preview-state='new'] .tcardx { border-color: rgba(47,125,79,.58); box-shadow: 0 14px 36px rgba(47,125,79,.11); }
  .tutor-cell[data-preview-state='update'] .tcardx { border-color: rgba(168,94,20,.58); box-shadow: 0 14px 36px rgba(168,94,20,.11); }
  .tutor-cell[data-preview-state='existing'] .tcardx__verified { border-color: #9fc2df; background: #eaf3fb; color: #24527a; }
  .tutor-cell[data-preview-state='new'] .tcardx__verified { border-color: #9fcbae; background: #e7f4eb; color: #245f3c; }
  .tutor-cell[data-preview-state='update'] .tcardx__verified { border-color: #e3bd7e; background: #fff2d6; color: #7a460d; }
  .tcardx__identity { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 13px; align-items: center; padding-right: 94px; }
  .tcardx__avatar {
    width: 54px; height: 54px; border-radius: 50%;
    object-fit: contain; background: var(--violet-soft);
    border: 3px solid var(--canvas);
  }
  .tcardx__identity-copy { min-width: 0; }
  .tcardx__name { margin: 0; font-size: inherit; }
  .tcardx__profile-label {
    max-width: 100%; display: flex; flex-wrap: wrap; align-items: baseline; gap: 5px 8px;
    color: var(--violet); text-align: left;
  }
  .tcardx__profile-label > span { font-family: var(--display); font-weight: 820; font-size: 1.25rem; letter-spacing: -.025em; line-height: 1.15; }
  .tcardx__profile-label small { overflow: hidden; color: var(--muted); font-size: .78rem; font-weight: 600; letter-spacing: 0; text-overflow: ellipsis; white-space: nowrap; }
  .tcardx__uni { margin-top: 4px; color: var(--ink); font-size: .8rem; font-weight: 650; line-height: 1.35; }

  .tcardx__curricula { display: flex; flex-wrap: wrap; gap: 6px; margin: 16px 0 0; padding: 0; list-style: none; }
  .tcardx__curricula li {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 9px; border: 1px solid rgba(52,63,114,.18); border-radius: var(--r-pill);
    background: var(--violet-soft); color: var(--violet); font-size: .66rem; font-weight: 800;
  }
  .tcardx__curricula li svg { width: 13px; height: 13px; flex: 0 0 auto; }
  .tcardx__curricula li.is-filter-match {
    border-color: var(--violet); background: var(--violet); color: #fff;
    box-shadow: 0 4px 12px rgba(52, 63, 114, .22);
  }
  .tcardx__score-head { margin-top: 16px; color: var(--muted); font-size: .68rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .tcardx__scores { display: grid; gap: 0; margin: 7px 0 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .tcardx__scores li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px;
    min-width: 0; padding: 9px 2px; border-bottom: 1px solid var(--line-soft);
  }
  .tcardx__scores b { grid-column: 2; grid-row: 1; font-family: var(--display); font-size: .86rem; font-weight: 820; color: var(--violet); font-variant-numeric: tabular-nums; }
  .tcardx__scores span { grid-column: 1; grid-row: 1; min-width: 0; color: var(--ink); font-size: .76rem; font-weight: 600; line-height: 1.35; }
  .tcardx__scores li.is-match { margin-inline: -8px; padding-inline: 10px; border-color: transparent; border-radius: 8px; background: var(--violet); }
  .tcardx__scores li.is-match b,.tcardx__scores li.is-match span { color: #fff; }

  .tcardx__bio {
    display: -webkit-box; width: 100%; margin-top: 16px; overflow: hidden;
    color: var(--muted); font-size: .8rem; line-height: 1.5;
    -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  }
  .tcardx__meta-line {
    margin-top: 8px; color: var(--muted-soft); font-size: .68rem; line-height: 1.4;
  }

  .tcardx__foot { width: 100%; margin-top: auto; padding-top: 18px; }
  .tcardx__view {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; min-height: 46px; padding: 0 18px; border-radius: 12px;
    background: var(--canvas); color: var(--violet); font-size: .86rem; font-weight: 750;
  }
  .tcardx__view svg { width: 17px; height: 17px; }
  .tcardx__book {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; min-height: 50px; padding: 0 20px; border: 0; border-radius: 14px;
    background: var(--violet); color: #fff; font: inherit; font-size: 1rem; font-weight: 700;
    cursor: pointer; transition: background .16s ease, transform .16s ease;
  }
  .tcardx__book:hover:not([disabled]) { background: var(--violet-deep); transform: translateY(-1px); }
  .tcardx__book[disabled] { opacity: .5; cursor: default; }

  /* ----- Booking dialog --------------------------------------------------- */
  .book, .vid {
    position: fixed; inset: 0; width: min(calc(100vw - 32px), 620px); max-width: none;
    max-height: min(calc(100dvh - 32px), 860px); margin: auto; padding: 0;
    border: 0; border-radius: var(--r-xl); background: transparent; color: var(--ink);
    box-shadow: var(--shadow-lift); overflow: visible;
  }
  .vid { width: min(calc(100vw - 32px), 860px); }
  .book::backdrop, .vid::backdrop { background: rgba(19, 24, 27, .56); backdrop-filter: blur(4px); }
  .book__panel, .vid__panel {
    position: relative; max-height: inherit; overflow: auto;
    padding: clamp(24px, 4vw, 40px); background: var(--white);
    border: 1px solid var(--line-soft); border-radius: inherit;
  }
  .book__close {
    position: absolute; top: 14px; right: 14px; display: grid; place-items: center;
    width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%;
    background: var(--white); color: var(--ink); font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .book__close:hover { background: var(--ink); color: var(--white); }
  .book__eyebrow { font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--violet); font-weight: 700; }
  .book__sub { margin-top: 24px; font-family: var(--display); font-size: 1rem; font-weight: 750; }

  .book__calendar { display: grid; gap: 6px; margin-top: 12px; }
  .book__day { display: grid; grid-template-columns: 46px minmax(0, 1fr); align-items: center; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .book__dow { font-size: .82rem; font-weight: 700; color: var(--muted); }
  .book__ranges { display: flex; flex-wrap: wrap; gap: 6px; }
  .book__slot {
    padding: 7px 13px; border: 1px solid var(--line); border-radius: var(--r-pill);
    background: var(--white); color: var(--ink); font: inherit; font-size: .82rem; font-weight: 600;
    cursor: pointer; transition: border-color .14s ease, background .14s ease, color .14s ease;
  }
  .book__slot:hover { border-color: var(--violet); }
  .book__slot.is-on { background: var(--violet); border-color: var(--violet); color: #fff; }
  .book__none { color: var(--muted-soft); font-size: .82rem; }
  .book__empty { color: var(--muted); font-size: .9rem; line-height: 1.55; }

  .book__form { display: flex; flex-direction: column; gap: 14px; margin-top: 24px; }
  .book__opt { font-weight: 500; color: var(--muted-soft); }
  .book__submit { width: 100%; justify-content: space-between; margin-top: 4px; }
  .book__submit[disabled] { opacity: .65; cursor: progress; }
  .book__status { margin: 0; padding: 12px 15px; border-radius: var(--r-sm); font-size: .92rem; line-height: 1.5; }
  .book__status[data-tone='ok'] { background: var(--sage); color: var(--sage-ink); }
  .book__status[data-tone='error'] { background: #fbeeea; color: #8f302b; }

  .tcardx__bio.is-empty { color: var(--muted-soft); }
  .book__gate { margin-top: 14px; padding: 13px 16px; border-radius: var(--r-sm); background: var(--yellow-soft); color: var(--ink); font-size: .92rem; line-height: 1.55; }
  .book__gate a { font-weight: 700; color: var(--violet); }
  .book__calendar .book__slot { margin: 0; }
  .book__fixed { padding: 6px 12px; border-radius: var(--r-pill); background: var(--violet-soft); color: var(--violet); font-size: .8rem; font-weight: 600; }
  .book__form[hidden] { display: none; }

  /* Profile dialog */
  .pf { position: fixed; inset: 0; width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; border-radius: 0; background: var(--white); color: var(--ink); box-shadow: none; }
  .pf::backdrop { background: var(--white); }
  .pf .book__panel {
    display: flex; flex-direction: column; width: 100%; height: 100%; max-height: none;
    padding: clamp(18px, 3vw, 40px); border: 0; border-radius: 0; isolation: isolate;
  }
  .pf .book__close {
    position: sticky; top: 0; z-index: 50; align-self: flex-start;
    display: inline-flex; flex: 0 0 54px; width: auto; min-width: 44px; min-height: 54px; height: 54px; gap: 10px;
    padding: 0 24px; border-radius: var(--r-pill); font-size: .9rem; font-weight: 800;
  }
  .pf .book__eyebrow,
  .pf [data-profile-body] { width: min(100%, 1220px); margin-inline: auto; }
  .pf__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 370px); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .pf__main { min-width: 0; }

  .pf__head {
    display: grid; grid-template-columns: 108px minmax(0, 1fr); gap: 22px; align-items: center;
    margin-top: 18px; padding-bottom: 24px; border-bottom: 2px solid var(--ink);
  }
  .pf__portrait { display: grid; justify-items: center; gap: 8px; }
  .pf__portrait img {
    width: 104px; height: 104px; border-radius: 50%; object-fit: contain;
    background: var(--violet-soft); border: 4px solid var(--canvas);
  }
  .pf__verified {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: var(--r-pill); background: var(--violet-soft);
    color: var(--violet); font-size: .66rem; font-weight: 750;
    white-space: nowrap;
  }
  .pf__ident { min-width: 0; }
  .pf__name {
    font-family: var(--display); font-weight: 800; font-size: clamp(1.5rem, 3.4vw, 1.95rem);
    letter-spacing: -.03em; line-height: 1.12; color: var(--violet);
  }
  .pf__uni { margin-top: 6px; font-size: 1rem; font-weight: 600; color: var(--ink); }
  .pf__ident .tcardx__curricula { margin-top: 12px; }

  .pf__meta {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;
    margin: 18px 0 0; padding: 14px 16px; border-radius: 12px; background: var(--canvas);
  }
  .pf__meta div { display: grid; gap: 3px; }
  .pf__meta dt { font-size: .72rem; color: var(--muted-soft); }
  .pf__meta dd { margin: 0; font-size: .88rem; font-weight: 600; color: var(--ink); }

  .pf__block { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
  .pf__sub { font-family: var(--display); font-size: 1rem; font-weight: 750; color: var(--ink); }
  .pf__video { margin-top: 14px; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: #0d1418; }
  .pf__video :global(video), .pf__video :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .pf__bio { margin-top: 10px; color: var(--muted); line-height: 1.65; white-space: pre-wrap; }
  .pf__bio.is-collapsed { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 5; white-space: normal; }
  .pf__bio-toggle {
    min-height: 44px; margin-top: 4px; padding: 0; border: 0; background: none; color: var(--violet);
    font: inherit; font-size: .8rem; font-weight: 750; text-decoration: underline; text-underline-offset: 4px; cursor: pointer;
  }
  .pf__bio-toggle:focus-visible { outline: 3px solid var(--mint); outline-offset: 2px; }
  .pf__empty { margin-top: 10px; color: var(--muted-soft); font-size: .92rem; line-height: 1.55; }
  .weekgrid {
    width: 100%; margin-top: 14px; overflow: visible;
    border: 1px solid var(--line); border-radius: 10px; background: var(--white);
  }
  .weekgrid__head {
    display: grid; grid-template-columns: 36px repeat(7, minmax(0, 1fr));
    border-bottom: 1px solid var(--line); background: var(--canvas);
    border-radius: 10px 10px 0 0; overflow: hidden;
  }
  .weekgrid__head b {
    min-width: 0; padding: 9px 0; border-left: 1px solid var(--line-soft);
    color: var(--muted); font-size: .68rem; font-weight: 800; text-align: center;
  }
  .weekgrid__head b:nth-last-child(-n + 2) { color: var(--coral); }
  .weekgrid__body { display: grid; grid-template-columns: 36px minmax(0, 1fr); height: 250px; }
  .weekgrid__times { position: relative; }
  .weekgrid__times span {
    position: absolute; top: calc(var(--time-top) * 1%); right: 6px;
    color: var(--muted-soft); font-size: .55rem; font-variant-numeric: tabular-nums;
    line-height: 1; transform: translateY(-50%);
  }
  .weekgrid__times span:first-child { transform: translateY(0); }
  .weekgrid__times span:last-child { transform: translateY(-100%); }
  .weekgrid__plot {
    position: relative; min-width: 0;
    background-image:
      linear-gradient(to bottom, var(--line-soft) 1px, transparent 1px),
      linear-gradient(to right, var(--line-soft) 1px, transparent 1px);
    background-size: 100% calc(100% / 6), calc(100% / 7) 100%;
  }
  .weekgrid__slot {
    position: absolute; z-index: 1;
    top: calc(var(--slot-top) * 1%);
    left: calc((100% / 7) * var(--day-index) + 3px);
    width: calc(100% / 7 - 6px);
    height: max(5px, calc(var(--slot-height) * 1%));
    border: 1px solid rgba(255, 255, 255, .62); border-radius: 4px;
    background: #315b6f; box-shadow: 0 2px 5px rgba(22, 48, 69, .18);
    cursor: help;
  }
  .weekgrid__slot[data-tone='1'] { background: #4c5f91; }
  .weekgrid__slot[data-tone='2'] { background: #8b5c7e; }
  .weekgrid__slot[data-tone='3'] { background: #99713f; }
  .weekgrid__slot[data-tone='4'] { background: #477762; }
  .weekgrid__slot::after {
    content: attr(data-time-label); position: absolute; z-index: 5; left: 50%; bottom: calc(100% + 7px);
    width: max-content; max-width: 180px; padding: 6px 8px; border-radius: 6px;
    background: var(--ink); color: #fff; font-size: .66rem; font-weight: 700;
    line-height: 1.25; white-space: nowrap; opacity: 0; pointer-events: none;
    transform: translate(-50%, 3px); transition: opacity .14s ease, transform .14s ease;
  }
  .weekgrid__slot:hover, .weekgrid__slot:focus-visible { z-index: 4; filter: brightness(1.08); }
  .weekgrid__slot:hover::after, .weekgrid__slot:focus-visible::after { opacity: 1; transform: translate(-50%, 0); }
  .weekgrid__slot:focus-visible { outline: 3px solid var(--mint); outline-offset: 2px; }

  .pf__aside { position: sticky; top: 72px; margin-top: 18px; padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: var(--canvas); box-shadow: 0 16px 38px rgba(22,48,69,.08); }
  .pf__aside-kicker { color: var(--muted); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .pf__aside h3 { margin-top: 7px; font-family: var(--display); font-size: 1.15rem; color: var(--ink); }
  .pf__rate-list { display: grid; gap: 0; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .pf__rate-list li { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .pf__rate-subject { color: var(--ink); font-size: .78rem; font-weight: 650; line-height: 1.4; }
  .pf__rate-score { display: block; margin-top: 3px; color: var(--violet); font-family: var(--display); font-size: .7rem; font-weight: 800; }
  .pf__rate-price { color: var(--ink); font-family: var(--display); font-size: .82rem; font-weight: 800; white-space: nowrap; }
  .pf__rate-price small { display: block; margin-top: 2px; color: var(--muted); font-family: var(--body); font-size: .62rem; font-weight: 600; text-align: right; }
  .pf__rate-missing { align-self: center; color: var(--violet); font-size: .7rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .pf__rate-note { margin-top: 12px; color: var(--muted); font-size: .7rem; line-height: 1.5; }
  .pf__aside .tcardx__book { margin-top: 18px; pointer-events: auto; }
  .pf__aside .textlink { display: inline-flex; margin-top: 12px; font-size: .78rem; }

  @media (max-width: 900px) {
    .pf__layout { grid-template-columns: 1fr; }
    .pf__aside { position: static; margin-top: 0; }
  }

  @media (max-width: 560px) {
    .pf .book__panel { padding: 12px 16px 24px; }
    .pf .book__close { top: 0; flex-basis: 52px; min-height: 52px; height: 52px; padding-inline: 20px; }
    .pf__head { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .pf__ident .tcardx__curricula { justify-content: center; }
    .pf__meta { grid-template-columns: 1fr; }
    .pf__aside { padding: 20px; }
    .weekgrid__head { grid-template-columns: 29px repeat(7, minmax(0, 1fr)); }
    .weekgrid__head b { padding-block: 8px; font-size: .58rem; }
    .weekgrid__body { grid-template-columns: 29px minmax(0, 1fr); height: 220px; }
    .weekgrid__times span { right: 4px; font-size: .48rem; }
    .weekgrid__slot { left: calc((100% / 7) * var(--day-index) + 2px); width: calc(100% / 7 - 4px); }
  }

  .vid__title { font-size: 1.2rem; padding-right: 48px; }
  .vid__frame { margin-top: 16px; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: #0d1418; }
  .vid__frame :global(video), .vid__frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }

  @media (max-width: 560px) {
    .sandbox-bar__actions { flex-direction: column; }
    .sandbox-legend { gap: 7px 10px; }
    .book, .vid { width: calc(100vw - 20px); max-height: calc(100dvh - 20px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sandbox-bar__actions a,.sandbox-bar__actions button,.tcardx { transition: none; }
    .rail__n--loading,.count-skeleton,.unis-skeleton,.skeleton-line,.skeleton-identity i,.skeleton-identity b span,.skeleton-tags i,.skeleton-score-list i { animation: none; }
  }
</style>

<script>
  import { rates } from '../data/rates';
  import {
    categoriesFor,
    curriculumNames,
    curriculumOrder,
    defaultTutorSort,
    displayOrderOf,
    scoreValue,
    scoresOf,
    tutorStrength,
    type CurriculumKey,
    type PublicTutor,
    type SubjectScore,
  } from '../lib/tutor-directory';

  const PREVIEW_STORAGE_KEY = 'seonbae:tutor-import-preview:v1';
  const PREVIEW_MAX_AGE_MS = 2 * 60 * 60 * 1000;
  const sandboxMode = new URLSearchParams(location.search).get('sandbox') === '1';
  const cardPhoto = '/images/ian-bae-placeholder.png';
  const buttons = [...document.querySelectorAll('.rail__btn')] as HTMLButtonElement[];
  const noMatch = document.querySelector('.no-match') as HTMLElement | null;
  const noMatchCopy = noMatch?.querySelector('[data-no-match-copy]') as HTMLElement | null;
  const clearFiltersButton = noMatch?.querySelector('[data-clear-filters]') as HTMLButtonElement | null;
  const countEl = document.getElementById('tutor-count');
  const countLabel = document.querySelector('[data-count-label]') as HTMLElement | null;
  const searchInput = document.getElementById('tutor-search') as HTMLInputElement | null;
  const clearSearchButton = document.querySelector('[data-clear-search]') as HTMLButtonElement | null;
  const sortSelect = document.getElementById('tutor-sort') as HTMLSelectElement | null;
  const activeFiltersEl = document.querySelector('[data-active-filters]') as HTMLElement | null;
  const universityLine = document.querySelector('.roster__unis') as HTMLElement | null;
  const staticFilterCounts: Record<string, number> = { all: 0, ib: 0, ap: 0, alevel: 0, igcse: 0, tests: 0 };
  const filterKeys = new Set(Object.keys(staticFilterCounts));
  const sortKeys = new Set(['default', 'curriculum', 'university', 'recent']);
  const initialParams = new URLSearchParams(location.search);
  const initialFilter = initialParams.get('c');
  let activeTutorFilter = initialFilter && filterKeys.has(initialFilter) ? initialFilter : 'all';
  let activeSearch = (initialParams.get('q') || '').trim().slice(0, 100);
  const requestedSort = initialParams.get('sort');
  let activeSort = requestedSort && sortKeys.has(requestedSort) ? requestedSort : 'default';
  let hasDirectoryHistory = initialParams.has('c') || initialParams.has('q') || initialParams.has('sort');

  type Tutor = PublicTutor;
  type PreviewState = 'existing' | 'new' | 'update';
  type PreviewPayload = {
    version: number;
    fileName: string;
    createdAt: number;
    existingRegistryIds?: string[];
    existingRows?: Array<Record<string, unknown>>;
    rows: Array<Record<string, unknown>>;
  };
  let roster: Tutor[] = [];
  let previewPayload: PreviewPayload | null = null;
  let previewStates = new Map<string, PreviewState>();
  let cells: HTMLElement[] = [...document.querySelectorAll('.tutor-cell')] as HTMLElement[];

  // Astro scopes this page's CSS with a data-astro-cid-* attribute. Cards built
  // from a template string do not carry it, so the live roster rendered unstyled
  // once the fetch replaced the server markup. Capture the attribute now, while
  // the server-rendered cards are still in the DOM, and stamp it on the ones we
  // inject.
  const scopeAttr = [...(cells[0]?.attributes ?? [])]
    .map((attribute) => attribute.name)
    .find((name) => name.startsWith('data-astro-cid-'));
  const applyScope = (root: HTMLElement) => {
    if (!scopeAttr) return;
    root.querySelectorAll<HTMLElement>('*').forEach((node) => node.setAttribute(scopeAttr, ''));
  };

  const escapeHtml = (value: unknown) => String(value ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
  const safeAsset = (value: unknown) => {
    const url = String(value || '');
    return /^(\/|https:\/\/)/.test(url) ? escapeHtml(url) : '';
  };

  // YouTube and Vimeo refuse to be framed from their watch pages, which is why
  // a pasted share link showed "refused to connect". Turn any share form into
  // the player URL those sites do allow in an iframe.
  const embeddableVideo = (value: string) => {
    if (!value) return '';
    const url = value.replace(/&amp;/g, '&');
    let id = '';
    let match = url.match(/^https:\/\/(?:www\.|m\.)?youtube\.com\/watch\?(?:.*&)?v=([\w-]{6,})/);
    if (match) id = match[1];
    if (!id) {
      match = url.match(/^https:\/\/youtu\.be\/([\w-]{6,})/);
      if (match) id = match[1];
    }
    if (!id) {
      match = url.match(/^https:\/\/(?:www\.)?youtube\.com\/(?:shorts|live|embed)\/([\w-]{6,})/);
      if (match) id = match[1];
    }
    if (id) return escapeHtml(`https://www.youtube-nocookie.com/embed/${id}`);

    match = url.match(/^https:\/\/(?:www\.)?vimeo\.com\/(\d+)/);
    if (match) return escapeHtml(`https://player.vimeo.com/video/${match[1]}`);

    return escapeHtml(url);
  };
  const verifyIcon = '<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3l7 3v5c0 4.2-2.9 7.4-7 8.5-4.1-1.1-7-4.3-7-8.5V6l7-3z M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const curriculumMatchIcon = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const calendarIcon = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z M4 10h16 M8 3v4 M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const language = () => document.documentElement.dataset.lang === 'en' ? 'en' : 'ko';
  const tr = (en: string, ko: string) => language() === 'en' ? en : ko;
  type UniversityKey = 'snu' | 'korea' | 'yonsei';
  const universityKeyOf = (value: string): UniversityKey | null => {
    if (/Seoul National|서울(?:대학교|대)/i.test(value)) return 'snu';
    if (/Korea University|고려(?:대학교|대)/i.test(value)) return 'korea';
    if (/Yonsei|연세(?:대학교|대)/i.test(value)) return 'yonsei';
    return null;
  };
  const universityLabel = (key: UniversityKey) => ({
    snu: tr('Seoul National University', '서울대학교'),
    korea: tr('Korea University', '고려대학교'),
    yonsei: tr('Yonsei University', '연세대학교'),
  })[key];
  const cleanUniversity = (tutor: Tutor) => {
    const source = `${tutor.university_en || ''} ${tutor.university || ''}`.trim();
    const key = universityKeyOf(source);
    return key ? universityLabel(key) : tr(tutor.university_en || tutor.university || '', tutor.university || tutor.university_en || '');
  };

  const applyTutorFilter = (filter = activeTutorFilter, announce = true) => {
    activeTutorFilter = filterKeys.has(filter) ? filter : 'all';
    const btn = buttons.find((button) => button.dataset.filter === activeTutorFilter) || buttons[0];
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button === btn)));
    renderDirectory(announce);
  };
  const writeDirectoryUrl = () => {
    const url = new URL(location.href);
    if (activeTutorFilter === 'all') url.searchParams.delete('c');
    else url.searchParams.set('c', activeTutorFilter);
    if (activeSearch.trim()) url.searchParams.set('q', activeSearch.trim());
    else url.searchParams.delete('q');
    if (activeSort === 'default') url.searchParams.delete('sort');
    else url.searchParams.set('sort', activeSort);
    const clean = `${url.pathname}${url.search}${url.hash}`;
    if (!hasDirectoryHistory) {
      history.pushState({ seonbaeTutorDirectory: true }, '', clean);
      hasDirectoryHistory = true;
    } else {
      history.replaceState({ ...(history.state || {}), seonbaeTutorDirectory: true }, '', clean);
    }
  };
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    applyTutorFilter(btn.dataset.filter || 'all');
    writeDirectoryUrl();
  }));
  let searchFrame = 0;
  searchInput?.addEventListener('input', () => {
    activeSearch = searchInput.value.slice(0, 100);
    if (clearSearchButton) clearSearchButton.hidden = !activeSearch;
    cancelAnimationFrame(searchFrame);
    searchFrame = requestAnimationFrame(() => {
      renderDirectory(true);
      writeDirectoryUrl();
    });
  });
  clearSearchButton?.addEventListener('click', () => {
    cancelAnimationFrame(searchFrame);
    activeSearch = '';
    if (searchInput) { searchInput.value = ''; searchInput.focus(); }
    clearSearchButton.hidden = true;
    renderDirectory(true);
    writeDirectoryUrl();
  });
  sortSelect?.addEventListener('change', () => {
    activeSort = sortKeys.has(sortSelect.value) ? sortSelect.value : 'default';
    renderDirectory(true);
    writeDirectoryUrl();
  });
  clearFiltersButton?.addEventListener('click', () => {
    activeTutorFilter = 'all';
    activeSearch = '';
    if (searchInput) searchInput.value = '';
    if (clearSearchButton) clearSearchButton.hidden = true;
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === 'all')));
    renderDirectory(true);
    writeDirectoryUrl();
    searchInput?.focus();
  });
  activeFiltersEl?.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest('[data-remove-filter]') as HTMLButtonElement | null;
    if (!chip) return;
    if (chip.dataset.removeFilter === 'curriculum') {
      activeTutorFilter = 'all';
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === 'all')));
    }
    if (chip.dataset.removeFilter === 'search') {
      activeSearch = '';
      if (searchInput) searchInput.value = '';
      if (clearSearchButton) clearSearchButton.hidden = true;
    }
    renderDirectory(true);
    writeDirectoryUrl();
    if (chip.dataset.removeFilter === 'search') searchInput?.focus();
  });
  window.addEventListener('popstate', () => {
    const params = new URLSearchParams(location.search);
    const requested = params.get('c');
    activeTutorFilter = requested && filterKeys.has(requested) ? requested : 'all';
    activeSearch = (params.get('q') || '').trim().slice(0, 100);
    const sort = params.get('sort');
    activeSort = sort && sortKeys.has(sort) ? sort : 'default';
    if (searchInput) searchInput.value = activeSearch;
    if (clearSearchButton) clearSearchButton.hidden = !activeSearch;
    if (sortSelect) sortSelect.value = activeSort;
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === activeTutorFilter)));
    renderDirectory(true);
  });
  if (searchInput) searchInput.value = activeSearch;
  if (clearSearchButton) clearSearchButton.hidden = !activeSearch;
  if (sortSelect) sortSelect.value = activeSort;
  buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === activeTutorFilter)));

  const DAYS: Array<{ key: string; en: string; ko: string }> = [
    { key: 'mon', en: 'Mon', ko: '월' },
    { key: 'tue', en: 'Tue', ko: '화' },
    { key: 'wed', en: 'Wed', ko: '수' },
    { key: 'thu', en: 'Thu', ko: '목' },
    { key: 'fri', en: 'Fri', ko: '금' },
    { key: 'sat', en: 'Sat', ko: '토' },
    { key: 'sun', en: 'Sun', ko: '일' },
  ];

  // A subject with no score yet (carried over from the application) would
  // render an empty badge, so only complete pairs reach the card.
  const slotsOf = (tutor: Tutor) => (tutor.availability && typeof tutor.availability === 'object') ? tutor.availability : {};
  const hasSlots = (tutor: Tutor) => DAYS.some((day) => (slotsOf(tutor)[day.key] || []).length > 0);
  const bioOf = (tutor: Tutor) => {
    const value = tr(tutor.bio_en || tutor.bio || '', tutor.bio || tutor.bio_en || '');
    return language() === 'en' && value.startsWith('전공 및 학년 · ')
      ? `Major / year · ${value.slice('전공 및 학년 · '.length)}`
      : value;
  };
  const languagesOf = (tutor: Tutor) => {
    const source = tutor.languages || '';
    const known = [
      { test: /Korean|한국어/i, en: 'Korean', ko: '한국어' },
      { test: /English|영어/i, en: 'English', ko: '영어' },
      { test: /Chinese|중국어/i, en: 'Chinese', ko: '중국어' },
      { test: /Japanese|일본어/i, en: 'Japanese', ko: '일본어' },
    ].filter((item) => item.test.test(source));
    return known.length
      ? known.map((item) => language() === 'en' ? item.en : item.ko).join(', ')
      : source || tr('Korean, English', '한국어, 영어');
  };
  const lessonFormatOf = (tutor: Tutor) => {
    const source = tutor.lesson_format || '';
    const imported = /^온라인 1:1 · 주당 (.+)시간 가능$/.exec(source);
    if (imported) return tr(`Online 1:1 · ${imported[1]} hours/week available`, source);
    return source || tr('Online 1:1', '온라인 1:1');
  };

  const curriculumTerms: Record<CurriculumKey, string[]> = {
    ib: ['ib', 'ib diploma', 'international baccalaureate', '아이비', '디플로마'],
    ap: ['ap', 'advanced placement', '에이피'],
    alevel: ['a level', 'a-level', 'alevel', 'a 레벨', '에이레벨'],
    igcse: ['igcse', 'gcse'],
    tests: ['sat', 'act', 'ielts', 'toefl', 'english', '영어', '공인 시험', '공인시험'],
  };
  const curriculumSlugToKey: Record<string, CurriculumKey> = {
    'ib-diploma': 'ib',
    'advanced-placement': 'ap',
    'a-level': 'alevel',
    igcse: 'igcse',
    'standardized-tests': 'tests',
    'english-writing': 'tests',
  };
  const normalizeSearch = (value: unknown) => String(value ?? '')
    .normalize('NFKC')
    .toLocaleLowerCase()
    .replace(/[–—]/g, '-')
    .replace(/[^a-z0-9가-힣*+/.\-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  const queryTokens = (value = activeSearch) => normalizeSearch(value).split(' ').filter(Boolean);
  const directCurricula = (value: string) => {
    const normalized = normalizeSearch(value);
    const found = new Set<CurriculumKey>();
    if (/(^|\s)ib($|\s)|international baccalaureate|아이비|디플로마/.test(normalized)) found.add('ib');
    if (/(^|\s)ap($|\s)|advanced placement|에이피/.test(normalized)) found.add('ap');
    if (/a[ -]?level|alevel|a 레벨|에이레벨/.test(normalized)) found.add('alevel');
    if (/igcse|(^|\s)gcse($|\s)/.test(normalized)) found.add('igcse');
    if (/sat|(^|\s)act($|\s)|ielts|toefl|english|영어/.test(normalized)) found.add('tests');
    return found;
  };
  const subjectCoreTokens = (value: string) => normalizeSearch(value)
    .split(' ')
    .filter((token) => token.length > 1 && !new Set([
      'ib', 'ap', 'hl', 'sl', 'as', 'a', 'level', 'igcse', 'gcse', 'and', 'or', 'the',
      'language', 'exam', 'diploma', 'advanced', 'placement',
    ]).has(token));
  const rateMatchTokens = (value: string) => normalizeSearch(value)
    .split(' ')
    .filter((token) => token.length > 1 && !new Set([
      'ib', 'ap', 'as', 'a', 'level', 'igcse', 'gcse', 'and', 'or', 'the',
      'language', 'exam', 'diploma', 'advanced', 'placement',
    ]).has(token));
  const curriculaForScore = (tutor: Tutor, row: SubjectScore) => {
    const direct = directCurricula(row.subject);
    if (direct.size) return direct;
    const tutorCurricula = categoriesFor(tutor) as CurriculumKey[];
    return new Set<CurriculumKey>(tutorCurricula.length === 1 ? tutorCurricula : []);
  };
  const aliasesForScore = (tutor: Tutor, row: SubjectScore) => {
    const aliases = new Set<string>();
    const rowTokens = subjectCoreTokens(row.subject);
    const curricula = curriculaForScore(tutor, row);
    rates.forEach((rate) => {
      const rateKey = curriculumSlugToKey[rate.curriculum];
      if (!rateKey || (curricula.size && !curricula.has(rateKey))) return;
      const rateTokens = [rate.name, rate.nameKo || '', ...rate.aliases].flatMap(subjectCoreTokens);
      const related = rowTokens.some((token) => rateTokens.includes(token))
        || rateTokens.some((token) => rowTokens.includes(token));
      if (!related) return;
      aliases.add(rate.name);
      if (rate.nameKo) aliases.add(rate.nameKo);
      rate.aliases.forEach((alias) => aliases.add(alias));
    });
    return [...aliases];
  };
  const scoreSearchText = (tutor: Tutor, row: SubjectScore) => {
    const curricula = curriculaForScore(tutor, row);
    const terms = [...curricula].flatMap((key) => [curriculumNames[key].en, curriculumNames[key].ko, ...curriculumTerms[key]]);
    return normalizeSearch([row.subject, row.score, ...terms, ...aliasesForScore(tutor, row)].join(' '));
  };
  const tutorSearchText = (tutor: Tutor) => normalizeSearch([
    tutor.name,
    tutor.name_en,
    tutor.university,
    tutor.university_en,
    tutor.exam,
    tutor.category,
    ...categoriesFor(tutor).flatMap((key) => curriculumTerms[key as CurriculumKey] || []),
    ...scoresOf(tutor).flatMap((row) => [row.subject, row.score, scoreSearchText(tutor, row)]),
  ].join(' '));
  const matchesTokens = (haystack: string, tokens: string[]) => tokens.every((token) => haystack.includes(token));
  const matchingScores = (tutor: Tutor, tokens = queryTokens()) => tokens.length
    ? scoresOf(tutor).filter((row) => matchesTokens(scoreSearchText(tutor, row), tokens))
    : [];
  const validTopLevelScore = (tutor: Tutor) => {
    const score = String(tutor.score || '').trim();
    const label = String(tutor.exam || '').trim();
    return score && score !== '.' ? { score, subject: label } : null;
  };
  const bestScore = (rows: SubjectScore[]) => [...rows].sort((a, b) => scoreValue(b) - scoreValue(a))[0] || null;
  const parseAvailabilityRange = (value: string) => {
    const match = value.match(/^\s*(\d{1,2}):(\d{2})\s*[-–—]\s*(\d{1,2}):(\d{2})\s*$/);
    if (!match) return null;
    const startHour = Number(match[1]);
    const startMinute = Number(match[2]);
    const endHour = Number(match[3]);
    const endMinute = Number(match[4]);
    if (startHour > 24 || endHour > 24 || startMinute > 59 || endMinute > 59) return null;
    if ((startHour === 24 && startMinute !== 0) || (endHour === 24 && endMinute !== 0)) return null;
    if (endHour * 60 + endMinute <= startHour * 60 + startMinute) return null;
    return { start: startHour * 60 + startMinute, end: endHour * 60 + endMinute };
  };
  const SCHEDULE_START = 6 * 60;
  const SCHEDULE_END = 24 * 60;
  const SCHEDULE_SPAN = SCHEDULE_END - SCHEDULE_START;
  const availabilityTimetable = (tutor: Tutor) => {
    const slots = slotsOf(tutor);
    const blocks = DAYS.flatMap((day, dayIndex) => {
      const ranges = Array.isArray(slots[day.key]) ? slots[day.key] : [];
      return ranges.flatMap((range, rangeIndex) => {
        if (typeof range !== 'string') return [];
        const parsed = parseAvailabilityRange(range);
        if (!parsed) return [];
        const start = Math.max(SCHEDULE_START, parsed.start);
        const end = Math.min(SCHEDULE_END, parsed.end);
        return end > start ? [{ day, dayIndex, rangeIndex, range, start, end }] : [];
      });
    });
    if (!blocks.length) return `<p class="pf__empty">${tr('This tutor has not published hours yet.', '아직 등록된 가능 시간이 없습니다.')}</p>`;
    const aria = `${tr('Weekly availability timetable', '주간 가능 시간표')}: ${blocks.map(({ day, range }) => `${tr(day.en, day.ko)} ${range}`).join(', ')}`;
    return `<div class="weekgrid" role="group" aria-label="${escapeHtml(aria)}">
      <div class="weekgrid__head"><span aria-hidden="true"></span>${DAYS.map((day) => `<b>${tr(day.en, day.ko)}</b>`).join('')}</div>
      <div class="weekgrid__body">
        <div class="weekgrid__times" aria-hidden="true">
          <span style="--time-top:0">06</span><span style="--time-top:33.333">12</span><span style="--time-top:66.667">18</span><span style="--time-top:100">24</span>
        </div>
        <div class="weekgrid__plot">${blocks.map(({ day, dayIndex, rangeIndex, range, start, end }) => {
          const label = `${tr(day.en, day.ko)} ${range.replace(/\s*[-–—]\s*/, '–')}`;
          const top = ((start - SCHEDULE_START) / SCHEDULE_SPAN) * 100;
          const height = ((end - start) / SCHEDULE_SPAN) * 100;
          return `<span class="weekgrid__slot" tabindex="0" role="img" data-tone="${(dayIndex + rangeIndex) % 5}" data-time-label="${escapeHtml(label)}" style="--day-index:${dayIndex};--slot-top:${top};--slot-height:${height}" title="${escapeHtml(label)}" aria-label="${escapeHtml(label)}"></span>`;
        }).join('')}</div>
      </div>
    </div>`;
  };

  const matchingRateForScore = (tutor: Tutor, row: SubjectScore) => {
    const rowTokens = rateMatchTokens(row.subject);
    if (!rowTokens.length) return null;
    const curricula = curriculaForScore(tutor, row);
    const ranked = rates
      .filter((rate) => {
        const key = curriculumSlugToKey[rate.curriculum];
        return key && (!curricula.size || curricula.has(key));
      })
      .map((rate) => {
        const rateTokens = [...new Set([rate.name, rate.nameKo || '', ...rate.aliases].flatMap(rateMatchTokens))];
        const overlap = rowTokens.filter((token) => rateTokens.includes(token)).length;
        const specificity = overlap ? overlap / Math.max(rowTokens.length, rateTokens.length) : 0;
        return { rate, overlap, specificity };
      })
      .filter(({ overlap }) => overlap > 0)
      .sort((a, b) => b.overlap - a.overlap || b.specificity - a.specificity || a.rate.name.length - b.rate.name.length);
    const best = ranked[0];
    if (!best) return null;
    const tiedPrices = new Set(ranked
      .filter((item) => item.overlap === best.overlap && item.specificity === best.specificity)
      .map((item) => item.rate.price));
    return tiedPrices.size === 1 ? best.rate : null;
  };
  const formatWon = (value: number) => `₩${Math.round(value).toLocaleString('en-US')}`;

  const sortedTutors = (tutors: Tutor[]) => [...tutors].sort((a, b) => {
    if (activeSort === 'curriculum') {
      const aKey = curriculumOrder.indexOf(categoriesFor(a)[0] as CurriculumKey);
      const bKey = curriculumOrder.indexOf(categoriesFor(b)[0] as CurriculumKey);
      return aKey - bKey || defaultTutorSort(a, b);
    }
    if (activeSort === 'university') {
      return cleanUniversity(a).localeCompare(cleanUniversity(b), language() === 'en' ? 'en' : 'ko')
        || defaultTutorSort(a, b);
    }
    if (activeSort === 'recent') {
      const aTime = Date.parse(a.created_at || '') || 0;
      const bTime = Date.parse(b.created_at || '') || 0;
      return bTime - aTime || displayOrderOf(b) - displayOrderOf(a) || a.registry_id.localeCompare(b.registry_id);
    }
    return tutorStrength(b) - tutorStrength(a) || defaultTutorSort(a, b);
  });
  const scoreSignature = (row: SubjectScore) => `${row.subject}\u0000${row.score}`;
  const profileCard = (tutor: Tutor, state: PreviewState | null, tokens: string[]) => {
    const displayName = tr(tutor.name_en || tutor.name, tutor.name);
    const altName = tr(tutor.name, tutor.name_en || tutor.name);
    const uni = escapeHtml(cleanUniversity(tutor));
    const bio = bioOf(tutor);
    const photo = safeAsset(tutor.photo_url) || cardPhoto;
    const previewLabel = state === 'existing'
      ? tr('Existing card', '현재 카드')
      : state === 'update'
        ? tr('Proposed update', '수정 카드')
        : tr('New draft', '새 카드');
    const matched = matchingScores(tutor, tokens);
    const matchedKeys = new Set(matched.map(scoreSignature));
    const rawScores = scoresOf(tutor);
    const fallback = validTopLevelScore(tutor);
    const tagSource = rawScores.length ? rawScores : fallback ? [fallback] : [];
    const orderedScores = [...tagSource].sort((a, b) => {
      const aMatch = matchedKeys.has(scoreSignature(a)) ? 1 : 0;
      const bMatch = matchedKeys.has(scoreSignature(b)) ? 1 : 0;
      return bMatch - aMatch;
    });
    const scoreList = orderedScores.map((row) => {
      const fallbackMatches = !rawScores.length && tokens.length && matchesTokens(scoreSearchText(tutor, row), tokens);
      const isMatch = matchedKeys.has(scoreSignature(row)) || fallbackMatches;
      return `<li${isMatch ? ' class="is-match"' : ''} title="${escapeHtml(`${row.subject}: ${row.score}`)}"><b>${escapeHtml(row.score)}</b><span>${escapeHtml(row.subject)}</span></li>`;
    }).join('');
    const categoryList = categoriesFor(tutor).map((key) => {
      const category = curriculumNames[key as CurriculumKey];
      if (!category) return '';
      const label = escapeHtml(tr(category.en, category.ko));
      const matchesFilter = activeTutorFilter !== 'all' && activeTutorFilter === key;
      return `<li${matchesFilter ? ` class="is-filter-match" aria-label="${label} ${tr('selected curriculum', '선택한 커리큘럼')}"` : ''}>${matchesFilter ? curriculumMatchIcon : ''}<span>${label}</span></li>`;
    }).join('');
    const metaParts = [
      tutor.languages ? languagesOf(tutor) : '',
      tutor.lesson_format ? lessonFormatOf(tutor) : '',
      safeAsset(tutor.video_url) ? tr('Sample lesson available', '샘플 수업 있음') : '',
    ].filter(Boolean);
    const previewState = sandboxMode ? state || 'new' : null;

    return `<div class="tutor-cell" data-cats="${categoriesFor(tutor).join(' ')}" data-registry-id="${escapeHtml(tutor.registry_id)}"${previewState ? ` data-preview-state="${previewState}"` : ''}>
      <article class="tcardx card">
        <button type="button" class="tcardx__surface" data-profile="${escapeHtml(tutor.registry_id)}" aria-label="${escapeHtml(displayName)} ${tr('profile', '프로필')} ${tr('open', '열기')}"></button>
        <span class="tcardx__verified">${verifyIcon}${sandboxMode ? previewLabel : tr('Verified Tutor', '검증 완료')}</span>
        <div class="tcardx__identity">
          <img class="tcardx__avatar" src="${photo}" alt="${tr('Portrait of', '프로필 사진')} ${escapeHtml(displayName)}" width="96" height="96" loading="lazy" decoding="async" />
          <div class="tcardx__identity-copy">
            <h3 class="tcardx__name"><span class="tcardx__profile-label"><span>${escapeHtml(displayName)}</span>${altName && altName !== displayName ? `<small>${escapeHtml(altName)}</small>` : ''}</span></h3>
            ${uni ? `<p class="tcardx__uni">${uni}</p>` : ''}
          </div>
        </div>
        ${categoryList ? `<ul class="tcardx__curricula" aria-label="${tr('Curricula taught', '수업 가능 커리큘럼')}">${categoryList}</ul>` : ''}
        ${scoreList ? `<p class="tcardx__score-head">${tr('Subjects and verified scores', '과목 및 검증 성적')}</p><ul class="tcardx__scores">${scoreList}</ul>` : ''}
        ${bio ? `<p class="tcardx__bio">${escapeHtml(bio)}</p>` : ''}
        ${metaParts.length ? `<p class="tcardx__meta-line">${metaParts.map(escapeHtml).join(' · ')}</p>` : ''}
        <div class="tcardx__foot">
          <span class="tcardx__view">${tr('View full profile', '전체 프로필 보기')}<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </article>
    </div>`;
  };
  const filterLabel = (key: string) => buttons
    .find((button) => button.dataset.filter === key)
    ?.querySelector('[data-filter-label]')?.textContent?.trim() || key;
  const renderActiveFilters = () => {
    if (!activeFiltersEl) return;
    const chips: string[] = [];
    if (activeTutorFilter !== 'all') {
      chips.push(`<button type="button" class="active-filter" data-remove-filter="curriculum"><span>${escapeHtml(filterLabel(activeTutorFilter))}</span><b aria-hidden="true">×</b><span class="sr-only">${tr('Remove curriculum filter', '커리큘럼 필터 지우기')}</span></button>`);
    }
    if (activeSearch.trim()) {
      chips.push(`<button type="button" class="active-filter" data-remove-filter="search"><span>“${escapeHtml(activeSearch.trim())}”</span><b aria-hidden="true">×</b><span class="sr-only">${tr('Clear search', '검색어 지우기')}</span></button>`);
    }
    activeFiltersEl.innerHTML = chips.join('');
    applyScope(activeFiltersEl);
  };
  function renderDirectory(announce = true) {
    const grid = document.getElementById('tutor-grid');
    if (!grid || !roster.length) return;
    const tokens = queryTokens();
    const filtered = roster.filter((tutor) => {
      const curriculumMatches = activeTutorFilter === 'all' || categoriesFor(tutor).includes(activeTutorFilter);
      const searchMatches = !tokens.length || matchesTokens(tutorSearchText(tutor), tokens);
      return curriculumMatches && searchMatches;
    });
    const visible = sortedTutors(filtered);
    grid.classList.remove('is-loading');
    grid.removeAttribute('aria-busy');
    grid.innerHTML = visible.map((tutor) => profileCard(
      tutor,
      sandboxMode ? previewStates.get(tutor.registry_id) || 'new' : null,
      tokens,
    )).join('');
    applyScope(grid);
    cells = [...grid.querySelectorAll('.tutor-cell')] as HTMLElement[];
    if (countEl) countEl.textContent = String(visible.length);
    renderActiveFilters();
    if (noMatch) noMatch.hidden = visible.length > 0;
    if (clearFiltersButton) clearFiltersButton.hidden = visible.length > 0;
    const live = document.getElementById('tutor-live');
    if (announce && live) live.textContent = tr(
      `${visible.length} tutor${visible.length === 1 ? '' : 's'} found.`,
      `튜터 ${visible.length}명이 검색되었습니다.`,
    );
  }
  const renderTutors = (tutors: Tutor[], states = new Map<string, PreviewState>()) => {
    roster = tutors;
    previewStates = states;
    Object.keys(staticFilterCounts).forEach((key) => { staticFilterCounts[key] = 0; });
    staticFilterCounts.all = tutors.length;
    tutors.forEach((tutor) => {
      categoriesFor(tutor).forEach((category) => { staticFilterCounts[category] += 1; });
    });
    buttons.forEach((button) => {
      const badge = button.querySelector('.rail__n') as HTMLElement | null;
      if (!badge) return;
      badge.textContent = String(staticFilterCounts[button.dataset.filter || 'all'] || 0);
      badge.classList.remove('rail__n--loading');
      badge.removeAttribute('aria-hidden');
    });
    countEl?.classList.remove('count-skeleton');
    countEl?.removeAttribute('aria-hidden');
    if (countLabel) countLabel.textContent = tr('tutors listed', '명의 튜터');
    const universityKeys = new Set(tutors
      .map((tutor) => universityKeyOf(`${tutor.university_en || ''} ${tutor.university || ''}`))
      .filter((key): key is UniversityKey => Boolean(key)));
    const universities = (['snu', 'korea', 'yonsei'] as UniversityKey[])
      .filter((key) => universityKeys.has(key))
      .map(universityLabel);
    if (universityLine) universityLine.textContent = universities.join(' · ');
    const note = document.getElementById('roster-note');
    if (note) note.hidden = tutors.length > 0;
    renderDirectory(false);
    queueMicrotask(openProfileFromHash);
  };

  const normalizePreviewRow = (raw: Record<string, unknown>): Tutor | null => {
    const text = (value: unknown) => typeof value === 'string' ? value.trim() : '';
    const registryId = text(raw.registry_id);
    const name = text(raw.name);
    const exam = text(raw.exam);
    const score = text(raw.score);
    if (!registryId || !name || !exam || !score) return null;
    const scores = Array.isArray(raw.subjectScores)
      ? raw.subjectScores
      : Array.isArray(raw.subject_scores) ? raw.subject_scores : [];
    const availability = raw.availability && typeof raw.availability === 'object' && !Array.isArray(raw.availability)
      ? raw.availability as Record<string, string[]>
      : {};
    return {
      registry_id: registryId,
      name,
      name_en: text(raw.name_en),
      exam,
      score,
      category: text(raw.category),
      university: text(raw.university),
      university_en: text(raw.university_en),
      photo_url: text(raw.photo_url) || null,
      banner_url: text(raw.banner_url) || null,
      subject_scores: scores as Array<{ subject: string; score: string }>,
      availability,
      bio: text(raw.bio) || null,
      bio_en: text(raw.bioEn ?? raw.bio_en) || null,
      video_url: text(raw.videoUrl ?? raw.video_url) || null,
      languages: text(raw.languages) || null,
      lesson_format: text(raw.lessonFormat ?? raw.lesson_format) || null,
      display_order: Number.isFinite(Number(raw.display_order)) ? Number(raw.display_order) : 0,
      created_at: text(raw.created_at) || null,
      active: raw.active === true,
    };
  };

  const finishGridLoading = (error?: unknown) => {
    const grid = document.getElementById('tutor-grid');
    if (grid) {
      grid.innerHTML = '';
      grid.classList.remove('is-loading');
      grid.removeAttribute('aria-busy');
    }
    roster = [];
    if (countEl) {
      countEl.textContent = '0';
      countEl.classList.remove('count-skeleton');
      countEl.removeAttribute('aria-hidden');
    }
    buttons.forEach((button) => {
      const badge = button.querySelector('.rail__n');
      if (!badge) return;
      badge.textContent = '0';
      badge.classList.remove('rail__n--loading');
      badge.removeAttribute('aria-hidden');
    });
    if (universityLine) universityLine.textContent = '';
    if (noMatchCopy) noMatchCopy.textContent = error
      ? tr('We could not load the tutor directory. Please refresh and try again.', '튜터 명부를 불러오지 못했습니다. 새로고침 후 다시 시도해 주세요.')
      : tr('No tutors are listed yet.', '아직 등록된 튜터가 없습니다.');
    if (noMatch) noMatch.hidden = false;
    if (clearFiltersButton) clearFiltersButton.hidden = true;
  };

  if (sandboxMode) {
    const sandbox = document.getElementById('tutor-sandbox');
    const fileName = sandbox?.querySelector('[data-sandbox-file]') as HTMLElement | null;
    const previewCount = sandbox?.querySelector('[data-sandbox-count]') as HTMLElement | null;
    const existingCountEl = sandbox?.querySelector('[data-sandbox-existing-count]') as HTMLElement | null;
    const newCountEl = sandbox?.querySelector('[data-sandbox-new-count]') as HTMLElement | null;
    const updateCountEl = sandbox?.querySelector('[data-sandbox-update-count]') as HTMLElement | null;
    const applyButton = sandbox?.querySelector('[data-sandbox-apply]') as HTMLButtonElement | null;
    const status = sandbox?.querySelector('[data-sandbox-status]') as HTMLElement | null;
    if (sandbox) sandbox.hidden = false;
    const heroCopy = document.querySelector('.phero__copy');
    if (heroCopy) heroCopy.textContent = tr(
      'These are unpublished drafts generated from the selected spreadsheet. Verification is not complete.',
      '선택한 엑셀에서 만든 비공개 카드 초안입니다. 아직 검증 완료 상태가 아닙니다.',
    );

    const showSandboxError = (message: string) => {
      const grid = document.getElementById('tutor-grid');
      if (grid) grid.innerHTML = '';
      finishGridLoading();
      if (countEl) countEl.textContent = '0';
      if (previewCount) previewCount.textContent = '0';
      if (existingCountEl) existingCountEl.textContent = '0';
      if (newCountEl) newCountEl.textContent = '0';
      if (updateCountEl) updateCountEl.textContent = '0';
      if (fileName) fileName.textContent = tr('No valid preview file', '유효한 미리보기 파일 없음');
      if (status) { status.textContent = message; status.dataset.tone = 'error'; }
      document.documentElement.dataset.tutorSandbox = 'ready';
    };

    try {
      const stored = window.sessionStorage.getItem(PREVIEW_STORAGE_KEY);
      const parsed = stored ? JSON.parse(stored) as PreviewPayload : null;
      const isFresh = parsed && Number.isFinite(parsed.createdAt) && Date.now() - parsed.createdAt <= PREVIEW_MAX_AGE_MS;
      if (!parsed || parsed.version !== 1 || !isFresh || !Array.isArray(parsed.rows) || !parsed.rows.length) {
        if (stored) window.sessionStorage.removeItem(PREVIEW_STORAGE_KEY);
        showSandboxError(tr(
          'This preview is missing or expired. Return to admin and choose the Excel file again.',
          '미리보기 정보가 없거나 만료되었습니다. 관리 화면으로 돌아가 엑셀 파일을 다시 선택해 주세요.',
        ));
      } else {
        const importedTutors = parsed.rows.map(normalizePreviewRow).filter((row): row is Tutor => Boolean(row));
        if (importedTutors.length !== parsed.rows.length || !importedTutors.length) {
          showSandboxError(tr(
            'Some card data could not be read. Return to admin and choose the file again.',
            '일부 카드 정보를 읽지 못했습니다. 관리 화면에서 파일을 다시 선택해 주세요.',
          ));
        } else {
          const existingTutors = (Array.isArray(parsed.existingRows) ? parsed.existingRows : [])
            .map(normalizePreviewRow)
            .filter((row): row is Tutor => Boolean(row));
          const knownExistingIds = new Set((parsed.existingRegistryIds || []).map(String));
          const merged = new Map(existingTutors.map((tutor) => [tutor.registry_id, tutor]));
          previewStates = new Map(existingTutors.map((tutor) => [tutor.registry_id, 'existing' as PreviewState]));
          importedTutors.forEach((tutor) => {
            previewStates.set(tutor.registry_id, merged.has(tutor.registry_id) || knownExistingIds.has(tutor.registry_id) ? 'update' : 'new');
            merged.set(tutor.registry_id, tutor);
          });
          const tutors = [...merged.values()].sort((a, b) =>
            (a.display_order || Number.MAX_SAFE_INTEGER) - (b.display_order || Number.MAX_SAFE_INTEGER)
            || a.registry_id.localeCompare(b.registry_id),
          );
          const counts = { existing: 0, new: 0, update: 0 };
          previewStates.forEach((state) => { counts[state] += 1; });
          previewPayload = parsed;
          renderTutors(tutors, previewStates);
          if (fileName) fileName.textContent = parsed.fileName || tr('Excel import', '엑셀 가져오기');
          if (previewCount) previewCount.textContent = String(tutors.length);
          if (existingCountEl) existingCountEl.textContent = String(counts.existing);
          if (newCountEl) newCountEl.textContent = String(counts.new);
          if (updateCountEl) updateCountEl.textContent = String(counts.update);
          if (applyButton) applyButton.disabled = false;
          if (status) status.textContent = tr(
            'Private application fields are excluded. Booking controls are disabled in this preview.',
            '연락처·이메일·증빙 링크는 제외되었으며, 이 화면에서는 매칭 요청도 비활성화됩니다.',
          );
          document.documentElement.dataset.tutorSandbox = 'ready';
        }
      }
    } catch {
      showSandboxError(tr(
        'The browser could not open this preview. Return to admin and try again.',
        '브라우저에서 미리보기를 열지 못했습니다. 관리 화면에서 다시 시도해 주세요.',
      ));
    }

    applyButton?.addEventListener('click', async () => {
      if (!previewPayload || !applyButton || !status) return;
      const existing = new Set((previewPayload.existingRegistryIds || []).map(String));
      const updateCount = previewPayload.rows.filter((row) => existing.has(String(row.registry_id || ''))).length;
      const createCount = previewPayload.rows.length - updateCount;
      const summary = language() === 'en'
        ? `${createCount} new card${createCount === 1 ? '' : 's'}, ${updateCount} update${updateCount === 1 ? '' : 's'}`
        : `새 카드 ${createCount}개, 기존 카드 수정 ${updateCount}개`;
      if (!window.confirm(tr(
        `Apply ${summary} to Supabase? The cards remain private unless the spreadsheet explicitly marks them active.`,
        `${summary}를 Supabase에 반영할까요? 엑셀에서 공개로 명시하지 않은 카드는 비공개로 저장됩니다.`,
      ))) return;

      applyButton.disabled = true;
      status.removeAttribute('data-tone');
      status.textContent = tr('Applying the reviewed cards…', '확인한 카드를 반영하는 중입니다…');
      try {
        const response = await fetch('/api/admin/tutors/import', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rows: previewPayload.rows }),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok) throw new Error(result?.error || tr('The cards could not be applied.', '카드를 반영하지 못했습니다.'));
        window.sessionStorage.removeItem(PREVIEW_STORAGE_KEY);
        status.dataset.tone = 'ok';
        status.textContent = tr(
          'Applied successfully. Return to admin to edit or publish the cards.',
          '반영을 마쳤습니다. 관리 화면에서 카드를 수정하거나 공개할 수 있습니다.',
        );
        applyButton.textContent = tr('Applied', '반영 완료');
      } catch (error) {
        status.dataset.tone = 'error';
        status.textContent = error instanceof Error ? error.message : tr('Please try again.', '다시 시도해 주세요.');
        applyButton.disabled = false;
      }
    });
  } else {
    fetch('/api/tutors', { cache: 'no-store', headers: { Accept: 'application/json' } })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('Tutor directory unavailable')))
      .then((rows) => {
        if (Array.isArray(rows) && rows.length > 0) renderTutors(rows);
        else finishGridLoading();
      })
      .catch(finishGridLoading);
  }
  // ----- Viewer session ----------------------------------------------------
  // Booking needs a signed-in student or parent, so the button explains itself
  // rather than failing after the form is filled in.
  let viewer: { authenticated: boolean; role?: string } = { authenticated: false };
  fetch('/api/auth/session', { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' } })
    .then((response) => response.ok ? response.json() : { authenticated: false })
    .then((data) => { viewer = data || { authenticated: false }; })
    .catch(() => {});
  const canBook = () => !sandboxMode && viewer.authenticated && (viewer.role === 'student' || viewer.role === 'parent');

  // ----- Profile dialog ----------------------------------------------------
  const profileDialog = document.querySelector('#profile-dialog') as HTMLDialogElement | null;
  const profileBody = profileDialog?.querySelector('[data-profile-body]') as HTMLElement | null;
  let profileReturnFocus: HTMLElement | null = null;

  const openProfile = (registryId: string, trigger?: HTMLElement | null, updateRoute = true) => {
    const tutor = roster.find((row) => row.registry_id === registryId);
    if (!tutor || !profileDialog || !profileBody) return;
    profileReturnFocus = trigger || null;

    const name = tr(tutor.name_en || tutor.name, tutor.name);
    const uni = escapeHtml(cleanUniversity(tutor));
    const bio = bioOf(tutor);
    const scores = scoresOf(tutor);
    const video = embeddableVideo(safeAsset(tutor.video_url));
    const photo = safeAsset(tutor.photo_url) || cardPhoto;
    const fallback = validTopLevelScore(tutor);
    const profileScores = scores.length ? scores : fallback ? [fallback] : [];
    const bioNeedsToggle = bio.length > 180;
    const categoryList = categoriesFor(tutor).map((key) => {
      const category = curriculumNames[key as CurriculumKey];
      return category ? `<li>${escapeHtml(tr(category.en, category.ko))}</li>` : '';
    }).join('');
    const pricingHref = tr('/en/pricing/#all-rates', '/pricing/#all-rates');
    const rateList = profileScores.map((row) => {
      const rate = matchingRateForScore(tutor, row);
      return `<li>
        <span class="pf__rate-subject">${escapeHtml(row.subject)}<small class="pf__rate-score">${tr('Verified score', '검증 성적')} ${escapeHtml(row.score)}</small></span>
        ${rate
          ? `<span class="pf__rate-price">${formatWon(rate.price)}<small>${tr('per hour', '시간당')}</small></span>`
          : `<a class="pf__rate-missing" href="${pricingHref}">${tr('See rate', '요금 확인')}</a>`}
      </li>`;
    }).join('');

    profileBody.innerHTML = `
      <div class="pf__layout">
        <main class="pf__main">
          <header class="pf__head">
            <div class="pf__portrait">
              <img src="${photo}" alt="${tr('Portrait of', '프로필 사진')} ${escapeHtml(name)}" width="320" height="320" />
              <span class="pf__verified">${verifyIcon}${sandboxMode ? tr('Preview', '미리보기') : tr('Verified', '검증 완료')}</span>
            </div>
            <div class="pf__ident">
              <h2 class="pf__name" id="profile-name">${escapeHtml(name)}</h2>
              ${uni ? `<p class="pf__uni">${uni}</p>` : ''}
              ${categoryList ? `<ul class="tcardx__curricula" aria-label="${tr('Curricula taught', '수업 가능 커리큘럼')}">${categoryList}</ul>` : ''}
            </div>
          </header>

          <dl class="pf__meta">
            <div><dt>${tr('Languages', '언어')}</dt><dd>${escapeHtml(languagesOf(tutor))}</dd></div>
            <div><dt>${tr('Format', '형식')}</dt><dd>${escapeHtml(lessonFormatOf(tutor))}</dd></div>
          </dl>

          <section class="pf__block">
            <h3 class="pf__sub">${tr('Introduction', '소개')}</h3>
            ${bio
              ? `<p class="pf__bio${bioNeedsToggle ? ' is-collapsed' : ''}" data-profile-bio>${escapeHtml(bio)}</p>${bioNeedsToggle
                  ? `<button type="button" class="pf__bio-toggle" data-expand-bio data-collapsed-label="${tr('View full introduction', '소개 전체 보기')}" data-expanded-label="${tr('Show less', '간단히 보기')}" aria-expanded="false">${tr('View full introduction', '소개 전체 보기')}</button>`
                  : ''}`
              : `<p class="pf__empty">${tr('Introduction coming soon.', '소개글 준비 중입니다.')}</p>`}
          </section>

          <section class="pf__block">
            <h3 class="pf__sub">${tr('Available hours', '가능 시간')}</h3>
            ${availabilityTimetable(tutor)}
          </section>

          ${video ? `<section class="pf__block">
            <h3 class="pf__sub">${tr('Sample lesson', '샘플 수업')}</h3>
            ${/\.(mp4|webm|ogg)$/i.test(video)
              ? `<div class="pf__video"><video src="${video}" controls playsinline preload="metadata"></video></div>`
              : `<div class="pf__video"><iframe src="${video}" title="${escapeHtml(name)}" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>`}
          </section>` : ''}
        </main>

        <aside class="pf__aside" aria-label="${tr('Subjects and hourly rates', '과목 및 시간당 요금')}">
          <p class="pf__aside-kicker">${tr('Published rate card', '공개 요금표')}</p>
          <h3>${tr('Subjects and hourly rates', '과목 및 시간당 요금')}</h3>
          ${rateList
            ? `<ul class="pf__rate-list">${rateList}</ul>`
            : `<p class="pf__empty">${tr('Subject details are being prepared.', '수업 과목을 준비 중입니다.')}</p>`}
          <p class="pf__rate-note">${tr('Rates are taken from Seonbae’s published subject rate card.', '요금은 선배의 공개 과목별 요금표를 기준으로 합니다.')}</p>
          ${sandboxMode
            ? `<button type="button" class="tcardx__book" disabled aria-disabled="true">${calendarIcon}${tr('Preview only', '미리보기 전용')}</button>`
            : `<button type="button" class="tcardx__book" data-book="${escapeHtml(tutor.registry_id)}">${calendarIcon}${tr('Request a match', '매칭 요청하기')}</button>`}
          <a class="textlink" href="${pricingHref}">${tr('View every subject rate', '전체 과목 요금 보기')}</a>
        </aside>
      </div>`;

    // Injected markup carries no data-astro-cid-*, so every scoped rule in this
    // file misses it and the dialog renders as bare HTML. Stamp it like the grid.
    applyScope(profileBody);
    // Announce the tutor rather than the static "Tutor profile" eyebrow.
    profileDialog.setAttribute('aria-labelledby', 'profile-name');

    const profileHash = `#/t/${encodeURIComponent(tutor.registry_id)}`;
    if (updateRoute && location.hash !== profileHash) {
      history.pushState({ tutorProfile: tutor.registry_id }, '', profileHash);
    }

    if (!profileDialog.open) {
      if (typeof profileDialog.showModal === 'function') profileDialog.showModal();
      else profileDialog.setAttribute('open', '');
    }
  };

  function profileIdFromHash() {
    const match = /^#\/t\/(.+)$/.exec(location.hash);
    if (!match) return '';
    try { return decodeURIComponent(match[1]); } catch { return ''; }
  }

  function openProfileFromHash() {
    const registryId = profileIdFromHash();
    if (registryId) openProfile(registryId, null, false);
  }

  function clearProfileRoute() {
    if (!profileIdFromHash()) return;
    history.replaceState(null, '', `${location.pathname}${location.search}`);
  }

  // ----- Booking dialog ----------------------------------------------------
  const dialog = document.querySelector('#book-dialog') as HTMLDialogElement | null;
  const bookForm = dialog?.querySelector('form.book__form') as HTMLFormElement | null;
  const bookTitle = dialog?.querySelector('[data-book-title]') as HTMLElement | null;
  const bookCal = dialog?.querySelector('[data-book-calendar]') as HTMLElement | null;
  const bookDay = dialog?.querySelector('select[name="preferredDay"]') as HTMLSelectElement | null;
  const bookTime = dialog?.querySelector('input[name="preferredTime"]') as HTMLInputElement | null;
  const bookGate = dialog?.querySelector('[data-book-gate]') as HTMLElement | null;
  const bookStatus = dialog?.querySelector('[data-book-status]') as HTMLElement | null;
  const bookSubmit = dialog?.querySelector('.book__submit') as HTMLButtonElement | null;
  let bookingTutor: Tutor | null = null;

  const openBooking = (registryId: string) => {
    bookingTutor = roster.find((tutor) => tutor.registry_id === registryId) ?? null;
    if (!bookingTutor || !dialog) return;
    profileDialog?.close();

    if (bookTitle) bookTitle.textContent = tr(bookingTutor.name_en || bookingTutor.name, bookingTutor.name);
    if (bookStatus) { bookStatus.hidden = true; bookStatus.textContent = ''; }
    bookForm?.reset();

    // Signed-out visitors, and tutors or admins, see the reason instead of a
    // form they cannot submit.
    const allowed = canBook();
    if (bookGate) {
      bookGate.hidden = allowed;
      bookGate.innerHTML = allowed
        ? ''
        : viewer.authenticated
          ? tr('Only student and parent accounts can request a match.', '학생 또는 보호자 계정만 매칭을 요청할 수 있습니다.')
          : `${tr('Sign in to request a match.', '매칭을 요청하려면 로그인해 주세요.')} <a href="/login">${tr('Log in', '로그인')}</a>`;
    }
    if (bookForm) bookForm.hidden = !allowed;
    if (bookGate) applyScope(bookGate);

    // Published hours become one-tap presets; the day and time controls stay
    // editable so a visitor can always propose their own slot.
    const slots = slotsOf(bookingTutor);
    if (bookCal) {
      bookCal.innerHTML = hasSlots(bookingTutor)
        ? DAYS.map((day) => {
            const ranges = slots[day.key] || [];
            if (!ranges.length) return '';
            return ranges.map((range) => {
              const start = range.split('-')[0];
              return `<button type="button" class="book__slot" data-day="${day.key}" data-time="${escapeHtml(start)}">${tr(day.en, day.ko)} ${escapeHtml(range)}</button>`;
            }).join('');
          }).join('')
        : `<p class="book__empty">${tr('This tutor has not published hours. Choose any time below and we will arrange it.', '등록된 가능 시간이 없습니다. 아래에서 원하는 시간을 선택해 주시면 조율해 드립니다.')}</p>`;
      applyScope(bookCal);
    }

    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const bookTrigger = target.closest('[data-book]') as HTMLElement | null;
    if (bookTrigger) { event.stopPropagation(); openBooking(bookTrigger.dataset.book || ''); return; }

    const play = target.closest('[data-video]') as HTMLElement | null;
    if (play) { event.stopPropagation(); openVideo(play.dataset.video || '', play.dataset.name || ''); return; }

    const slot = target.closest('.book__slot') as HTMLElement | null;
    if (slot) {
      dialog?.querySelectorAll('.book__slot').forEach((node) => node.classList.remove('is-on'));
      slot.classList.add('is-on');
      if (bookDay) bookDay.value = slot.dataset.day || '';
      if (bookTime) bookTime.value = slot.dataset.time || '';
      return;
    }

    const bioToggle = target.closest('[data-expand-bio]') as HTMLButtonElement | null;
    if (bioToggle) {
      const bio = profileBody?.querySelector('[data-profile-bio]');
      const expanded = bioToggle.getAttribute('aria-expanded') === 'true';
      bio?.classList.toggle('is-collapsed', expanded);
      bioToggle.setAttribute('aria-expanded', String(!expanded));
      bioToggle.textContent = expanded
        ? bioToggle.dataset.collapsedLabel || ''
        : bioToggle.dataset.expandedLabel || '';
      return;
    }

    const profileTrigger = target.closest('[data-profile]') as HTMLButtonElement | null;
    if (profileTrigger) openProfile(profileTrigger.dataset.profile || '', profileTrigger);
  });

  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  profileDialog?.addEventListener('click', (event) => { if (event.target === profileDialog) profileDialog.close(); });
  profileDialog?.addEventListener('close', () => {
    clearProfileRoute();
    const target = profileReturnFocus;
    profileReturnFocus = null;
    if (target?.isConnected) target.focus({ preventScroll: true });
  });
  window.addEventListener('popstate', () => {
    const registryId = profileIdFromHash();
    if (registryId) openProfile(registryId, null, false);
    else if (profileDialog?.open) profileDialog.close();
  });

  bookForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (sandboxMode) return;
    if (!bookForm.reportValidity() || !bookingTutor) return;

    const data = new FormData(bookForm);
    if (String(data.get('company') || '')) return;

    if (bookSubmit) bookSubmit.disabled = true;
    if (bookStatus) { bookStatus.hidden = true; bookStatus.removeAttribute('data-tone'); }

    try {
      const response = await fetch('/api/bookings', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tutorRegistryId: bookingTutor.registry_id,
          subject: data.get('subject'),
          preferredDay: data.get('preferredDay'),
          preferredTime: data.get('preferredTime'),
          note: data.get('note'),
        }),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok) throw new Error(result?.error || tr('That did not send.', '요청을 보내지 못했습니다.'));

      bookForm.reset();
      dialog?.querySelectorAll('.book__slot').forEach((node) => node.classList.remove('is-on'));
      if (bookStatus) {
        bookStatus.textContent = tr('Match requested. Our team will review it and connect you with the tutor.', '매칭 요청이 접수되었습니다. 담당자가 확인 후 튜터와 연결해 드립니다.');
        bookStatus.dataset.tone = 'ok';
        bookStatus.hidden = false;
      }
    } catch (error) {
      if (bookStatus) {
        bookStatus.textContent = error instanceof Error ? error.message : tr('Please try again shortly.', '잠시 후 다시 시도해 주세요.');
        bookStatus.dataset.tone = 'error';
        bookStatus.hidden = false;
      }
    } finally {
      if (bookSubmit) bookSubmit.disabled = false;
    }
  });

  // ----- Sample video ------------------------------------------------------
  const videoDialog = document.querySelector('#video-dialog') as HTMLDialogElement | null;
  const videoFrame = videoDialog?.querySelector('[data-video-frame]') as HTMLElement | null;
  const videoTitle = videoDialog?.querySelector('[data-video-title]') as HTMLElement | null;

  function openVideo(url: string, name: string) {
    if (!videoDialog || !videoFrame || !url) return;
    if (videoTitle) videoTitle.textContent = name;
    videoFrame.innerHTML = /\.(mp4|webm|ogg)$/i.test(url)
      ? `<video src="${url}" controls playsinline preload="metadata"></video>`
      : `<iframe src="${url}" title="${escapeHtml(name)}" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    if (typeof videoDialog.showModal === 'function') videoDialog.showModal();
    else videoDialog.setAttribute('open', '');
  }

  // Stop playback when the dialog closes, or audio keeps running behind it.
  videoDialog?.addEventListener('close', () => { if (videoFrame) videoFrame.innerHTML = ''; });
  videoDialog?.addEventListener('click', (event) => { if (event.target === videoDialog) videoDialog.close(); });

  document.querySelector('[data-close-book]')?.addEventListener('click', () => dialog?.close());
  document.querySelector('[data-close-profile]')?.addEventListener('click', () => profileDialog?.close());
  document.querySelector('[data-close-video]')?.addEventListener('click', () => videoDialog?.close());
</script>
