---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import T from '../components/T.astro';
import Icon from '../components/Icon.astro';
import { leadership, TUTOR_CARD_PHOTO } from '../data/people';

const ianTutor = {
  name: 'Ian Bae',
  hangul: '배이안',
  university: 'Korea University',
  universityKo: '고려대학교',
  photo: '/images/ian-bae-placeholder.png',
};

// Keep the server-rendered directory identical to the registry order. This
// prevents Ian from being the only tutor added later by the client request.
const withCats = [
  { registryId: 'P-001', entry: ianTutor, cats: ['ib'], score: '43/45', exam: { en: 'IB', ko: 'IB' } },
  { registryId: 'P-002', entry: leadership[2], cats: ['alevel'], score: 'A*A*A*A*', exam: { en: 'A Level', ko: 'A레벨' } },
  { registryId: 'P-003', entry: leadership[1], cats: ['tests'], score: '1510', exam: { en: 'SAT', ko: 'SAT' } },
];

// Counts drive the rail, so a family can see how deep each curriculum runs
// before they click anything.
const count = (key: string) => (key === 'all' ? withCats.length : withCats.filter((t) => t.cats.includes(key)).length);
const filters = [
  { key: 'all', label: 'All tutors' },
  { key: 'ib', label: 'IB Diploma' },
  { key: 'ap', label: 'Advanced Placement' },
  { key: 'alevel', label: 'A Level' },
  { key: 'igcse', label: 'IGCSE' },
  { key: 'tests', label: 'Tests & English' },
].map((f) => ({ ...f, n: count(f.key) }));

const universities = [...new Set(withCats.map(({ entry }) => entry.university))];
const roster = true;
---
<Base title="Tutors | Seonbae" active="/tutors">
  <script is:inline>
    try {
      if (new URLSearchParams(location.search).get('sandbox') === '1') {
        document.documentElement.dataset.tutorSandbox = 'loading';
      }
    } catch {}
  </script>

  <section class="sandbox-bar" id="tutor-sandbox" hidden aria-labelledby="sandbox-title">
    <div class="container sandbox-bar__inner">
      <div class="sandbox-bar__mark" aria-hidden="true">S</div>
      <div class="sandbox-bar__copy">
        <p class="sandbox-bar__eyebrow">SANDBOX · <T en="Nothing is saved" ko="저장되지 않은 미리보기" /></p>
        <h1 id="sandbox-title"><T en="Review the tutor directory before applying it." ko="실제 반영 전 튜터 명부를 확인하세요." /></h1>
        <p><span data-sandbox-file></span><span aria-hidden="true"> · </span><strong data-sandbox-count>0</strong> <T en="cards in this sandbox" ko="장의 샌드박스 카드" /></p>
        <div class="sandbox-legend" aria-label="Sandbox card status">
          <span data-state="existing"><i aria-hidden="true"></i><T en="Existing" ko="현재 카드" /><b data-sandbox-existing-count>0</b></span>
          <span data-state="new"><i aria-hidden="true"></i><T en="New draft" ko="새 카드" /><b data-sandbox-new-count>0</b></span>
          <span data-state="update"><i aria-hidden="true"></i><T en="Proposed update" ko="수정 카드" /><b data-sandbox-update-count>0</b></span>
        </div>
      </div>
      <div class="sandbox-bar__actions">
        <a href="/admin"><T en="Back to admin" ko="관리 화면으로" /></a>
        <button type="button" data-sandbox-apply disabled>
          <span><T en="Approve and apply to Supabase" ko="검토 완료 · Supabase에 반영" /></span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="m6.5 12.5 3.4 3.4 7.6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <p class="sandbox-bar__status" data-sandbox-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <PageHero
    eyebrow="Tutors"
    eyebrowKo="선배"
    copy="Meet your tutors. Every tutor is screened for university enrolment, high school results, and identity."
    copyKo="여러분의 선배들을 만나세요! 선배들은 재학 여부, 성적표, 신원까지 모두 확인된 튜터들입니다."
    bg="white"
    compact={true}
  >
    <T en="Meet your tutors." ko="여러분의 선배를 만나세요." />
  </PageHero>

  <!-- Directory layout: a standing index on the left, the roster on the right.
       Deliberately unlike the stacked sections used elsewhere on the site. -->
  <section class="section bg-white">
    <div class="container">
      <div class="roster">
        <aside class="rail reveal is-in">
          <h2 class="rail__title"><T en="Curriculum" ko="커리큘럼" /></h2>
          <div class="rail__list" role="group" aria-label="Filter tutors by curriculum">
            {filters.map((f, i) => (
              <button type="button" class="rail__btn" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="rail__label" data-filter-label={f.key}><T en={f.label} ko={f.key === 'all' ? '전체 튜터' : f.key === 'ap' ? 'AP' : f.key === 'alevel' ? 'A레벨' : f.key === 'tests' ? 'SAT·ACT·영어 시험' : f.label} /></span>
                {roster && <span class="rail__n">{f.n}</span>}
              </button>
            ))}
          </div>

          <div class="rail__note">
            <span class="rail__note-k"><T en="Every profile on this page" ko="이 페이지의 모든 프로필" /></span>
            <ul class="rail__facts">
              <li><T en="Score report read by us" ko="성적표 직접 확인" /></li>
              <li><T en="Enrolment confirmed in writing" ko="재학 증명 확인" /></li>
              <li><T en="Background check cleared" ko="신원 확인 완료" /></li>
            </ul>
            <a href="/verification" class="textlink rail__link"><T en="Our standard" ko="검증 기준" />
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </aside>

        <div class="roster__main">
          <div class="roster__bar reveal is-in">
            <p class="roster__count"><strong id="tutor-count">{roster ? withCats.length : 6}</strong> <span data-count-label><T en={roster ? 'tutors listed' : 'places in the founding cohort'} ko={roster ? '명의 튜터' : '개의 초기 모집 자리'} /></span></p>
            <p class="roster__unis">{roster ? universities.join(' · ') : 'Seoul National University · Korea University · Yonsei University'}</p>
          </div>

          <div class="tutor-grid is-loading" id="tutor-grid" aria-busy="true">
            {withCats.map(({ registryId, entry: tutor, cats, score, exam }) => (
              <div class="tutor-cell reveal is-in" data-cats={cats.join(' ')} data-registry-id={registryId}>
                <article class="tcardx card">
                  <span class="tcardx__verified"><Icon name="verify" size={15} /> <T en="Verified Tutor" ko="검증 완료" /></span>
                  <img class="tcardx__avatar" src={TUTOR_CARD_PHOTO} alt={tutor.name} width="320" height="320" loading="lazy" decoding="async" />
                  <h3 class="tcardx__name"><T en={tutor.name} ko={tutor.hangul} /><small><T en={tutor.hangul} ko={tutor.name} /></small></h3>
                  <p class="tcardx__uni"><T en={tutor.university} ko={tutor.universityKo} /></p>
                  <ul class="tcardx__scores">
                    <li><b>{score}</b><span><T en={exam.en} ko={exam.ko} /></span></li>
                  </ul>
                  <div class="tcardx__foot">
                    <button type="button" class="tcardx__book" disabled>
                      <T en="Request a match" ko="매칭 요청하기" />
                    </button>
                  </div>
                </article>
              </div>
            ))}
          </div>

          <p class="roster__note" id="roster-note" hidden><T en="Only active, verified records from the Seonbae registry appear here." ko="선배 명부에서 활성화된 검증 완료 튜터만 표시됩니다." /> <a href="/verification"><T en="See the standard" ko="검증 기준 보기" /></a></p>
          <p class="no-match" hidden><T en="No tutors in that category yet. Try another, or tell us what you need." ko="이 분류의 튜터가 아직 없습니다. 다른 분류를 보거나 필요한 내용을 알려주세요." /></p>
          <p class="sr-only" role="status" aria-live="polite" id="tutor-live"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- A flat band rather than another card, so the roster stays the page's -->
  <!-- only object of attention. -->
  <section class="section section--tight bg-cream">
    <div class="container">
      <div class="closing reveal">
        <div class="closing__say">
          <span class="eyebrow"><T en="Not sure who to pick" ko="누구를 고를지 고민되시나요?" /></span>
          <h2 class="h2"><T en="Tell us what you need, and we will find the right fit." ko="과목과 상황을 알려주시면, 저희가 매칭해 드립니다." /></h2>
          <p class="lead" style="margin-top:16px"><T en="Tell us your subject, level, goals, and availability. A person will review your request and match you with a tutor who fits." ko="과목, 수준, 목표, 가능한 시간을 알려주세요. 담당자가 직접 요청을 확인하고 잘 맞는 선배를 찾아드립니다." /></p>
        </div>
        <div class="closing__do">
          <a href="/get-matched" class="btn btn--primary btn--lg"><span><T en="Request a consultation" ko="상담 신청" /></span><span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
          <a href="/how-it-works" class="textlink"><span><T en="How matching works" ko="매칭 방식 보기" /></span></a>
        </div>
      </div>
    </div>
  </section>

  <dialog class="pf" id="profile-dialog" aria-labelledby="profile-heading">
    <div class="book__panel">
      <button type="button" class="book__close" data-close-profile aria-label="Close">×</button>
      <p class="book__eyebrow" id="profile-heading"><T en="Tutor profile" ko="튜터 프로필" /></p>
      <div data-profile-body></div>
    </div>
  </dialog>

  <dialog class="book" id="book-dialog" aria-labelledby="book-heading">
    <div class="book__panel">
      <button type="button" class="book__close" data-close-book aria-label="Close">×</button>
      <p class="book__eyebrow"><T en="Request a match" ko="매칭 요청" /></p>
      <h2 class="h3" id="book-heading"><span data-book-title></span></h2>

      <p class="book__gate" data-book-gate hidden></p>

      <h3 class="book__sub"><T en="Published hours" ko="등록된 가능 시간" /></h3>
      <div class="book__calendar" data-book-calendar></div>

      <form class="book__form" novalidate>
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-field">
          <label for="bk-subject"><T en="Subject" ko="과목" /></label>
          <input id="bk-subject" name="subject" class="form-control" type="text" required maxlength="100" data-placeholder-en="IB Economics HL" data-placeholder-ko="IB 경제 HL" />
        </div>
        <div class="form-grid">
          <div class="form-field">
            <label for="bk-day"><T en="Preferred day" ko="희망 요일" /></label>
            <select id="bk-day" name="preferredDay" class="form-control" required>
              <option value="" disabled selected data-label-en="Choose a day" data-label-ko="요일 선택">요일 선택</option>
              <option value="mon" data-label-en="Monday" data-label-ko="월요일">월요일</option>
              <option value="tue" data-label-en="Tuesday" data-label-ko="화요일">화요일</option>
              <option value="wed" data-label-en="Wednesday" data-label-ko="수요일">수요일</option>
              <option value="thu" data-label-en="Thursday" data-label-ko="목요일">목요일</option>
              <option value="fri" data-label-en="Friday" data-label-ko="금요일">금요일</option>
              <option value="sat" data-label-en="Saturday" data-label-ko="토요일">토요일</option>
              <option value="sun" data-label-en="Sunday" data-label-ko="일요일">일요일</option>
            </select>
          </div>
          <div class="form-field">
            <label for="bk-time"><T en="Preferred time" ko="희망 시각" /></label>
            <input id="bk-time" name="preferredTime" class="form-control" type="time" required step="900" />
          </div>
        </div>
        <div class="form-field">
          <label for="bk-note"><T en="Anything we should know" ko="전하고 싶은 내용" /> <span class="book__opt"><T en="optional" ko="선택" /></span></label>
          <textarea id="bk-note" name="note" class="form-control" rows="3" maxlength="1000"></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg book__submit">
          <span><T en="Send match request" ko="매칭 요청 보내기" /></span>
          <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </button>
        <p class="book__status" role="status" aria-live="polite" data-book-status hidden></p>
      </form>
    </div>
  </dialog>

  <dialog class="vid" id="video-dialog" aria-labelledby="video-heading">
    <div class="vid__panel">
      <button type="button" class="book__close" data-close-video aria-label="Close">×</button>
      <h2 class="h3 vid__title" id="video-heading"><span data-video-title></span></h2>
      <div class="vid__frame" data-video-frame></div>
    </div>
  </dialog>

</Base>

<style>
  /* The import preview is deliberately unmistakable and stays in normal flow,
     so it cannot cover the site header or any directory controls. */
  .sandbox-bar[hidden] { display: none; }
  .sandbox-bar { padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,.16); background: var(--ink); color: var(--white); }
  .sandbox-bar__inner { display: grid; grid-template-columns: 48px minmax(0,1fr) auto; gap: 14px 18px; align-items: center; }
  .sandbox-bar__mark { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.35); border-radius: 9px; background: rgba(255,255,255,.08); color: var(--yellow); font-family: var(--display); font-size: 1.25rem; font-weight: 900; }
  .sandbox-bar__eyebrow { margin: 0 0 4px; color: var(--yellow); font-size: .68rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .sandbox-bar__copy h1 { margin: 0; color: inherit; font-size: clamp(1rem,1.6vw,1.28rem); line-height: 1.25; }
  .sandbox-bar__copy>p:nth-of-type(2) { margin: 5px 0 0; color: rgba(255,255,255,.7); font-size: .78rem; }
  .sandbox-legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 9px; }
  .sandbox-legend>span { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,.8); font-size: .7rem; font-weight: 700; }
  .sandbox-legend i { width: 9px; height: 9px; flex: none; border: 2px solid currentColor; border-radius: 50%; background: currentColor; box-shadow: inset 0 0 0 2px var(--ink); }
  .sandbox-legend b { min-width: 1.35rem; padding: 2px 5px; border-radius: 4px; background: rgba(255,255,255,.1); color: #fff; font-variant-numeric: tabular-nums; text-align: center; }
  .sandbox-legend [data-state='existing'] { color: #a9d4f5; }
  .sandbox-legend [data-state='new'] { color: #aee3bc; }
  .sandbox-legend [data-state='update'] { color: #ffd38a; }
  .sandbox-bar__actions { display: flex; align-items: center; gap: 8px; }
  .sandbox-bar__actions a,.sandbox-bar__actions button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 15px; border-radius: 7px; font: inherit; font-size: .76rem; font-weight: 800; cursor: pointer; }
  .sandbox-bar__actions a { border: 1px solid rgba(255,255,255,.28); color: var(--white); }
  .sandbox-bar__actions button { min-height: 56px; gap: 12px; padding: 0 22px; border: 1px solid #2f7d4f; background: #2f7d4f; color: #fff; font-size: .82rem; box-shadow: 0 10px 24px rgba(0,0,0,.22); transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .sandbox-bar__actions button:hover:not(:disabled) { border-color: #286c45; background: #286c45; box-shadow: 0 13px 28px rgba(0,0,0,.26); transform: translateY(-1px); }
  .sandbox-bar__actions button:active:not(:disabled) { transform: translateY(0); box-shadow: 0 7px 16px rgba(0,0,0,.2); }
  .sandbox-bar__actions button svg { flex: none; }
  .sandbox-bar__actions button:disabled { cursor: wait; opacity: .6; }
  .sandbox-bar__actions a:focus-visible,.sandbox-bar__actions button:focus-visible { outline: 3px solid rgba(255,255,255,.5); outline-offset: 3px; }
  .sandbox-bar__status { grid-column: 2/-1; min-height: 1em; margin: -5px 0 0; color: rgba(255,255,255,.72); font-size: .74rem; }
  .sandbox-bar__status:empty { display: none; }
  .sandbox-bar__status[data-tone='error'] { color: #ffd0c8; }
  .sandbox-bar__status[data-tone='ok'] { color: #cfeac8; }
  :global(html[data-tutor-sandbox='loading']) #tutor-grid>* { visibility: hidden; }
  :global(html[data-tutor-sandbox]) .closing { opacity: .55; }
  :global(html[data-tutor-sandbox]) .rail__note { display: none; }

  /* ----- Directory grid --------------------------------------------------- */
  .roster {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 72px);
    align-items: start;
  }
  .rail { position: sticky; top: 104px; }
  .rail__title {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .rail__list { display: flex; flex-direction: column; }
  .rail__btn {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 13px 0;
    border: none;
    border-bottom: 1px solid var(--line-soft);
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--muted);
    transition: color 0.16s ease;
  }
  .rail__label { font-weight: 500; font-size: 0.98rem; }
  .rail__n { font-family: var(--display); font-size: 0.82rem; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
  .rail__btn:hover { color: var(--ink); }
  .rail__btn[aria-pressed='true'] { color: var(--violet); }
  .rail__btn[aria-pressed='true'] .rail__label { font-weight: 700; }
  .rail__btn[aria-pressed='true'] .rail__n { color: var(--violet); }
  /* The active row is marked on the rule itself — no pill, no fill. */
  .rail__btn[aria-pressed='true'] { border-bottom-color: var(--violet); }

  .rail__note { margin-top: 34px; padding-top: 22px; border-top: 2px solid var(--ink); }
  .rail__note-k { display: block; font-family: var(--display); font-weight: 700; font-size: 0.98rem; letter-spacing: -0.01em; }
  .rail__facts { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  .rail__facts li { position: relative; padding-left: 20px; font-size: 0.88rem; color: var(--muted); line-height: 1.45; }
  .rail__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 9px;
    height: 5px;
    border-left: 1.8px solid var(--violet);
    border-bottom: 1.8px solid var(--violet);
    transform: rotate(-45deg);
  }
  .rail__link { margin-top: 16px; font-size: 0.9rem; }

  /* ----- Roster ----------------------------------------------------------- */
  .roster__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: 16px;
    margin-bottom: clamp(18px, 2vw, 26px);
    border-bottom: 2px solid var(--ink);
  }
  .roster__count { font-size: 0.95rem; color: var(--muted); }
  .roster__count strong { font-family: var(--display); font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); margin-right: 4px; font-variant-numeric: tabular-nums; }
  .roster__unis { font-size: 0.85rem; color: var(--muted); }
  .roster__main, .tutor-grid, .tutor-cell, .live-tutor-card { min-width: 0; }
  .roster__unis { overflow-wrap: anywhere; }

  .tutor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: clamp(16px, 1.8vw, 22px); }
  .tutor-grid.is-loading { opacity: 0.72; }
  .tutor-cell.is-hidden { display: none; }
  .live-tutor-card { display: flex; flex-direction: column; min-height: 100%; overflow: hidden; border-radius: 28px; border: 1px solid rgba(22, 48, 69, .12); box-shadow: 0 14px 36px rgba(22, 48, 69, .08); transition: transform .24s ease, box-shadow .24s ease, border-color .24s ease; }
  .live-tutor-card:hover { transform: translateY(-4px); border-color: rgba(22, 48, 69, .2); box-shadow: 0 22px 48px rgba(22, 48, 69, .13); }
  .live-tutor-card__visual {
    position: relative;
    min-height: 150px;
    aspect-ratio: 5 / 3;
    padding: 14px 14px 0;
    overflow: hidden;
    background: linear-gradient(150deg, var(--sage), var(--yellow-soft));
    color: #fff;
  }
  .live-tutor-card__photo { width: 100%; height: 100%; object-fit: contain; display: grid; place-items: center; border-radius: 20px 20px 0 0; color: var(--violet); font-family: var(--display); font-size: 2.2rem; font-weight: 800; transition: transform .35s ease; }
  .live-tutor-card:hover .live-tutor-card__photo { transform: scale(1.012); }
  .live-tutor-card__verified { position: absolute; z-index: 2; top: 14px; right: 14px; padding: 6px 11px; border-radius: var(--r-pill); border: 1px solid var(--line); background: rgba(255,253,247,.94); color: var(--violet); box-shadow: var(--shadow-sm); font-size: .72rem; font-weight: 800; }
  .live-tutor-card__body { display: flex; flex: 1; flex-direction: column; padding: 24px 26px 26px; }
  .live-tutor-card__id { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .live-tutor-card__id h3 { font-size: 1.28rem; }
  .live-tutor-card__uni { margin-top: 5px; color: var(--muted); font-size: .92rem; }
  .live-tutor-card__score { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line-soft); }
  .live-tutor-card__score strong { display: block; font-family: var(--display); font-size: 2.25rem; line-height: 1; color: var(--violet); }
  .live-tutor-card__score span { display: block; margin-top: 6px; color: var(--muted); font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; }
  .live-tutor-card__action { margin-top: 22px; white-space: normal; }
  .roster__note { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--line-soft); color: var(--muted); font-size: 0.95rem; line-height: 1.55; max-width: 68ch; }
  .roster__note a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }
  .no-match { margin-top: 24px; color: var(--muted); }
  .no-match a { color: var(--violet); text-decoration: underline; }

  /* ----- Closing band ----------------------------------------------------- */
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) auto;
    gap: clamp(24px, 4vw, 56px);
    align-items: end;
    padding-top: 30px;
    border-top: 2px solid var(--ink);
  }
  .closing__do { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }

  @media (max-width: 1000px) {
    .roster { grid-template-columns: 1fr; }
    .rail { position: static; }
    .rail__list { flex-direction: row; flex-wrap: wrap; gap: 8px; }
    .rail__btn {
      width: auto;
      padding: 9px 16px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
    }
    .rail__btn[aria-pressed='true'] { border-color: var(--violet); background: var(--violet-soft); }
    .rail__note { display: none; }
  }
  @media (max-width: 820px) {
    .sandbox-bar__inner { grid-template-columns: 42px minmax(0,1fr); }
    .sandbox-bar__mark { width: 42px; height: 42px; }
    .sandbox-bar__actions,.sandbox-bar__status { grid-column: 1/-1; }
    .sandbox-bar__actions { align-items: stretch; }
    .sandbox-bar__actions a,.sandbox-bar__actions button { flex: 1; }
    .tutor-grid { grid-template-columns: 1fr; }
    .closing { grid-template-columns: 1fr; align-items: start; }
  }

  /* ----- Tutor card ------------------------------------------------------- */
  .tcardx {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: clamp(22px, 2.6vw, 30px) clamp(18px, 2.2vw, 26px) clamp(18px, 2.2vw, 24px);
    border-radius: 22px;
    border: 1px solid var(--line-soft);
    background: var(--white);
    box-shadow: 0 14px 36px rgba(22, 48, 69, .07);
    text-align: center;
    transition: transform .24s ease, box-shadow .24s ease;
  }
  .tcardx:hover { transform: translateY(-3px); box-shadow: 0 22px 48px rgba(22, 48, 69, .12); }

  .tcardx__verified {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 15px; border-radius: var(--r-pill);
    border: 1px solid var(--line); background: var(--white);
    color: var(--violet); font-size: .78rem; font-weight: 700;
    box-shadow: var(--shadow-sm);
  }
  /* Sandbox cards retain the public layout; a restrained outline and a named
     badge expose what will change without making colour carry the meaning. */
  .tutor-cell[data-preview-state='existing'] .tcardx { border-color: rgba(53,101,143,.52); box-shadow: 0 14px 36px rgba(53,101,143,.1); }
  .tutor-cell[data-preview-state='new'] .tcardx { border-color: rgba(47,125,79,.58); box-shadow: 0 14px 36px rgba(47,125,79,.11); }
  .tutor-cell[data-preview-state='update'] .tcardx { border-color: rgba(168,94,20,.58); box-shadow: 0 14px 36px rgba(168,94,20,.11); }
  .tutor-cell[data-preview-state='existing'] .tcardx__verified { border-color: #9fc2df; background: #eaf3fb; color: #24527a; }
  .tutor-cell[data-preview-state='new'] .tcardx__verified { border-color: #9fcbae; background: #e7f4eb; color: #245f3c; }
  .tutor-cell[data-preview-state='update'] .tcardx__verified { border-color: #e3bd7e; background: #fff2d6; color: #7a460d; }
  .tcardx__avatar {
    width: 118px; height: 118px; border-radius: 50%;
    object-fit: contain; background: var(--violet-soft);
    border: 5px solid var(--canvas);
  }
  .tcardx__name {
    font-family: var(--display); font-weight: 800; font-size: 1.7rem;
    letter-spacing: -.03em; line-height: 1.1; color: var(--violet);
    display: flex; align-items: baseline; justify-content: center; gap: 9px; flex-wrap: wrap;
  }
  .tcardx__name small { font-size: .95rem; font-weight: 600; color: var(--muted); letter-spacing: 0; }
  .tcardx__uni { font-size: 1.02rem; font-weight: 600; color: var(--ink); margin-top: -6px; }

  .tcardx__scores { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .tcardx__scores li {
    display: inline-flex; align-items: baseline; gap: 7px;
    padding: 7px 14px; border-radius: var(--r-pill);
    background: var(--violet-soft);
  }
  .tcardx__scores b { font-family: var(--display); font-weight: 800; font-size: .98rem; color: var(--violet); }
  .tcardx__scores span { font-size: .82rem; color: var(--muted); }
  .tcardx__scores .tcardx__more { color: var(--muted); font-size: .76rem; font-weight: 750; }

  .tcardx__bio {
    width: 100%; padding-top: 14px; border-top: 1px solid var(--line);
    color: var(--muted); font-size: .94rem; line-height: 1.6; text-align: left;
  }

  .tcardx__video {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 9px 16px; border: 1px solid var(--line); border-radius: var(--r-pill);
    background: var(--white); color: var(--ink);
    font: inherit; font-size: .88rem; font-weight: 600; cursor: pointer;
    transition: border-color .16s ease, background .16s ease;
  }
  .tcardx__video:hover { border-color: var(--violet); background: var(--violet-soft); }
  .tcardx__play {
    display: grid; place-items: center; width: 22px; height: 22px; flex: none;
    border-radius: 50%; background: var(--violet); color: #fff; font-size: .6rem; padding-left: 2px;
  }

  .tcardx__meta {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;
    width: 100%; margin: 0; padding-top: 14px; border-top: 1px solid var(--line);
  }
  .tcardx__meta div { display: grid; gap: 3px; text-align: left; }
  .tcardx__meta dt { font-size: .72rem; color: var(--muted-soft); }
  .tcardx__meta dd { margin: 0; font-size: .84rem; font-weight: 600; color: var(--ink); line-height: 1.35; }

  .tcardx__foot { width: 100%; margin-top: auto; padding-top: 16px; }
  .tcardx__book {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; min-height: 54px; padding: 0 20px;
    border: 0; border-radius: 14px;
    background: var(--violet); color: #fff;
    font: inherit; font-size: 1rem; font-weight: 700; cursor: pointer;
    transition: background .16s ease, transform .16s ease;
  }
  .tcardx__book:hover:not([disabled]) { background: var(--violet-deep); transform: translateY(-1px); }
  .tcardx__book[disabled] { opacity: .5; cursor: default; }

  /* ----- Booking dialog --------------------------------------------------- */
  .book, .vid {
    position: fixed; inset: 0; width: min(calc(100vw - 32px), 620px); max-width: none;
    max-height: min(calc(100dvh - 32px), 860px); margin: auto; padding: 0;
    border: 0; border-radius: var(--r-xl); background: transparent; color: var(--ink);
    box-shadow: var(--shadow-lift); overflow: visible;
  }
  .vid { width: min(calc(100vw - 32px), 860px); }
  .book::backdrop, .vid::backdrop { background: rgba(19, 24, 27, .56); backdrop-filter: blur(4px); }
  .book__panel, .vid__panel {
    position: relative; max-height: inherit; overflow: auto;
    padding: clamp(24px, 4vw, 40px); background: var(--white);
    border: 1px solid var(--line-soft); border-radius: inherit;
  }
  .book__close {
    position: absolute; top: 14px; right: 14px; display: grid; place-items: center;
    width: 42px; height: 42px; border: 1px solid var(--line); border-radius: 50%;
    background: var(--white); color: var(--ink); font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .book__close:hover { background: var(--ink); color: var(--white); }
  .book__eyebrow { font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--violet); font-weight: 700; }
  .book__sub { margin-top: 24px; font-family: var(--display); font-size: 1rem; font-weight: 750; }

  .book__calendar { display: grid; gap: 6px; margin-top: 12px; }
  .book__day { display: grid; grid-template-columns: 46px minmax(0, 1fr); align-items: center; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .book__dow { font-size: .82rem; font-weight: 700; color: var(--muted); }
  .book__ranges { display: flex; flex-wrap: wrap; gap: 6px; }
  .book__slot {
    padding: 7px 13px; border: 1px solid var(--line); border-radius: var(--r-pill);
    background: var(--white); color: var(--ink); font: inherit; font-size: .82rem; font-weight: 600;
    cursor: pointer; transition: border-color .14s ease, background .14s ease, color .14s ease;
  }
  .book__slot:hover { border-color: var(--violet); }
  .book__slot.is-on { background: var(--violet); border-color: var(--violet); color: #fff; }
  .book__none { color: var(--muted-soft); font-size: .82rem; }
  .book__empty { color: var(--muted); font-size: .9rem; line-height: 1.55; }

  .book__form { display: flex; flex-direction: column; gap: 14px; margin-top: 24px; }
  .book__opt { font-weight: 500; color: var(--muted-soft); }
  .book__submit { width: 100%; justify-content: space-between; margin-top: 4px; }
  .book__submit[disabled] { opacity: .65; cursor: progress; }
  .book__status { margin: 0; padding: 12px 15px; border-radius: var(--r-sm); font-size: .92rem; line-height: 1.5; }
  .book__status[data-tone='ok'] { background: var(--sage); color: var(--sage-ink); }
  .book__status[data-tone='error'] { background: #fbeeea; color: #8f302b; }

  .tcardx { cursor: pointer; }
  .tcardx:focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; }
  .tcardx__bio.is-empty, .tcardx__video.is-empty { color: var(--muted-soft); }
  .tcardx__video.is-empty { cursor: default; border-style: dashed; }
  .tcardx__video.is-empty .tcardx__play { background: var(--line); color: var(--muted-soft); }
  .tcardx__book { cursor: pointer; }

  .book__gate { margin-top: 14px; padding: 13px 16px; border-radius: var(--r-sm); background: var(--yellow-soft); color: var(--ink); font-size: .92rem; line-height: 1.55; }
  .book__gate a { font-weight: 700; color: var(--violet); }
  .book__calendar .book__slot { margin: 0; }
  .book__fixed { padding: 6px 12px; border-radius: var(--r-pill); background: var(--violet-soft); color: var(--violet); font-size: .8rem; font-weight: 600; }
  .book__form[hidden] { display: none; }

  /* Profile dialog */
  .pf { position: fixed; inset: 0; width: min(calc(100vw - 32px), 720px); max-width: none; max-height: min(calc(100dvh - 32px), 880px); margin: auto; padding: 0; border: 0; border-radius: var(--r-xl); background: transparent; color: var(--ink); box-shadow: var(--shadow-lift); }
  .pf::backdrop { background: rgba(19, 24, 27, .56); backdrop-filter: blur(4px); }
  /* The panel scrolls under a pinned footer, so the match CTA stays reachable
     however long the profile runs. */
  .pf .book__panel { display: flex; flex-direction: column; padding-bottom: 0; }

  .pf__head {
    display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 24px; align-items: center;
    margin-top: 16px; padding: 22px; border-radius: var(--r-lg); background: var(--canvas);
  }
  .pf__portrait { display: grid; justify-items: center; gap: 10px; }
  .pf__portrait img {
    width: 118px; height: 118px; border-radius: 50%; object-fit: contain;
    background: var(--violet-soft); border: 5px solid var(--white);
  }
  .pf__verified {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: var(--r-pill); border: 1px solid var(--line);
    background: var(--white); color: var(--violet); font-size: .7rem; font-weight: 700;
    white-space: nowrap;
  }
  .pf__ident { min-width: 0; }
  .pf__name {
    font-family: var(--display); font-weight: 800; font-size: clamp(1.5rem, 3.4vw, 1.95rem);
    letter-spacing: -.03em; line-height: 1.12; color: var(--violet);
  }
  .pf__uni { margin-top: 5px; font-size: 1rem; font-weight: 600; color: var(--ink); }
  .pf__ident .tcardx__scores { justify-content: flex-start; margin-top: 14px; }

  .pf__meta {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;
    margin: 18px 0 0; padding: 0;
  }
  .pf__meta div { display: grid; gap: 3px; }
  .pf__meta dt { font-size: .72rem; color: var(--muted-soft); }
  .pf__meta dd { margin: 0; font-size: .88rem; font-weight: 600; color: var(--ink); }

  /* One hairline per section instead of bare margins, matching the quiet rules
     the rest of the site separates blocks with. */
  .pf__block { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
  .pf__sub { font-family: var(--display); font-size: 1rem; font-weight: 750; color: var(--ink); }
  .pf__video { margin-top: 14px; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: #0d1418; }
  .pf__video :global(video), .pf__video :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .pf__bio { margin-top: 10px; color: var(--muted); line-height: 1.65; white-space: pre-wrap; }
  /* A tutor with no video, no bio, and no hours used to stack three dashed
     boxes and read as broken. One quiet line each says the same thing. */
  .pf__empty { margin-top: 10px; color: var(--muted-soft); font-size: .92rem; line-height: 1.55; }
  .pf__block .book__calendar { margin-top: 14px; }

  .pf__foot {
    position: sticky; bottom: 0; margin-top: 26px;
    padding: 16px 0 clamp(24px, 4vw, 40px);
    background: linear-gradient(to bottom, transparent, var(--white) 18%);
  }

  @media (max-width: 560px) {
    .pf__head { grid-template-columns: 1fr; justify-items: center; text-align: center; padding: 20px 16px; }
    .pf__ident .tcardx__scores { justify-content: center; }
    .pf__meta { grid-template-columns: 1fr; }
  }

  .vid__title { font-size: 1.2rem; padding-right: 48px; }
  .vid__frame { margin-top: 16px; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: #0d1418; }
  .vid__frame :global(video), .vid__frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }

  @media (max-width: 560px) {
    .sandbox-bar__actions { flex-direction: column; }
    .sandbox-legend { gap: 7px 10px; }
    .tcardx__meta { grid-template-columns: 1fr; }
    .book, .vid { width: calc(100vw - 20px); max-height: calc(100dvh - 20px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sandbox-bar__actions a,.sandbox-bar__actions button { transition: none; }
  }
</style>

<script>
  const PREVIEW_STORAGE_KEY = 'seonbae:tutor-import-preview:v1';
  const PREVIEW_MAX_AGE_MS = 2 * 60 * 60 * 1000;
  const sandboxMode = new URLSearchParams(location.search).get('sandbox') === '1';
  const cardPhoto = '/images/ian-bae-placeholder.png';
  const buttons = [...document.querySelectorAll('.rail__btn')] as HTMLButtonElement[];
  const noMatch = document.querySelector('.no-match') as HTMLElement | null;
  const countEl = document.getElementById('tutor-count');
  const staticFilterCounts: Record<string, number> = { all: 0, ib: 0, ap: 0, alevel: 0, igcse: 0, tests: 0 };

  type Tutor = {
    registry_id: string;
    name: string;
    name_en?: string;
    exam: string;
    score: string;
    category?: string;
    university?: string;
    university_en?: string;
    photo_url?: string | null;
    banner_url?: string | null;
    subject_scores?: Array<{ subject: string; score: string }>;
    availability?: Record<string, string[]>;
    bio?: string | null;
    bio_en?: string | null;
    video_url?: string | null;
    languages?: string | null;
    lesson_format?: string | null;
    display_order?: number;
    active?: boolean;
  };
  type PreviewState = 'existing' | 'new' | 'update';
  type PreviewPayload = {
    version: number;
    fileName: string;
    createdAt: number;
    existingRegistryIds?: string[];
    existingRows?: Array<Record<string, unknown>>;
    rows: Array<Record<string, unknown>>;
  };
  let roster: Tutor[] = [];
  let previewPayload: PreviewPayload | null = null;
  let previewStates = new Map<string, PreviewState>();
  let cells: HTMLElement[] = [...document.querySelectorAll('.tutor-cell')] as HTMLElement[];

  // Astro scopes this page's CSS with a data-astro-cid-* attribute. Cards built
  // from a template string do not carry it, so the live roster rendered unstyled
  // once the fetch replaced the server markup. Capture the attribute now, while
  // the server-rendered cards are still in the DOM, and stamp it on the ones we
  // inject.
  const scopeAttr = [...(cells[0]?.attributes ?? [])]
    .map((attribute) => attribute.name)
    .find((name) => name.startsWith('data-astro-cid-'));
  const applyScope = (root: HTMLElement) => {
    if (!scopeAttr) return;
    root.querySelectorAll<HTMLElement>('*').forEach((node) => node.setAttribute(scopeAttr, ''));
  };

  const categoriesFor = (tutor: Tutor) => {
    const value = `${tutor.exam} ${tutor.category || ''}`.toUpperCase();
    const categories = new Set<string>();
    if (/\bIB\b/.test(value)) categories.add('ib');
    if (/\bAP\b|ADVANCED PLACEMENT/.test(value)) categories.add('ap');
    if (/A[ -]?LEVEL/.test(value)) categories.add('alevel');
    if (/IGCSE|\bGCSE\b/.test(value)) categories.add('igcse');
    if (/SAT|ACT|TOEFL|IELTS|ENGLISH|영어/.test(value)) categories.add('tests');
    if (!categories.size) categories.add('tests');
    return [...categories];
  };
  const escapeHtml = (value: unknown) => String(value ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
  const safeAsset = (value: unknown) => {
    const url = String(value || '');
    return /^(\/|https:\/\/)/.test(url) ? escapeHtml(url) : '';
  };

  // YouTube and Vimeo refuse to be framed from their watch pages, which is why
  // a pasted share link showed "refused to connect". Turn any share form into
  // the player URL those sites do allow in an iframe.
  const embeddableVideo = (value: string) => {
    if (!value) return '';
    const url = value.replace(/&amp;/g, '&');
    let id = '';
    let match = url.match(/^https:\/\/(?:www\.|m\.)?youtube\.com\/watch\?(?:.*&)?v=([\w-]{6,})/);
    if (match) id = match[1];
    if (!id) {
      match = url.match(/^https:\/\/youtu\.be\/([\w-]{6,})/);
      if (match) id = match[1];
    }
    if (!id) {
      match = url.match(/^https:\/\/(?:www\.)?youtube\.com\/(?:shorts|live|embed)\/([\w-]{6,})/);
      if (match) id = match[1];
    }
    if (id) return escapeHtml(`https://www.youtube-nocookie.com/embed/${id}`);

    match = url.match(/^https:\/\/(?:www\.)?vimeo\.com\/(\d+)/);
    if (match) return escapeHtml(`https://player.vimeo.com/video/${match[1]}`);

    return escapeHtml(url);
  };
  const verifyIcon = '<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3l7 3v5c0 4.2-2.9 7.4-7 8.5-4.1-1.1-7-4.3-7-8.5V6l7-3z M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const calendarIcon = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z M4 10h16 M8 3v4 M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const language = () => document.documentElement.dataset.lang === 'en' ? 'en' : 'ko';
  const tr = (en: string, ko: string) => language() === 'en' ? en : ko;

  const filterRoster = (btn: HTMLButtonElement) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const f = btn.dataset.filter ?? 'all';
      let shown = 0;
      cells.forEach((cell) => {
        const cats = cell.dataset.cats ?? '';
        const match = f === 'all' || cats.split(' ').includes(f);
        cell.classList.toggle('is-hidden', !match);
        if (match) shown++;
      });
      if (countEl) countEl.textContent = String(shown);
      if (noMatch) noMatch.hidden = shown > 0;
      const live = document.getElementById('tutor-live');
      if (live) live.textContent = language() === 'en'
        ? `${shown} tutor${shown === 1 ? '' : 's'} listed in ${btn.querySelector('.rail__label')?.textContent ?? 'this category'}`
        : `${btn.querySelector('.rail__label')?.textContent ?? '이 분류'}에 ${shown}명의 튜터가 있습니다`;
    });
  };
  buttons.forEach(filterRoster);

  const DAYS: Array<{ key: string; en: string; ko: string }> = [
    { key: 'mon', en: 'Mon', ko: '월' },
    { key: 'tue', en: 'Tue', ko: '화' },
    { key: 'wed', en: 'Wed', ko: '수' },
    { key: 'thu', en: 'Thu', ko: '목' },
    { key: 'fri', en: 'Fri', ko: '금' },
    { key: 'sat', en: 'Sat', ko: '토' },
    { key: 'sun', en: 'Sun', ko: '일' },
  ];

  // A subject with no score yet (carried over from the application) would
  // render an empty badge, so only complete pairs reach the card.
  const scoresOf = (tutor: Tutor) => Array.isArray(tutor.subject_scores)
    ? tutor.subject_scores.filter((row) => (row?.subject || '').trim() && (row?.score || '').trim())
    : [];
  const slotsOf = (tutor: Tutor) => (tutor.availability && typeof tutor.availability === 'object') ? tutor.availability : {};
  const hasSlots = (tutor: Tutor) => DAYS.some((day) => (slotsOf(tutor)[day.key] || []).length > 0);
  const bioOf = (tutor: Tutor) => {
    const value = tr(tutor.bio_en || tutor.bio || '', tutor.bio || tutor.bio_en || '');
    return language() === 'en' && value.startsWith('전공 및 학년 · ')
      ? `Major / year · ${value.slice('전공 및 학년 · '.length)}`
      : value;
  };
  const languagesOf = (tutor: Tutor) => {
    const source = tutor.languages || '';
    const known = [
      { test: /Korean|한국어/i, en: 'Korean', ko: '한국어' },
      { test: /English|영어/i, en: 'English', ko: '영어' },
      { test: /Chinese|중국어/i, en: 'Chinese', ko: '중국어' },
      { test: /Japanese|일본어/i, en: 'Japanese', ko: '일본어' },
    ].filter((item) => item.test.test(source));
    return known.length
      ? known.map((item) => language() === 'en' ? item.en : item.ko).join(', ')
      : source || tr('Korean, English', '한국어, 영어');
  };
  const lessonFormatOf = (tutor: Tutor) => {
    const source = tutor.lesson_format || '';
    const imported = /^온라인 1:1 · 주당 (.+)시간 가능$/.exec(source);
    if (imported) return tr(`Online 1:1 · ${imported[1]} hours/week available`, source);
    return source || tr('Online 1:1', '온라인 1:1');
  };

  // Weekdays and weekends read better than a seven-day list on the card face.
  const availabilitySummary = (tutor: Tutor) => {
    const slots = slotsOf(tutor);
    const week = ['mon', 'tue', 'wed', 'thu', 'fri'].some((d) => (slots[d] || []).length > 0);
    const end = ['sat', 'sun'].some((d) => (slots[d] || []).length > 0);
    if (week && end) return tr('Weekdays & Weekends', '평일·주말');
    if (week) return tr('Weekdays', '평일');
    if (end) return tr('Weekends', '주말');
    return tr('On request', '문의');
  };

  const renderTutors = (tutors: Tutor[], states = new Map<string, PreviewState>()) => {
    const grid = document.getElementById('tutor-grid');
    if (!grid) return;
    grid.classList.remove('is-loading');
    grid.removeAttribute('aria-busy');
    grid.innerHTML = tutors.map((tutor) => {
      const displayName = tr(tutor.name_en || tutor.name, tutor.name);
      const altName = tr(tutor.name, tutor.name_en || tutor.name);
      const uni = escapeHtml(tr(tutor.university_en || tutor.university || '', tutor.university || tutor.university_en || ''));
      const bio = bioOf(tutor);
      const photo = safeAsset(tutor.photo_url) || cardPhoto;
      const previewState = sandboxMode ? states.get(tutor.registry_id) || 'new' : null;
      const previewLabel = previewState === 'existing'
        ? tr('Existing card', '현재 카드')
        : previewState === 'update'
          ? tr('Proposed update', '수정 카드')
          : tr('New draft', '새 카드');

      const scores = scoresOf(tutor);
      const scoreList = scores.length
        ? `${scores.slice(0, 3).map((row) => `<li><b>${escapeHtml(row.score)}</b><span>${escapeHtml(row.subject)}</span></li>`).join('')}${
            scores.length > 3 ? `<li class="tcardx__more">+${scores.length - 3} ${tr('more', '개 더보기')}</li>` : ''
          }`
        : `<li><b>${escapeHtml(tutor.score)}</b><span>${escapeHtml(tutor.exam)}</span></li>`;

      // Placeholders keep every card the same shape, so a card without a
      // description or a video does not look like a rendering fault.
      const bioBlock = bio
        ? `<p class="tcardx__bio">${escapeHtml(bio)}</p>`
        : `<p class="tcardx__bio is-empty">${tr('Introduction coming soon.', '소개글 준비 중입니다.')}</p>`;

      const videoBlock = safeAsset(tutor.video_url)
        ? `<button type="button" class="tcardx__video" data-video="${embeddableVideo(safeAsset(tutor.video_url))}" data-name="${escapeHtml(displayName)}">
             <span class="tcardx__play" aria-hidden="true">&#9658;</span>${tr('Watch sample lesson', '샘플 수업 보기')}
           </button>`
        : `<span class="tcardx__video is-empty"><span class="tcardx__play" aria-hidden="true">&#9658;</span>${tr('Sample lesson coming soon', '샘플 수업 준비 중')}</span>`;

      const meta = `
        <dl class="tcardx__meta">
          <div><dt>${tr('Languages', '언어')}</dt><dd>${escapeHtml(languagesOf(tutor))}</dd></div>
          <div><dt>${tr('Format', '형식')}</dt><dd>${escapeHtml(lessonFormatOf(tutor))}</dd></div>
          <div><dt>${tr('Availability', '가능 시간')}</dt><dd>${availabilitySummary(tutor)}</dd></div>
        </dl>`;

      return `<div class="tutor-cell" data-cats="${categoriesFor(tutor).join(' ')}" data-registry-id="${escapeHtml(tutor.registry_id)}"${previewState ? ` data-preview-state="${previewState}"` : ''}>
        <article class="tcardx card" data-profile="${escapeHtml(tutor.registry_id)}" tabindex="0" role="button" aria-label="${escapeHtml(displayName)} ${tr('profile', '프로필')}">
          <span class="tcardx__verified">${verifyIcon}${sandboxMode ? previewLabel : tr('Verified Tutor', '검증 완료')}</span>
          <img class="tcardx__avatar" src="${photo}" alt="${tr('Portrait of', '프로필 사진')} ${escapeHtml(displayName)}" width="320" height="320" loading="lazy" decoding="async" />
          <h3 class="tcardx__name">${escapeHtml(displayName)}<small>${escapeHtml(altName)}</small></h3>
          <p class="tcardx__uni">${uni}</p>
          <ul class="tcardx__scores">${scoreList}</ul>
          ${bioBlock}
          ${videoBlock}
          ${meta}
          <div class="tcardx__foot">
            <button type="button" class="tcardx__book" ${sandboxMode ? 'disabled aria-disabled="true"' : `data-book="${escapeHtml(tutor.registry_id)}" data-tutor-name="${escapeHtml(displayName)}"`}>
              ${calendarIcon}${sandboxMode ? tr('Preview only', '미리보기 전용') : tr('Request a match', '매칭 요청하기')}
            </button>
          </div>
        </article>
      </div>`;
    }).join('');

    applyScope(grid);
    cells = [...grid.querySelectorAll('.tutor-cell')] as HTMLElement[];
    roster = tutors;
    Object.keys(staticFilterCounts).forEach((key) => { staticFilterCounts[key] = 0; });
    staticFilterCounts.all = tutors.length;
    tutors.forEach((tutor) => {
      categoriesFor(tutor).forEach((category) => { staticFilterCounts[category] += 1; });
    });
    buttons.forEach((button) => {
      let badge = button.querySelector('.rail__n') as HTMLElement | null;
      if (!badge) {
        badge = document.createElement('span');
        badge.className = 'rail__n';
        button.append(badge);
      }
      badge.textContent = String(staticFilterCounts[button.dataset.filter || 'all'] || 0);
    });
    if (countEl) countEl.textContent = String(tutors.length);
    const countLabel = document.querySelector('.roster__count span');
    if (countLabel) countLabel.textContent = tr('tutors listed', '명의 튜터');
    const universities = [...new Set(tutors
      .map((tutor) => tr(tutor.university_en || tutor.university || '', tutor.university || tutor.university_en || ''))
      .filter(Boolean))];
    const universityLine = document.querySelector('.roster__unis');
    if (universityLine && universities.length) universityLine.textContent = universities.join(' · ');
    const note = document.getElementById('roster-note');
    if (note) note.hidden = tutors.length > 0;
    if (noMatch) noMatch.hidden = tutors.length > 0;
  };

  const normalizePreviewRow = (raw: Record<string, unknown>): Tutor | null => {
    const text = (value: unknown) => typeof value === 'string' ? value.trim() : '';
    const registryId = text(raw.registry_id);
    const name = text(raw.name);
    const exam = text(raw.exam);
    const score = text(raw.score);
    if (!registryId || !name || !exam || !score) return null;
    const scores = Array.isArray(raw.subjectScores)
      ? raw.subjectScores
      : Array.isArray(raw.subject_scores) ? raw.subject_scores : [];
    const availability = raw.availability && typeof raw.availability === 'object' && !Array.isArray(raw.availability)
      ? raw.availability as Record<string, string[]>
      : {};
    return {
      registry_id: registryId,
      name,
      name_en: text(raw.name_en),
      exam,
      score,
      category: text(raw.category),
      university: text(raw.university),
      university_en: text(raw.university_en),
      photo_url: text(raw.photo_url) || null,
      banner_url: text(raw.banner_url) || null,
      subject_scores: scores as Array<{ subject: string; score: string }>,
      availability,
      bio: text(raw.bio) || null,
      bio_en: text(raw.bioEn ?? raw.bio_en) || null,
      video_url: text(raw.videoUrl ?? raw.video_url) || null,
      languages: text(raw.languages) || null,
      lesson_format: text(raw.lessonFormat ?? raw.lesson_format) || null,
      display_order: Number.isFinite(Number(raw.display_order)) ? Number(raw.display_order) : 0,
      active: raw.active === true,
    };
  };

  const finishGridLoading = () => {
    const grid = document.getElementById('tutor-grid');
    grid?.classList.remove('is-loading');
    grid?.removeAttribute('aria-busy');
  };

  if (sandboxMode) {
    const sandbox = document.getElementById('tutor-sandbox');
    const fileName = sandbox?.querySelector('[data-sandbox-file]') as HTMLElement | null;
    const previewCount = sandbox?.querySelector('[data-sandbox-count]') as HTMLElement | null;
    const existingCountEl = sandbox?.querySelector('[data-sandbox-existing-count]') as HTMLElement | null;
    const newCountEl = sandbox?.querySelector('[data-sandbox-new-count]') as HTMLElement | null;
    const updateCountEl = sandbox?.querySelector('[data-sandbox-update-count]') as HTMLElement | null;
    const applyButton = sandbox?.querySelector('[data-sandbox-apply]') as HTMLButtonElement | null;
    const status = sandbox?.querySelector('[data-sandbox-status]') as HTMLElement | null;
    if (sandbox) sandbox.hidden = false;
    const heroCopy = document.querySelector('.phero__copy');
    const heroCopyEn = heroCopy?.querySelector('[data-l="en"]');
    const heroCopyKo = heroCopy?.querySelector('[data-l="ko"]');
    if (heroCopyEn) heroCopyEn.textContent = 'These are unpublished drafts generated from the selected spreadsheet. Verification is not complete.';
    if (heroCopyKo) heroCopyKo.textContent = '선택한 엑셀에서 만든 비공개 카드 초안입니다. 아직 검증 완료 상태가 아닙니다.';

    const showSandboxError = (message: string) => {
      const grid = document.getElementById('tutor-grid');
      if (grid) grid.innerHTML = '';
      finishGridLoading();
      if (countEl) countEl.textContent = '0';
      if (previewCount) previewCount.textContent = '0';
      if (existingCountEl) existingCountEl.textContent = '0';
      if (newCountEl) newCountEl.textContent = '0';
      if (updateCountEl) updateCountEl.textContent = '0';
      if (fileName) fileName.textContent = tr('No valid preview file', '유효한 미리보기 파일 없음');
      if (status) { status.textContent = message; status.dataset.tone = 'error'; }
      document.documentElement.dataset.tutorSandbox = 'ready';
    };

    try {
      const stored = window.sessionStorage.getItem(PREVIEW_STORAGE_KEY);
      const parsed = stored ? JSON.parse(stored) as PreviewPayload : null;
      const isFresh = parsed && Number.isFinite(parsed.createdAt) && Date.now() - parsed.createdAt <= PREVIEW_MAX_AGE_MS;
      if (!parsed || parsed.version !== 1 || !isFresh || !Array.isArray(parsed.rows) || !parsed.rows.length) {
        if (stored) window.sessionStorage.removeItem(PREVIEW_STORAGE_KEY);
        showSandboxError(tr(
          'This preview is missing or expired. Return to admin and choose the Excel file again.',
          '미리보기 정보가 없거나 만료되었습니다. 관리 화면으로 돌아가 엑셀 파일을 다시 선택해 주세요.',
        ));
      } else {
        const importedTutors = parsed.rows.map(normalizePreviewRow).filter((row): row is Tutor => Boolean(row));
        if (importedTutors.length !== parsed.rows.length || !importedTutors.length) {
          showSandboxError(tr(
            'Some card data could not be read. Return to admin and choose the file again.',
            '일부 카드 정보를 읽지 못했습니다. 관리 화면에서 파일을 다시 선택해 주세요.',
          ));
        } else {
          const existingTutors = (Array.isArray(parsed.existingRows) ? parsed.existingRows : [])
            .map(normalizePreviewRow)
            .filter((row): row is Tutor => Boolean(row));
          const knownExistingIds = new Set((parsed.existingRegistryIds || []).map(String));
          const merged = new Map(existingTutors.map((tutor) => [tutor.registry_id, tutor]));
          previewStates = new Map(existingTutors.map((tutor) => [tutor.registry_id, 'existing' as PreviewState]));
          importedTutors.forEach((tutor) => {
            previewStates.set(tutor.registry_id, merged.has(tutor.registry_id) || knownExistingIds.has(tutor.registry_id) ? 'update' : 'new');
            merged.set(tutor.registry_id, tutor);
          });
          const tutors = [...merged.values()].sort((a, b) =>
            (a.display_order || Number.MAX_SAFE_INTEGER) - (b.display_order || Number.MAX_SAFE_INTEGER)
            || a.registry_id.localeCompare(b.registry_id),
          );
          const counts = { existing: 0, new: 0, update: 0 };
          previewStates.forEach((state) => { counts[state] += 1; });
          previewPayload = parsed;
          renderTutors(tutors, previewStates);
          if (fileName) fileName.textContent = parsed.fileName || tr('Excel import', '엑셀 가져오기');
          if (previewCount) previewCount.textContent = String(tutors.length);
          if (existingCountEl) existingCountEl.textContent = String(counts.existing);
          if (newCountEl) newCountEl.textContent = String(counts.new);
          if (updateCountEl) updateCountEl.textContent = String(counts.update);
          if (applyButton) applyButton.disabled = false;
          if (status) status.textContent = tr(
            'Private application fields are excluded. Booking controls are disabled in this preview.',
            '연락처·이메일·증빙 링크는 제외되었으며, 이 화면에서는 매칭 요청도 비활성화됩니다.',
          );
          document.documentElement.dataset.tutorSandbox = 'ready';
        }
      }
    } catch {
      showSandboxError(tr(
        'The browser could not open this preview. Return to admin and try again.',
        '브라우저에서 미리보기를 열지 못했습니다. 관리 화면에서 다시 시도해 주세요.',
      ));
    }

    applyButton?.addEventListener('click', async () => {
      if (!previewPayload || !applyButton || !status) return;
      const existing = new Set((previewPayload.existingRegistryIds || []).map(String));
      const updateCount = previewPayload.rows.filter((row) => existing.has(String(row.registry_id || ''))).length;
      const createCount = previewPayload.rows.length - updateCount;
      const summary = language() === 'en'
        ? `${createCount} new card${createCount === 1 ? '' : 's'}, ${updateCount} update${updateCount === 1 ? '' : 's'}`
        : `새 카드 ${createCount}개, 기존 카드 수정 ${updateCount}개`;
      if (!window.confirm(tr(
        `Apply ${summary} to Supabase? The cards remain private unless the spreadsheet explicitly marks them active.`,
        `${summary}를 Supabase에 반영할까요? 엑셀에서 공개로 명시하지 않은 카드는 비공개로 저장됩니다.`,
      ))) return;

      applyButton.disabled = true;
      status.removeAttribute('data-tone');
      status.textContent = tr('Applying the reviewed cards…', '확인한 카드를 반영하는 중입니다…');
      try {
        const response = await fetch('/api/admin/tutors/import', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rows: previewPayload.rows }),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok) throw new Error(result?.error || tr('The cards could not be applied.', '카드를 반영하지 못했습니다.'));
        window.sessionStorage.removeItem(PREVIEW_STORAGE_KEY);
        status.dataset.tone = 'ok';
        status.textContent = tr(
          'Applied successfully. Return to admin to edit or publish the cards.',
          '반영을 마쳤습니다. 관리 화면에서 카드를 수정하거나 공개할 수 있습니다.',
        );
        applyButton.textContent = tr('Applied', '반영 완료');
      } catch (error) {
        status.dataset.tone = 'error';
        status.textContent = error instanceof Error ? error.message : tr('Please try again.', '다시 시도해 주세요.');
        applyButton.disabled = false;
      }
    });
  } else {
    fetch('/api/tutors', { cache: 'no-store', headers: { Accept: 'application/json' } })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('Tutor directory unavailable')))
      .then((rows) => {
        if (Array.isArray(rows) && rows.length > 0) renderTutors(rows);
        else finishGridLoading();
      })
      .catch(finishGridLoading);
  }
  // ----- Viewer session ----------------------------------------------------
  // Booking needs a signed-in student or parent, so the button explains itself
  // rather than failing after the form is filled in.
  let viewer: { authenticated: boolean; role?: string } = { authenticated: false };
  fetch('/api/auth/session', { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' } })
    .then((response) => response.ok ? response.json() : { authenticated: false })
    .then((data) => { viewer = data || { authenticated: false }; })
    .catch(() => {});
  const canBook = () => !sandboxMode && viewer.authenticated && (viewer.role === 'student' || viewer.role === 'parent');

  // ----- Profile dialog ----------------------------------------------------
  const profileDialog = document.querySelector('#profile-dialog') as HTMLDialogElement | null;
  const profileBody = profileDialog?.querySelector('[data-profile-body]') as HTMLElement | null;

  const openProfile = (registryId: string) => {
    const tutor = roster.find((row) => row.registry_id === registryId);
    if (!tutor || !profileDialog || !profileBody) return;

    const name = tr(tutor.name_en || tutor.name, tutor.name);
    const uni = escapeHtml(tr(tutor.university_en || tutor.university || '', tutor.university || tutor.university_en || ''));
    const bio = bioOf(tutor);
    const scores = scoresOf(tutor);
    const slots = slotsOf(tutor);
    const video = embeddableVideo(safeAsset(tutor.video_url));
    const photo = safeAsset(tutor.photo_url) || cardPhoto;

    profileBody.innerHTML = `
      <header class="pf__head">
        <div class="pf__portrait">
          <img src="${photo}" alt="" width="320" height="320" />
          <span class="pf__verified">${verifyIcon}${sandboxMode ? tr('Preview', '미리보기') : tr('Verified', '검증 완료')}</span>
        </div>
        <div class="pf__ident">
          <h2 class="pf__name" id="profile-name">${escapeHtml(name)}</h2>
          ${uni ? `<p class="pf__uni">${uni}</p>` : ''}
          <ul class="tcardx__scores">${
            scores.length
              ? scores.map((row) => `<li><b>${escapeHtml(row.score)}</b><span>${escapeHtml(row.subject)}</span></li>`).join('')
              : `<li><b>${escapeHtml(tutor.score)}</b><span>${escapeHtml(tutor.exam)}</span></li>`
          }</ul>
        </div>
      </header>

      <dl class="pf__meta">
        <div><dt>${tr('Languages', '언어')}</dt><dd>${escapeHtml(languagesOf(tutor))}</dd></div>
        <div><dt>${tr('Format', '형식')}</dt><dd>${escapeHtml(lessonFormatOf(tutor))}</dd></div>
      </dl>

      <section class="pf__block">
        <h3 class="pf__sub">${tr('Sample lesson', '샘플 수업')}</h3>
        ${video
          ? (/\.(mp4|webm|ogg)$/i.test(video)
              ? `<div class="pf__video"><video src="${video}" controls playsinline preload="metadata"></video></div>`
              : `<div class="pf__video"><iframe src="${video}" title="${escapeHtml(name)}" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>`)
          : `<p class="pf__empty">${tr('No sample lesson yet.', '아직 등록된 샘플 수업이 없습니다.')}</p>`}
      </section>

      <section class="pf__block">
        <h3 class="pf__sub">${tr('Introduction', '소개')}</h3>
        ${bio
          ? `<p class="pf__bio">${escapeHtml(bio)}</p>`
          : `<p class="pf__empty">${tr('Introduction coming soon.', '소개글 준비 중입니다.')}</p>`}
      </section>

      <section class="pf__block">
        <h3 class="pf__sub">${tr('Available hours', '가능 시간')}</h3>
        ${hasSlots(tutor)
          ? `<div class="book__calendar">${DAYS.map((day) => {
              const ranges = slots[day.key] || [];
              return `<div class="book__day"><span class="book__dow">${tr(day.en, day.ko)}</span><div class="book__ranges">${
                ranges.length ? ranges.map((range) => `<span class="book__fixed">${escapeHtml(range)}</span>`).join('') : `<span class="book__none">&mdash;</span>`
              }</div></div>`;
            }).join('')}</div>`
          : `<p class="pf__empty">${tr('Hours are arranged with you after matching.', '가능 시간은 매칭 후 협의해 정합니다.')}</p>`}
      </section>

      <div class="pf__foot">
        <button type="button" class="tcardx__book" ${sandboxMode ? 'disabled aria-disabled="true"' : `data-book="${escapeHtml(tutor.registry_id)}"`}>
          ${calendarIcon}${sandboxMode ? tr('Preview only', '미리보기 전용') : tr('Request a match', '매칭 요청하기')}
        </button>
      </div>`;

    // Injected markup carries no data-astro-cid-*, so every scoped rule in this
    // file misses it and the dialog renders as bare HTML. Stamp it like the grid.
    applyScope(profileBody);
    // Announce the tutor rather than the static "Tutor profile" eyebrow.
    profileDialog.setAttribute('aria-labelledby', 'profile-name');

    if (typeof profileDialog.showModal === 'function') profileDialog.showModal();
    else profileDialog.setAttribute('open', '');
  };

  // ----- Booking dialog ----------------------------------------------------
  const dialog = document.querySelector('#book-dialog') as HTMLDialogElement | null;
  const bookForm = dialog?.querySelector('form.book__form') as HTMLFormElement | null;
  const bookTitle = dialog?.querySelector('[data-book-title]') as HTMLElement | null;
  const bookCal = dialog?.querySelector('[data-book-calendar]') as HTMLElement | null;
  const bookDay = dialog?.querySelector('select[name="preferredDay"]') as HTMLSelectElement | null;
  const bookTime = dialog?.querySelector('input[name="preferredTime"]') as HTMLInputElement | null;
  const bookGate = dialog?.querySelector('[data-book-gate]') as HTMLElement | null;
  const bookStatus = dialog?.querySelector('[data-book-status]') as HTMLElement | null;
  const bookSubmit = dialog?.querySelector('.book__submit') as HTMLButtonElement | null;
  let bookingTutor: Tutor | null = null;

  const openBooking = (registryId: string) => {
    bookingTutor = roster.find((tutor) => tutor.registry_id === registryId) ?? null;
    if (!bookingTutor || !dialog) return;
    profileDialog?.close();

    if (bookTitle) bookTitle.textContent = tr(bookingTutor.name_en || bookingTutor.name, bookingTutor.name);
    if (bookStatus) { bookStatus.hidden = true; bookStatus.textContent = ''; }
    bookForm?.reset();

    // Signed-out visitors, and tutors or admins, see the reason instead of a
    // form they cannot submit.
    const allowed = canBook();
    if (bookGate) {
      bookGate.hidden = allowed;
      bookGate.innerHTML = allowed
        ? ''
        : viewer.authenticated
          ? tr('Only student and parent accounts can request a match.', '학생 또는 보호자 계정만 매칭을 요청할 수 있습니다.')
          : `${tr('Sign in to request a match.', '매칭을 요청하려면 로그인해 주세요.')} <a href="/login">${tr('Log in', '로그인')}</a>`;
    }
    if (bookForm) bookForm.hidden = !allowed;
    if (bookGate) applyScope(bookGate);

    // Published hours become one-tap presets; the day and time controls stay
    // editable so a visitor can always propose their own slot.
    const slots = slotsOf(bookingTutor);
    if (bookCal) {
      bookCal.innerHTML = hasSlots(bookingTutor)
        ? DAYS.map((day) => {
            const ranges = slots[day.key] || [];
            if (!ranges.length) return '';
            return ranges.map((range) => {
              const start = range.split('-')[0];
              return `<button type="button" class="book__slot" data-day="${day.key}" data-time="${escapeHtml(start)}">${tr(day.en, day.ko)} ${escapeHtml(range)}</button>`;
            }).join('');
          }).join('')
        : `<p class="book__empty">${tr('This tutor has not published hours. Choose any time below and we will arrange it.', '등록된 가능 시간이 없습니다. 아래에서 원하는 시간을 선택해 주시면 조율해 드립니다.')}</p>`;
      applyScope(bookCal);
    }

    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const bookTrigger = target.closest('[data-book]') as HTMLElement | null;
    if (bookTrigger) { event.stopPropagation(); openBooking(bookTrigger.dataset.book || ''); return; }

    const play = target.closest('[data-video]') as HTMLElement | null;
    if (play) { event.stopPropagation(); openVideo(play.dataset.video || '', play.dataset.name || ''); return; }

    const slot = target.closest('.book__slot') as HTMLElement | null;
    if (slot) {
      dialog?.querySelectorAll('.book__slot').forEach((node) => node.classList.remove('is-on'));
      slot.classList.add('is-on');
      if (bookDay) bookDay.value = slot.dataset.day || '';
      if (bookTime) bookTime.value = slot.dataset.time || '';
      return;
    }

    const card = target.closest('[data-profile]') as HTMLElement | null;
    if (card) openProfile(card.dataset.profile || '');
  });

  // Keyboard parity for the card, which is a button in all but element name.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const card = (event.target as HTMLElement).closest('[data-profile]') as HTMLElement | null;
    if (!card || card !== document.activeElement) return;
    event.preventDefault();
    openProfile(card.dataset.profile || '');
  });

  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  profileDialog?.addEventListener('click', (event) => { if (event.target === profileDialog) profileDialog.close(); });

  bookForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (sandboxMode) return;
    if (!bookForm.reportValidity() || !bookingTutor) return;

    const data = new FormData(bookForm);
    if (String(data.get('company') || '')) return;

    if (bookSubmit) bookSubmit.disabled = true;
    if (bookStatus) { bookStatus.hidden = true; bookStatus.removeAttribute('data-tone'); }

    try {
      const response = await fetch('/api/bookings', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tutorRegistryId: bookingTutor.registry_id,
          subject: data.get('subject'),
          preferredDay: data.get('preferredDay'),
          preferredTime: data.get('preferredTime'),
          note: data.get('note'),
        }),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok) throw new Error(result?.error || tr('That did not send.', '요청을 보내지 못했습니다.'));

      bookForm.reset();
      dialog?.querySelectorAll('.book__slot').forEach((node) => node.classList.remove('is-on'));
      if (bookStatus) {
        bookStatus.textContent = tr('Match requested. Our team will review it and connect you with the tutor.', '매칭 요청이 접수되었습니다. 담당자가 확인 후 튜터와 연결해 드립니다.');
        bookStatus.dataset.tone = 'ok';
        bookStatus.hidden = false;
      }
    } catch (error) {
      if (bookStatus) {
        bookStatus.textContent = error instanceof Error ? error.message : tr('Please try again shortly.', '잠시 후 다시 시도해 주세요.');
        bookStatus.dataset.tone = 'error';
        bookStatus.hidden = false;
      }
    } finally {
      if (bookSubmit) bookSubmit.disabled = false;
    }
  });

  // ----- Sample video ------------------------------------------------------
  const videoDialog = document.querySelector('#video-dialog') as HTMLDialogElement | null;
  const videoFrame = videoDialog?.querySelector('[data-video-frame]') as HTMLElement | null;
  const videoTitle = videoDialog?.querySelector('[data-video-title]') as HTMLElement | null;

  function openVideo(url: string, name: string) {
    if (!videoDialog || !videoFrame || !url) return;
    if (videoTitle) videoTitle.textContent = name;
    videoFrame.innerHTML = /\.(mp4|webm|ogg)$/i.test(url)
      ? `<video src="${url}" controls playsinline preload="metadata"></video>`
      : `<iframe src="${url}" title="${escapeHtml(name)}" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    if (typeof videoDialog.showModal === 'function') videoDialog.showModal();
    else videoDialog.setAttribute('open', '');
  }

  // Stop playback when the dialog closes, or audio keeps running behind it.
  videoDialog?.addEventListener('close', () => { if (videoFrame) videoFrame.innerHTML = ''; });
  videoDialog?.addEventListener('click', (event) => { if (event.target === videoDialog) videoDialog.close(); });

  document.querySelector('[data-close-book]')?.addEventListener('click', () => dialog?.close());
  document.querySelector('[data-close-profile]')?.addEventListener('click', () => profileDialog?.close());
  document.querySelector('[data-close-video]')?.addEventListener('click', () => videoDialog?.close());
  document.querySelectorAll('[data-set-lang]').forEach((button) => button.addEventListener('click', () => location.reload()));
</script>
