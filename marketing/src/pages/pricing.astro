---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';
import RateBrowser from '../components/RateBrowser.astro';
import Button from '../components/Button.astro';
import { won } from '../lib/format';
import { priceRange, pricePoints, rates, type CurriculumSlug } from '../data/rates';
import { examPriceRange } from '../data/exams';
import T from '../components/T.astro';
const plans = (await getCollection('plans')).sort((a, b) => a.data.order - b.data.order);

// Everything below is derived from the per-subject rate sheet, so no number on
// this page can drift away from what a family is actually quoted.
const { min: FLOOR, max: CEILING } = priceRange();
const { min: EXAM_FLOOR } = examPriceRange();
const points = pricePoints();

const curricula: { slug: CurriculumSlug; label: string }[] = [
  { slug: 'ib-diploma', label: 'IB Diploma' },
  { slug: 'advanced-placement', label: 'Advanced Placement' },
  { slug: 'a-level', label: 'A Level' },
  { slug: 'igcse', label: 'IGCSE' },
  { slug: 'standardized-tests', label: 'Tests' },
  { slug: 'english-writing', label: 'English' },
];

const included = [
  ['The lesson itself, one hour at a time', '한 번에 한 시간씩 진행하는 실제 수업'],
  ['A verified tutor chosen by hand for your subject', '과목에 맞춰 직접 고른 검증된 선배'],
  ['Written lesson notes after every session', '매 수업 뒤 작성되는 수업 노트'],
  ['A recording of the lesson to review', '복습할 수 있는 수업 녹화'],
  ['Rematch after the first lesson if the fit is wrong', '첫 수업 뒤 맞지 않을 때 재매칭'],
];
const neverCharged = [
  ['Registration or sign-up fees', '등록비·가입비'],
  ['Matching or placement fees', '매칭비·배정비'],
  ['Lesson packages bought up front', '선결제 수업 패키지'],
  ['Cancellations made 24 hours ahead', '24시간 전에 취소한 수업'],
  ['A minimum term or contract', '최소 이용 기간·장기 계약'],
];

const faqs = [
  { q: 'How does billing work?', qKo: '결제는 어떻게 하나요?', a: 'The Long Term Plan, for lessons of a month or more, is billed once per month. The Short Term Plan, for lessons under a month, is paid in one go.', aKo: '장기 과외 전용인 정기결제의 경우에는 월 단위로 이루어지는 반면, 단기 과외 위주인 비정기결제의 경우에는 일시불로 결제가 이루어집니다.' },
  { q: 'Can I cancel a lesson?', qKo: '수업을 취소할 수 있나요?', a: 'Yes. If you cancel at least 24 hours before the scheduled lesson, you can choose to reschedule the lesson, carry the credit over to the following month, or receive a refund. Cancellations made less than 24 hours in advance, as well as no-shows, are treated as completed lessons.', aKo: '네. 정규 수업 시간 24시간 전까지 취소하면 보충, 다음 달 이월, 환불 중에서 선택할 수 있습니다. 24시간 이내 취소나 결석은 수업이 진행된 것으로 간주됩니다.' },
  { q: 'What if the tutor is not the right fit?', qKo: '선배와 잘 맞지 않으면 어떻게 하나요?', a: 'Your first lesson comes with a rematch guarantee, no questions asked. If a lesson falls short because of us, we re-teach it or refund it.', aKo: '첫 수업은 이유를 묻지 않는 재매칭을 보장합니다. 저희 책임으로 수업이 기준에 못 미치면 다시 수업하거나 환불합니다.' },
  { q: 'How are tutors matched?', qKo: '선배는 어떻게 매칭하나요?', a: 'A person reviews the student’s subject, level, goals, and availability, then chooses a verified tutor who fits. You see their real results before the first lesson.', aKo: '입력한 과목, 목표, 가능한 시간을 담당자가 직접 확인해 잘 맞는 검증된 선배와 매칭합니다. 첫 수업 전에 실제 성적도 확인할 수 있습니다.' },
  { q: 'Do prices change by subject?', qKo: '과목마다 요금이 다른가요?', a: 'Yes. Each subject has its own hourly price, from ' + won(FLOOR) + ' to ' + won(CEILING) + '. The rate reflects the subject and its level of difficulty, so a rematch stays within the same subject.', aKo: `네. 난이도에 따라 과목별 시간당 요금은 ${won(FLOOR)}부터 ${won(CEILING)}까지입니다. 재매칭은 같은 과목의 선배로 진행됩니다.` },
  { q: 'Can parents track lesson progress?', qKo: '학부모도 수업 진행 상황을 확인할 수 있나요?', a: 'Yes. Parents can use the Seonbae portal to see lessons completed, homework, tutor feedback, and academic progress on a single page.', aKo: '네. 학부모님은 선배 포털에서 학생의 수업 회차, 숙제, 피드백, 성적 관련 자료를 한눈에 확인할 수 있습니다.' },
  { q: 'How do you verify tutors’ scores?', qKo: '튜터의 성적은 어떻게 검증하나요?', a: 'We check official score reports issued by the relevant exam board or testing organisation. A tutor is listed only after their results have been verified.', aKo: '튜터가 응시한 시험 주관 기관에서 발급한 공식 성적표로 성적을 검증합니다.' },
  { q: 'Do you offer trial lessons?', qKo: '시범 수업만 먼저 받아볼 수 있나요?', a: 'We do not offer a free trial lesson. Your first lesson is a regular lesson. On the Long Term Plan we do arrange a tutor rematch, so please keep that in mind.', aKo: '무료 시범 수업은 별도로 제공하지 않습니다. 첫 수업이 곷 정규 수업입니다. 대신 정기결제의 경우에는 튜터 재매칭을 진행해드리고 있으니 참고 부탁드립니다.' },
  { q: 'Do I need to prepare lesson materials?', qKo: '수업 자료는 따로 준비해야 하나요?', a: 'No. The materials will be prepared in advance by the tutor or Seonbae.', aKo: '아니요. 선배 또는 튜터가 준비한 자료로 수업을 진행합니다.' },
  { q: 'Can I get help with schoolwork as well as exam prep?', qKo: '학교 내신과 시험 준비를 함께 할 수 있나요?', a: 'Yes. We cover international school coursework as well as IB, AP, A Level, SAT, and ACT preparation. You can work on both with the same tutor.', aKo: '네. IB, AP, A레벨, SAT, ACT 같은 시험 대비뿐 아니라 국제학교 내신 과목도 함께 수업할 수 있습니다.' },
  { q: 'Can I choose my own tutor?', qKo: '원하는 선배를 직접 선택할 수 있나요?', a: 'Yes. You can browse tutor profiles and request a consultation with the tutor you are interested in.', aKo: '네. 튜터 찾기에서 원하는 선배를 선택한 뒤 상담을 신청할 수 있습니다.' },
  { q: 'What if there is a problem during a lesson?', qKo: '수업 중 문제가 생기면 누구에게 문의하면 되나요?', a: 'If anything inappropriate or any other problem comes up, contact us right away at admissions@seonbaetutor.com or through the portal.', aKo: '부적절한 언행이나 다른 문제가 발생하면 즉시 admissions@seonbaetutor.com이나 포털을 통해 문의해 주세요.' },
  { q: 'Can I pay with an overseas card?', qKo: '해외 카드나 해외 결제도 가능한가요?', a: 'Yes. We support card payments and selected digital payment methods, including eligible overseas-issued cards.', aKo: '네. 카드 결제와 일부 간편결제를 지원하며, 사용 가능한 해외 발급 카드도 결제할 수 있습니다.' },
  { q: 'Can I book short-term lessons before an exam?', qKo: '시험 직전 단기 수업도 가능한가요?', a: 'Yes. Short-term lessons are available through the Short Term Plan.', aKo: '네. 단기 수업은 비정기결제 수업을 통해 이용하실 수 있습니다.' },
];
---
<Base title="Pricing | Seonbae" active="/pricing">
  <PageHero
    eyebrow="Pricing"
    eyebrowKo="요금"
    bg="white"
    compact={true}
    copy="Every subject has its own hourly price, published in full below. Pay for the lessons ahead, nothing more, billed monthly for the hours you use."
    copyKo="모든 과목의 시간당 요금을 아래에 전부 공개합니다. 이용할 수업 시간만 매월 결제하며 그 밖의 비용은 없습니다."
    align="center"
  >
    <T en="One price per subject, published." ko="과목별 요금, 숨김없이 공개합니다." />
  </PageHero>

  <!-- The whole rate sheet, searchable. Nothing is quoted as a curriculum
       average, because families do not buy a curriculum, they buy a subject. -->
  <section class="section bg-white" style="padding-top:clamp(28px,4vw,52px)">
    <div class="container">
      <div class="rates-head reveal">
        <div>
          <Eyebrow label="Rate card" labelKo="요금표" />
          <h2 class="h2"><T en="Find your subject, see its price." ko="과목을 찾고 요금을 확인하세요." /></h2>
        </div>
        <div class="rates-head__note">
          <p class="body"><T en={`Every one of the ${rates.length} subjects we teach sits at one of ${points.length} hourly prices, from ${won(FLOOR)} to ${won(CEILING)}. Search below, or pick a curriculum.`} ko={`총 ${rates.length}개 과목은 ${won(FLOOR)}부터 ${won(CEILING)}까지 ${points.length}가지 시간당 요금 중 하나입니다. 아래에서 검색하거나 커리큘럼을 선택하세요.`} /></p>
          <ul class="pts" aria-label="The hourly price points we use">
            {points.map((p) => <li class="pt" data-krw={p}>{won(p)}</li>)}
          </ul>
        </div>
      </div>

      <div class="reveal">
        <RateBrowser curricula={curricula} showTabs={true} showCurriculumHeadings={true} id="all-rates" />
      </div>

      <aside class="mock-offer reveal">
        <div>
          <Eyebrow label="Also available" labelKo="다른 선택" />
          <h2 class="h2"><T en="Not ready for a tutor yet?" ko="아직 정기 수업은 고민되나요?" /></h2>
          <p class="lead"><T en={`Sit one of our mock exams instead. A real paper under timed conditions, marked by hand, returned with a report that tells you which marks were content and which were carelessness. From ${won(EXAM_FLOOR)}, and 20 percent less if you already study with us.`} ko={`대신 선배의 모의고사를 응시해 보세요. 실제 제한 시간에 맞춰 치른 시험을 직접 채점하고, 내용 부족과 실수로 잃은 점수를 나눈 리포트를 돌려드립니다. ${won(EXAM_FLOOR)}부터 시작하며 현재 수강생은 20% 할인됩니다.`} /></p>
        </div>
        <Button href="/mock-exams" label="See the exams" labelKo="모의고사 보기" variant="primary" size="lg" arrow="right" />
      </aside>
    </div>
  </section>

  <!-- Two ways to work with us. The billing switch sits with the plans it -->
  <!-- changes, not floating above the page. -->
  <section class="section bg-cream">
    <div class="container">
      <div class="plans-head reveal">
        <div>
          <Eyebrow label="Two ways to book" labelKo="두 가지 이용 방식" />
          <h2 class="h2"><T en="Same tutors. Same rate. Your choice of rhythm." ko="같은 선배, 같은 요금. 원하는 리듬으로." /></h2>
        </div>
        <p class="plans-head__note"><T en="Both are billed monthly, and both use the subject rate above. The only difference is whether your hours are set in advance." ko="두 방식 모두 위 과목 요금을 기준으로 매월 결제합니다. 수업 시간을 미리 정하는지만 다릅니다." /></p>
      </div>
      <div class="plans" id="pricing-plans">
        {plans.map((p) => (
          <div class="reveal"><PricingCard entry={p} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- The ledger: what the rate buys, and what it never adds. -->
  <section class="section bg-white">
    <div class="container">
      <div class="ledger reveal">
        <div class="ledger__col">
          <h2 class="ledger__h"><T en="In the hourly rate" ko="시간당 요금에 포함" /></h2>
          <ul class="ledger__list ledger__list--yes">
            {included.map((i) => <li><T en={i[0]} ko={i[1]} /></li>)}
          </ul>
        </div>
        <div class="ledger__col">
          <h2 class="ledger__h"><T en="Never charged" ko="추가로 받지 않는 비용" /></h2>
          <ul class="ledger__list ledger__list--no">
            {neverCharged.map((i) => <li><T en={i[0]} ko={i[1]} /></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="faq">
    <div class="container faq-wrap">
      <div class="faq-head reveal">
        <Eyebrow label="FAQ" labelKo="FAQ" />
        <h2 class="h2"><T en="Frequently asked questions." ko="자주 묻는 질문" /></h2>
        <p class="body" style="margin-top:14px"><T en="For anything else, write to " ko="추가로 궁금하신 부분은 " /><a href="mailto:admissions@seonbaetutor.com">admissions@seonbaetutor.com</a><T en=" and our team will be happy to help." ko="으로 문의해 주세요. 담당자가 친절히 안내해 드립니다." /></p>
      </div>
      <div class="reveal" style="margin-top:8px">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- Rate card head --------------------------------------------------- */
  .rates-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: clamp(20px, 4vw, 64px);
    align-items: end;
    padding-bottom: 26px;
    margin-bottom: clamp(22px, 3vw, 34px);
    border-bottom: 2px solid var(--ink);
  }
  .rates-head .h2 { margin-top: 12px; }
  .rates-head__note { max-width: 48ch; }
  .pts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .pt {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--violet);
    background: var(--violet-soft);
    border-radius: var(--r-sm);
    padding: 6px 11px;
    font-variant-numeric: tabular-nums;
  }
  .mock-offer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(26px, 5vw, 72px);
    align-items: end;
    margin-top: clamp(48px, 7vw, 86px);
    padding-top: clamp(34px, 5vw, 58px);
    border-top: 2px solid var(--ink);
  }
  .mock-offer .h2 { margin-top: 12px; }
  .mock-offer .lead { margin-top: 16px; max-width: 52rem; }

  /* ----- Plans ------------------------------------------------------------ */
  .plans-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    align-items: end;
    gap: 20px clamp(24px, 4vw, 56px);
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }
  .plans-head .h2 { margin-top: 12px; }
  .plans-head__note { color: var(--muted); font-size: 0.98rem; line-height: 1.55; max-width: 40ch; }
  /* Two equal cards: no featured tile stretched across an odd column split. */
  .plans { display: grid; grid-template-columns: 1fr; gap: 20px; align-items: stretch; }
  @media (min-width: 860px) {
    .plans { grid-template-columns: 1fr 1fr; }
  }

  /* ----- Ledger ----------------------------------------------------------- */
  .ledger {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 80px);
  }
  .ledger__h {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--ink);
  }
  .ledger__list li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    align-items: start;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 1rem;
    line-height: 1.5;
  }
  .ledger__list li::before {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .ledger__list--yes li::before { content: "+"; color: var(--violet); }
  .ledger__list--no li { color: var(--muted); }
  .ledger__list--no li::before { content: "×"; color: var(--muted-soft); }

  /* ----- FAQ -------------------------------------------------------------- */
  .faq-wrap { max-width: 860px; }
  .faq-head { margin-bottom: clamp(20px, 3vw, 32px); }
  .faq-head .h2 { margin-top: 12px; }
  .faq-head a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .rates-head { grid-template-columns: 1fr; align-items: start; }
    .plans-head { grid-template-columns: 1fr; align-items: start; }
    .ledger { grid-template-columns: 1fr; }
    .mock-offer { grid-template-columns: 1fr; align-items: start; }
  }
</style>
