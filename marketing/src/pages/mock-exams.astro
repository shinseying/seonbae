---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import T from '../components/T.astro';
import { localeFromPath } from '../i18n/locale';
import { won } from '../lib/format';
import { MEMBER_DISCOUNT, exams, memberPrice } from '../data/exams';

const locale = localeFromPath(Astro.url.pathname);
const minTurnaround = Math.min(...exams.map((exam) => exam.turnaround));
const maxTurnaround = Math.max(...exams.map((exam) => exam.turnaround));
const discountPercent = Math.round(MEMBER_DISCOUNT * 100);
const orderHref = '#coming-soon';

const examKo: Record<string, { unit: string; blurb: string }> = {
  'ib-math-placement': {
    unit: '진단 시험지 1회분, 60분',
    blurb: '2년간의 과정을 결정하기 전에 AA와 AI, Higher와 Standard 중 무엇이 맞는지 알려줍니다.',
  },
  sat: {
    unit: '두 영역 전체, 실제 시험 시간',
    blurb: '두 영역을 모두 다루는 전범위 선형 시험지로, 실제 점수 경계에 맞춰 채점합니다.',
  },
  'ap-calculus-bc': {
    unit: '객관식과 서술형을 포함한 시험지 1회분',
    blurb: '두 영역을 모두 다루며, 모든 서술형 풀이 단계를 실제 채점 방식에 맞춰 평가합니다.',
  },
  'ib-chemistry': {
    unit: '시험지 1회분',
    blurb: '서술형을 직접 채점하고, 풀이 과정 점수와 최종 답 점수를 따로 보여줍니다.',
  },
  'ib-physics': {
    unit: '시험지 1회분',
    blurb: '서술형을 직접 채점하고, 풀이 과정 점수와 최종 답 점수를 따로 보여줍니다.',
  },
  'ib-economics': {
    unit: '시험지 1회분',
    blurb: '실제 평가 기준에 따라 에세이를 채점하며, 명령어가 요구하는 바를 정확히 반영합니다.',
  },
  'ib-math-aa': {
    unit: '시험지 1회분',
    blurb: '풀이를 한 줄씩 채점해 어느 단계에서 점수를 잃었는지 보여줍니다.',
  },
  toefl: {
    unit: '네 영역 전체, 말하기 녹음 제출',
    blurb: '읽기, 듣기, 말하기, 쓰기를 모두 평가합니다. 말하기는 녹음으로 제출하고 공식 평가 기준에 맞춰 채점합니다.',
  },
  ielts: {
    unit: '네 영역 전체, 말하기 녹음 제출',
    blurb: '읽기, 듣기, 말하기, 쓰기를 모두 공식 평가 기준에 따라 밴드 점수로 평가합니다.',
  },
};

const steps = [
  {
    title: 'Choose your test',
    titleKo: '시험 선택하기',
    copy: 'Select the mock exam or level test you need and complete your purchase.',
    copyKo: '필요한 모의고사나 레벨 테스트를 골라 결제하세요.',
  },
  {
    title: 'Find it in your portal',
    titleKo: '포털에서 확인하기',
    copy: 'Your test is added directly to your Seonbae Portal, ready whenever you are. Everything you need is already there. Just open it when you are ready to begin.',
    copyKo: '구매한 시험은 선배 포털에 바로 등록됩니다. 준비가 되면 열어서 시작하기만 하면 됩니다.',
  },
  {
    title: 'Take it under real exam conditions',
    titleKo: '실전처럼 응시하기',
    copy: 'Answer everything directly in the portal while the timer runs. When time is up, the exam closes and submits automatically, because managing your time is part of the test too.',
    copyKo: '포털에서 타이머와 함께 답안을 작성합니다. 시간이 다 되면 자동으로 제출되며, 시간 관리도 실력의 일부입니다.',
  },
  {
    title: 'Get feedback you can use',
    titleKo: '피드백 받기',
    copy: 'Within 2–4 working days, your results are uploaded directly to your portal with detailed feedback on where you lost marks, why, and how to improve.',
    copyKo: '영업일 2~4일 안에 결과가 포털에 올라옵니다. 어디서 왜 점수를 잃었고 무엇을 고쳐야 하는지까지 짚어 드립니다.',
  },
];

const piles = [
  {
    title: 'Knowledge gaps',
    titleKo: '모르는지도 몰랐던 것',
    copy: 'The content or concept was not fully understood. We show you what was missing and what you need to revise.',
    copyKo: '대충 아는 것과 모르는 것은 시험장에서는 같습니다. 놓친 개념을 정확히 찾아 반드시 메울 수 있도록 알려드립니다.',
  },
  {
    title: 'Exam mistakes',
    titleKo: '사소한 실수',
    copy: 'The answer was reasonable, but lost marks in the way you explained it, from misreading the question to missing a step, using the wrong method, or not answering exactly what was asked.',
    copyKo: '내용은 알아도 시험 형식에 익숙하지 않아 점수를 잃을 수 있습니다. 문제를 잘못 읽거나 풀이 단계를 놓친 지점을 구체적으로 짚어드립니다.',
  },
  {
    title: 'Time management',
    titleKo: '시간 관리',
    copy: 'You understood what to do, but could not complete it effectively within the time available. Because your mock is timed through the portal, we can show where exam pressure cost you marks and what to practise next.',
    copyKo: '내용을 알아도 제한 시간 안에 답으로 표현하지 못하면 점수를 잃습니다. 포털의 응시 기록을 바탕으로 압박 속에서 막힌 지점과 필요한 연습을 알려드립니다.',
  },
];
---

<Base
  title="Mock exams | Seonbae"
  description="Full mock papers sat at home, marked by hand, and returned with a report that explains why every mark was lost."
  active="/mock-exams"
  showConversion={false}
>
  <PageHero
    eyebrow="Mock exams"
    eyebrowKo="모의고사"
    bg="cream"
    copy="Take a full mock entirely through the Seonbae Portal. Start when you are ready, sit it under real exam time limits, and receive detailed feedback within 2 to 4 working days, not only on what you got wrong, but why you lost the marks and how to improve."
    copyKo="포털에서 모의고사를 풀어보세요. 실전처럼 응시하고, 영업일 기준 2~4일 안에 무엇을 틀렸는지뿐 아니라 왜 점수를 잃었고 어떻게 개선할지 자세한 피드백을 받아보세요."
    ctaLabel="Choose a mock exam"
    ctaLabelKo="모의고사 주문하기"
    ctaHref={orderHref}
    secondaryLabel="See the report"
    secondaryLabelKo="피드백 보기"
    secondaryHref="#report"
  >
    {locale === 'en'
      ? <span>Take the exam before it <span class="mark">counts.</span></span>
      : <span class="kr"><span class="mark">실전처럼</span> 연습하세요.</span>}
  </PageHero>

  <section class="section bg-white">
    <div class="container split what-grid">
      <div class="reveal">
        <Eyebrow label="What it is" labelKo="모의고사란" />
        <h2 class="h2"><T en="A test that tells you what to do next." ko="시험을 발판 삼으세요." /></h2>
        <div class="what-copy">
          <p class="lead"><T en="Test, submit, and improve, all through your Seonbae Portal." ko="응시부터 제출, 실력 향상까지 모두 선배 포털에서." /></p>
          <p class="body"><T en={`You do not need to be taking lessons with Seonbae to use our mock exams or level tests. If you are currently learning with Seonbae Tutors, you will receive ${discountPercent}% off.`} ko={`모의고사와 레벨 테스트는 선배 수업을 듣지 않아도 이용할 수 있습니다. 선배 튜터와 수업 중이라면 ${discountPercent}% 할인이 적용됩니다.`} /></p>
        </div>
      </div>
      <dl class="facts reveal" data-delay="80ms">
        <div class="fact">
          <dt>100%</dt>
          <dd><T en="through the Seonbae Portal" ko="선배 포털에서 응시" /></dd>
        </div>
        <div class="fact">
          <dt>{minTurnaround}-{maxTurnaround} <small><T en="days" ko="일" /></small></dt>
          <dd><T en="from submission to detailed feedback" ko="제출부터 자세한 피드백까지" /></dd>
        </div>
        <div class="fact">
          <dt>500+</dt>
          <dd><T en="past and practice papers behind our exams" ko="시험 제작의 바탕이 된 기출 및 연습 문제" /></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <div class="section-head reveal">
        <Eyebrow label="How it runs" labelKo="진행 방식" />
        <h2 class="h2"><T en="Four steps, all from home." ko="집에서 끝내는 네 단계." /></h2>
        <p class="lead run-lead"><T en="From purchase to feedback, all in one place." ko="구매부터 피드백까지 한곳에서." /></p>
      </div>
      <div class="run-grid">
        {steps.map((step, index) => (
          <article class="run-card reveal" data-delay={`${index * 60}ms`}>
            <span class="run-number" aria-hidden="true">{index + 1}</span>
            <div>
              <h3><T en={step.title} ko={step.titleKo} /></h3>
              <p class="body"><T en={step.copy} ko={step.copyKo} /></p>
            </div>
          </article>
        ))}
      </div>
      <p class="delivery-note reveal"><T en="No emails to chase, files to download, or separate platforms to manage. Your exam, answers, results, and feedback all stay inside your Seonbae Portal." ko="주고받을 이메일도, 내려받을 파일도, 따로 쓸 플랫폼도 없습니다. 시험과 답안, 결과와 피드백 모두 선배 포털 안에 있습니다." /></p>
    </div>
  </section>

  <section class="section bg-white" id="report">
    <div class="container">
      <div class="report-panel reveal">
        <div class="report-intro">
          <Eyebrow label="The report" labelKo="리포트" tone="light" />
          <h2 class="h2"><T en="Every lost mark has a reason." ko="놓치는 점수가 없도록." /></h2>
          <p class="report-lead"><T en="A score tells you how you did. Understanding why you lost the marks tells you what to do next. That is why we do not just return a mark: we explain why every answer lost marks, and what to improve." ko="무엇을 모르는지 모른 채 공부하는 것은 큰 도움이 되지 않습니다. 시험으로 지식의 빈틈을 찾고, 왜 점수를 잃었는지 이해해야 다음 공부가 달라집니다. 저희 피드백은 바로 그 지점을 겨냥합니다." /></p>
          <p class="report-extra"><T en="Feedback is organised by topic and question type, so every next step is specific." ko="피드백은 단원과 문제 유형별로 구체적으로 제공됩니다." /></p>
        </div>
        <div class="pile-stack">
          {piles.map((pile, index) => (
            <article class="pile-row">
              <span class="pile-number" aria-hidden="true">{index + 1}</span>
              <div>
                <h3><T en={pile.title} ko={pile.titleKo} /></h3>
                <p><T en={pile.copy} ko={pile.copyKo} /></p>
              </div>
            </article>
          ))}
          <p class="pile-close"><T en="Most students respond to every lost mark the same way: by rereading their notes. But that only fixes the first pile. The split tells you which student you are right now, and it usually changes from exam to exam. The aim is not to make every answer perfect. It is to make it clear what to work on next." ko="틀린 문제를 다음에도 틀리지 않으려면 이유를 기록해야 합니다. 별도의 오답 노트를 만드는 대신 모의고사를 통해 연습하고, 지금 부족한 지점을 종합적으로 보완해 보세요." /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="prices">
    <div class="container">
      <div class="price-head reveal">
        <Eyebrow label="Prices" labelKo="가격표" />
        <h2 class="h2"><T en="Published, like everything else." ko="다른 모든 요금처럼 공개합니다." /></h2>
        <p class="lead"><T en={`Choose the exam you need and see exactly what is included before you purchase. Once purchased, it is added directly to your Seonbae Portal. Students currently taking weekly lessons with Seonbae receive ${discountPercent} percent off all mock exams and level tests.`} ko={`필요한 시험을 구매하고 포털에서 확인해 보세요. 이미 정기 수업을 등록한 학생은 모의고사와 레벨 테스트를 ${discountPercent}% 할인된 가격으로 응시할 수 있습니다.`} /></p>
      </div>

      <div class="exam-table-wrap reveal">
        <table class="exam-table">
          <thead>
            <tr>
              <th scope="col"><T en="Exam" ko="시험" /></th>
              <th scope="col"><T en="What you get" ko="구성" /></th>
              <th scope="col"><T en="Price" ko="가격" /></th>
              <th scope="col"><T en="Member price" ko="수강생 가격" /></th>
              <th scope="col"><T en="Order" ko="주문" /></th>
            </tr>
          </thead>
          <tbody>
            {exams.map((exam) => (
              <tr>
                <th scope="row">
                  <span class="exam-name"><T en={exam.name} ko={exam.nameKo} /></span>
                  <span class="exam-blurb"><T en={exam.blurb} ko={examKo[exam.id].blurb} /></span>
                </th>
                <td>
                  <T en={exam.unit} ko={examKo[exam.id].unit} />
                  <small><T en={`${exam.turnaround} working days`} ko={`영업일 ${exam.turnaround}일`} /></small>
                </td>
                <td class="money" data-krw={exam.price}>{won(exam.price)}</td>
                <td class="money money--member" data-krw={memberPrice(exam.price)}>{won(memberPrice(exam.price))}</td>
                <td><a class="exam-action" href={orderHref}><T en="Order" ko="주문하기" /></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="price-notes reveal">
        <li><T en="IB prices are per paper. A full IB subject is usually three papers." ko="IB 가격은 시험지 한 회분 기준입니다. IB 한 과목 전체는 보통 세 개 시험지로 구성됩니다." /></li>
        <li><T en="TOEFL and IELTS speaking is submitted as a recording rather than a live interview. It is marked against the same descriptors, but it is not a perfect substitute for the real interactive test, and we would rather say so." ko="TOEFL과 IELTS 말하기는 실시간 인터뷰 대신 녹음 파일로 제출합니다. 동일한 평가 기준으로 채점하지만 실제 상호작용 시험을 완전히 대신할 수는 없으며, 이 점을 미리 분명히 안내합니다." /></li>
        <li><T en="The IB Math placement test is a diagnostic, not a past paper. It exists to answer one question: AA or AI, Higher or Standard." ko="IB 수학 배치고사는 기출문제가 아니라 진단 시험입니다. AA와 AI, Higher와 Standard 중 무엇이 맞는지 답하기 위해 마련되었습니다." /></li>
      </ul>

      <div class="order-row reveal">
        <div>
          <h3><T en="Ready to see where you stand?" ko="내 실력을 확인해 보세요." /></h3>
          <p><T en="Choose your mock exam or level test, complete your purchase, and it will appear directly in your Seonbae Portal." ko="원하는 모의고사나 레벨 테스트를 구매하고 포털에서 응시해 보세요." /></p>
        </div>
        <Button href={orderHref} label="Choose your test" labelKo="시험 선택하기" variant="primary" size="lg" arrow="diag" />
      </div>
    </div>
  </section>

  <dialog class="coming-soon" id="coming-soon" aria-labelledby="coming-soon-title">
    <form method="dialog" class="coming-soon__panel">
      <Eyebrow label="Coming soon" labelKo="곧 만나요" />
      <h2 class="h3" id="coming-soon-title"><T en="Please wait just a little longer." ko="조금만 기다려주세요." /></h2>
      <p class="coming-soon__note"><T en="We will be back with something worth the wait." ko="좋은 제품으로 찾아뵙겠습니다." /></p>
      <button type="submit" class="coming-soon__ok"><T en="OK" ko="확인" /></button>
    </form>
  </dialog>

</Base>

<style>
  .what-grid { align-items: start; }
  .what-grid .h2,
  .section-head .h2,
  .price-head .h2,
  .what-copy { display: grid; gap: 18px; margin-top: 20px; }

  .facts { border-top: 2px solid var(--ink); }
  .fact { display: grid; grid-template-columns: minmax(130px, 0.65fr) 1fr; gap: 20px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .fact dt { font-family: var(--display); font-size: clamp(2.4rem, 5vw, 4.2rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--violet); }
  .fact dt small { font-size: 0.33em; letter-spacing: 0; }
  .fact dd { color: var(--muted); line-height: 1.45; }

  .section-head { max-width: 48rem; margin-bottom: clamp(28px, 4vw, 44px); }
  .run-lead { margin-top: 16px; }
  .run-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .run-card { display: flex; gap: 18px; padding: clamp(22px, 3vw, 30px); background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .run-number { flex: none; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--r-sm); background: var(--b2); color: var(--violet); font-family: var(--display); font-weight: 800; }
  /* One marker colour per step, drawn from the same blob palette the rest of
     the site uses. No two steps repeat. */
  .run-card:nth-child(1) .run-number { background: var(--b2); }
  .run-card:nth-child(2) .run-number { background: var(--b1); }
  .run-card:nth-child(3) .run-number { background: var(--b4); }
  .run-card:nth-child(4) .run-number { background: var(--b5); }
  .run-card h3 { font-size: 1.18rem; margin-bottom: 8px; }
  .delivery-note { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); }

  .report-panel { display: grid; grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr); gap: clamp(30px, 5vw, 72px); padding: clamp(30px, 5vw, 70px); background: var(--footer); color: var(--on-dark); border-radius: var(--r-xl); box-shadow: var(--shadow-md); }
  .report-panel .h2 { color: var(--on-dark); margin-top: 14px; }
  .report-lead { margin-top: 20px; color: var(--on-dark-soft); font-size: 1.08rem; line-height: 1.6; }
  .report-extra { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line-dark); color: var(--on-dark); line-height: 1.55; }
  .pile-stack { display: grid; gap: 12px; }
  .pile-row { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 16px; padding: clamp(20px, 2.6vw, 28px); background: rgba(255, 255, 255, 0.09); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--r-lg); }
  .pile-number { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--r-sm); background: rgba(255, 255, 255, 0.14); color: var(--yellow-soft); font-family: var(--display); font-weight: 800; }
  .pile-row h3 { color: var(--on-dark); font-size: 1.12rem; margin-bottom: 7px; }
  .pile-row p { color: var(--on-dark-soft); line-height: 1.5; }
  .pile-close { padding: clamp(22px, 3vw, 30px); background: var(--yellow-soft); color: var(--ink); border-radius: var(--r-lg); font-weight: 600; line-height: 1.55; }

  .price-head { max-width: 58rem; margin-bottom: clamp(28px, 4vw, 44px); }
  .price-head .lead { margin-top: 16px; }
  .exam-table-wrap { overflow-x: auto; border-top: 2px solid var(--ink); }
  .exam-table { width: 100%; min-width: 940px; border-collapse: collapse; table-layout: fixed; }
  .exam-table th,
