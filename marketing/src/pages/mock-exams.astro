  @media (max-width: 900px) {
    .report-panel,
    .report-extra { max-width: 46rem; }
  }
  @media (max-width: 700px) {
    .run-grid { grid-template-columns: 1fr; }
    .order-row { align-items: flex-start; flex-direction: column; }
    .fact { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (max-width: 520px) {
    .report-panel { margin-inline: calc(var(--gutter) * -0.35); }
    .pile-row { grid-template-columns: 36px minmax(0, 1fr); gap: 12px; }
    .coming-soon { width: calc(100vw - 24px); max-height: calc(100dvh - 24px); }
    .coming-soon__panel { padding: 30px 24px; }
  }
</style>

<script>
  const comingSoon = document.querySelector<HTMLDialogElement>('#coming-soon');
  let comingSoonTrigger: HTMLElement | null = null;

  document.querySelectorAll<HTMLAnchorElement>('a[href="#coming-soon"]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      comingSoonTrigger = trigger;
      if (!comingSoon) return;
      if (typeof comingSoon.showModal === 'function') comingSoon.showModal();
      else comingSoon.setAttribute('open', '');
    });
  });

  comingSoon?.addEventListener('click', (event) => {
    if (event.target === comingSoon) comingSoon.close();
  });

  comingSoon?.addEventListener('close', () => {
    comingSoonTrigger?.focus();
  });
</script>
