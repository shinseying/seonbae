  .exam-blurb { display: block; margin-top: 7px; color: var(--muted); font-weight: 400; font-size: 0.88rem; line-height: 1.45; }
  .exam-table td { color: var(--muted); font-size: 0.94rem; line-height: 1.45; }
  .exam-table td small { display: block; margin-top: 7px; color: var(--muted-soft); }
  .exam-table .money { color: var(--ink); font-family: var(--display); font-weight: 750; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .exam-table .money--member { color: var(--violet); }
  .exam-action { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 16px; border: 1px solid var(--ink); border-radius: var(--r-sm); color: var(--ink); font-weight: 700; white-space: nowrap; transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease; }
  .exam-action:hover { background: var(--ink); color: var(--white); }
  .exam-action:active { transform: translateY(1px); }
  .price-notes { display: grid; gap: 0; margin-top: 30px; }
  .price-notes li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.94rem; line-height: 1.55; }
  .order-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 36px; padding-top: 30px; border-top: 2px solid var(--ink); }
