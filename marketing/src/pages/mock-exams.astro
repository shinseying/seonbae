  .coming-soon__panel .h3 { max-width: 14ch; margin-top: 20px; font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; line-height: 1.16; color: var(--ink); }
  .coming-soon__note { margin-top: 18px; color: var(--muted); font-size: 1.02rem; line-height: 1.5; }
  .coming-soon__ok {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    min-width: 92px;
    padding: 17px 30px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--violet);
    color: #fff;
