  .coming-soon {
    position: fixed;
    inset: 0;
    width: min(calc(100vw - 32px), 680px);
    max-width: none;
    max-height: min(calc(100dvh - 32px), 760px);
    margin: auto;
    padding: 0;
    overflow: auto;
