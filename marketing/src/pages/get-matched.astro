---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { localeFromPath, localePath } from '../i18n/locale';
import { groupedRatesFor, rates, type CurriculumSlug } from '../data/rates';
import { won } from '../lib/format';

const locale = localeFromPath(Astro.url.pathname);
const link = (href: string) => localePath(href, locale);
const isEnglish = locale === 'en';

// Consultations run every evening between 17:00 and 20:00 KST.
const slots = ['17:00', '17:30', '18:00', '18:30', '19:00', '19:30', '20:00'];
const curricula: { value: CurriculumSlug | 'unsure'; en: string; ko: string }[] = [
  { value: 'ib-diploma', en: 'IB Diploma', ko: 'IB 디플로마' },
  { value: 'advanced-placement', en: 'Advanced Placement', ko: 'AP' },
  { value: 'a-level', en: 'A Level', ko: 'A레벨' },
  { value: 'igcse', en: 'IGCSE', ko: 'IGCSE' },
  { value: 'standardized-tests', en: 'Tests', ko: 'SAT·ACT·공인영어' },
  { value: 'english-writing', en: 'English', ko: '영어' },
  { value: 'unsure', en: 'Not sure yet', ko: '아직 잘 모르겠어요' },
];
const curriculumLabel = Object.fromEntries(curricula.map((item) => [item.value, isEnglish ? item.en : item.ko]));
const prefs = [
  { v: 'weekly', en: 'Weekly momentum', ko: '매주 꾸준히', den: 'A standing slot with one tutor', dko: '한 튜터와 정해진 시간에 수업' },
  { v: 'hourly', en: 'By the hour', ko: '필요할 때 한 시간씩', den: 'Occasional, when I need it', dko: '필요한 때만 수업' },
  { v: 'unsure', en: 'Not sure yet', ko: '아직 잘 모르겠어요', den: 'Help me decide', dko: '상담하며 결정할게요' },
];
const stepLabels = [
  { en: 'Student', ko: '학생' },
  { en: 'Subject', ko: '과목' },
  { en: 'Tutor & time', ko: '튜터·일정' },
  { en: 'Contact', ko: '연락처' },
];
---
<Base active="/get-matched" showConversion={false} heroDark={false}>
  <section class="match-section">
    <div class="container">
      <div class="match-wrap">
        <header class="match-head reveal is-in">
          <span class="eyebrow"><T en="Consultation" ko="상담 신청" /></span>
          <h1 class="display match-title"><T en="Let's find the tutor who fits." ko="학생에게 꼭 맞는 선배를 찾아볼게요." /></h1>
          <p class="lead" style="margin-top:14px"><T en="Four short steps, and a real person reads every answer." ko="네 단계면 충분합니다. 선배 팀이 모든 답변을 직접 확인합니다." /></p>
        </header>

        <div class="match-card reveal is-in">
          <div class="progress" id="progress" aria-hidden="true">
            {stepLabels.map((l, i) => (
              <div class={`progress-seg ${i === 0 ? 'is-active' : ''}`} data-seg={i + 1}>
                <span class="progress-dot">{i + 1}</span>
                <span class="progress-label"><T en={l.en} ko={l.ko} /></span>
              </div>
            ))}
          </div>

          <form id="match-form" novalidate>
            <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="match-context" data-match-context hidden>
              <span><T en="Requesting" ko="희망 튜터" /> <strong data-context-name></strong></span>
              <button type="button" data-clear-tutor><T en="Clear" ko="선택 해제" /></button>
            </div>
            <p class="sr-only" role="status" aria-live="polite" data-step-live></p>
            <!-- Step 1 -->
            <fieldset class="step is-current" data-step="1">
              <legend class="step-legend"><T en="Who are the lessons for?" ko="누구를 위한 수업인가요?" /></legend>
              <div class="form-field">
                <label for="m-student"><T en="Student name" ko="학생 이름" /> <span class="req">*</span></label>
                <input class="form-control" id="m-student" name="student" type="text" required placeholder={isEnglish ? 'First name is fine' : '이름만 적어도 괜찮아요'} />
              </div>
              <div class="form-field" style="margin-top:18px">
                <span class="field-label"><T en="Curriculum" ko="커리큘럼" /></span>
                <div class="choice-grid">
                  {curricula.map((l) => (
                    <label class="choice"><input type="radio" name="level" value={l.value} checked={l.value === 'unsure'} /><span><T en={l.en} ko={l.ko} /></span></label>
                  ))}
                </div>
              </div>
            </fieldset>

            <!-- Step 2 -->
            <fieldset class="step" data-step="2" hidden>
              <legend class="step-legend"><T en="What would you like to study?" ko="어떤 과목을 배우고 싶나요?" /></legend>
              <div class="form-field subject-field">
                <label for="m-subject-search"><T en="Subject" ko="과목" /> <span class="req">*</span></label>
                <input type="hidden" name="subject" data-subject-value />
                <input type="hidden" name="subjectSlug" data-subject-slug />
                <input type="hidden" name="curriculum" data-curriculum-value />
                <div class="subject-combobox" data-subject-combobox>
                  <input class="form-control subject-combobox__input" id="m-subject-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="m-subject-options" required autocomplete="off" placeholder={isEnglish ? 'Type a subject, e.g. IB Physics HL' : '과목을 검색하세요. 예: IB 물리 HL'} data-subject-search />
                  <div class="subject-combobox__menu" id="m-subject-options" role="listbox" hidden data-subject-menu>
                    <button type="button" class="subject-option subject-option--unsure" role="option" data-subject-option data-slug="not-sure" data-name="Not sure yet" data-name-ko="아직 잘 모르겠어요" data-curriculum="" data-price="" data-search="not sure unsure 아직 모름 모르겠어요">
                      <strong><T en="Not sure yet" ko="아직 잘 모르겠어요" /></strong><small><T en="We will help you choose during the consultation" ko="상담하면서 함께 정해 드릴게요" /></small>
                    </button>
                    {curricula.filter((item) => item.value !== 'unsure').map((curriculum) => (
                      <section class="subject-group" data-subject-group>
                        <h3>{curriculumLabel[curriculum.value]}</h3>
                        {groupedRatesFor(curriculum.value as CurriculumSlug).map((group) => group.items.map((rate) => (
                          <button type="button" class="subject-option" role="option" data-subject-option data-slug={rate.slug} data-name={rate.name} data-name-ko={rate.nameKo ?? rate.name} data-curriculum={rate.curriculum} data-price={rate.price} data-search={`${rate.name} ${rate.nameKo ?? ''} ${rate.aliases.join(' ')}`.toLowerCase()}>
                            <strong><T en={rate.name} ko={rate.nameKo ?? rate.name} /></strong><small>{won(rate.price)} <T en="/ hr" ko="/ 시간" /></small>
                          </button>
                        )))}
                      </section>
                    ))}
                    <p class="subject-combobox__empty" data-subject-empty hidden><T en="No matching subject. Choose “Not sure yet” and we will help." ko="일치하는 과목이 없습니다. ‘아직 잘 모르겠어요’를 선택하시면 상담에서 도와드릴게요." /></p>
                  </div>
                </div>
                <p class="subject-confirm" data-subject-confirm hidden><span data-subject-confirm-name></span><strong data-subject-confirm-price></strong></p>
              </div>
              <div class="form-field" style="margin-top:18px">
                <label for="m-goal"><T en="Learning goal" ko="학습 목표" /> <span class="req">*</span></label>
                <textarea class="form-control" id="m-goal" name="goal" rows="3" required maxlength="1000" placeholder={isEnglish ? 'What result are you aiming for, and by when?' : '어떤 목표를 언제까지 이루고 싶은지 알려주세요.'}></textarea>
                <p class="field-hint"><T en="A target score, a deadline, or something that has felt difficult." ko="목표 점수, 일정, 지금 어렵게 느끼는 부분을 적어 주세요." /></p>
              </div>
              <div class="form-field" style="margin-top:20px">
                <span class="field-label"><T en="How would you like to work?" ko="어떤 방식으로 수업할까요?" /></span>
                <div class="choice-grid choice-grid--3">
                  {prefs.map((p, i) => (
                    <label class="choice choice--rich"><input type="radio" name="preference" value={p.v} checked={i === 0} /><span><strong><T en={p.en} ko={p.ko} /></strong><em><T en={p.den} ko={p.dko} /></em></span></label>
                  ))}
                </div>
              </div>
            </fieldset>

            <!-- Step 3 -->
            <fieldset class="step" data-step="3" hidden>
              <legend class="step-legend"><T en="Who and when works best?" ko="어떤 선배와 언제 상담할까요?" /></legend>
              <div class="form-field tutor-picker-field">
                <label for="m-tutor-search"><T en="Preferred tutor" ko="희망 튜터" /></label>
                <div class="tutor-picker" data-tutor-picker>
                  <input type="hidden" name="preferredTutor" value="Manager consultation" data-tutor-value />
                  <button type="button" class="form-control tutor-picker__trigger" id="m-tutor-search" aria-expanded="false" aria-controls="m-tutor-options">
                    <span data-tutor-label>{isEnglish ? 'Consult with the team' : '매니저와 상담'}</span>
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <div class="tutor-picker__menu" id="m-tutor-options" hidden>
                    <input class="form-control tutor-picker__search" type="search" placeholder={isEnglish ? 'Search by name, university, or curriculum' : '이름, 대학 또는 커리큘럼으로 검색'} aria-label={isEnglish ? 'Search tutors' : '튜터 검색'} data-tutor-search />
                    <div class="tutor-picker__options" role="listbox" data-tutor-options>
                      <button type="button" class="tutor-option is-selected" role="option" aria-selected="true" data-value="Manager consultation" data-search="manager consultation team 매니저 상담">
                        <span class="tutor-option__avatar">S</span>
                        <span><strong><T en="Consult with the team" ko="매니저와 상담" /></strong><small><T en="We will recommend the right fit" ko="학생에게 맞는 튜터를 추천해 드립니다" /></small></span>
                      </button>
                    </div>
                    <p class="tutor-picker__empty" data-tutor-empty hidden><T en="No matching tutors in this curriculum." ko="이 커리큘럼에 맞는 튜터가 아직 없습니다." /></p>
                  </div>
                </div>
                <p class="field-hint"><T en="The list updates to tutors matching the curriculum selected above." ko="위에서 선택한 커리큘럼에 맞는 튜터만 표시됩니다." /></p>
              </div>
              <div class="form-field">
                <span class="field-label"><T en="Date and time that suit you" ko="상담 가능한 날짜와 시간" /></span>
                <input class="form-control slot-date" id="m-date" name="preferredDate" type="date" aria-label="상담 희망 날짜" />
                <p class="timezone-note" data-timezone-note hidden></p>
                <div class="slot-grid">
                  {slots.map((slot) => (
                    <label class="slot"><input type="checkbox" name="times" value={slot} /><span><b>{slot} KST</b><small data-local-time data-slot={slot}></small></span></label>
                  ))}
                </div>
                <p class="field-hint"><T en="Consultations run every evening between 17:00 and 20:00 KST. Choose every slot that works." ko="상담은 매일 저녁 17:00–20:00(한국 시간)에 진행됩니다. 가능한 시간을 모두 골라 주세요." /></p>
                <p class="field-hint" data-clock></p>
              </div>
            </fieldset>

            <!-- Step 4 -->
            <fieldset class="step" data-step="4" hidden>
              <legend class="step-legend"><T en="Where should we reach you?" ko="어디로 연락드릴까요?" /></legend>
              <div class="form-field">
                <label for="m-email"><T en="Email" ko="이메일" /> <span class="req">*</span></label>
                <input class="form-control" id="m-email" name="email" type="email" required placeholder="you@email.com" autocomplete="email" />
              </div>
              <div class="form-field" style="margin-top:18px">
                <label for="m-note"><T en="Anything else we should know?" ko="추가로 알려주실 내용이 있나요?" /></label>
                <textarea class="form-control" id="m-note" name="note" placeholder={isEnglish ? 'A deadline, a past struggle, or a tutor style that has worked before' : '시험 일정, 어려웠던 점, 잘 맞았던 수업 방식'}></textarea>
              </div>
            </fieldset>

            <div class="match-nav">
              <button type="button" class="btn btn--secondary" id="btn-back" hidden>
                <span class="btn__disc" aria-hidden="true" style="order:-1"><svg viewBox="0 0 20 20" fill="none"><path d="M16 10H5M9 6l-4 4 4 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span><T en="Back" ko="이전" /></span>
              </button>
              <button type="button" class="btn btn--primary btn--lg" id="btn-next">
                <span data-next-label data-en="Continue" data-ko="계속하기">계속하기</span>
                <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </button>
            </div>
          </form>

          <div class="match-done" id="match-done" role="status" hidden>
            <span class="done-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="30" height="30"><path d="M5 12.5l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <h2 class="h3"><T en="Thank you. We are on it." ko="감사합니다. 바로 확인할게요." /></h2>
            <p class="body" id="match-done-note" data-default-en="A real person will read your answers and reply within one business day with a verified tutor who fits, plus a couple of times to book a first lesson. That first lesson comes with a rematch guarantee." data-default-ko="선배 팀이 답변을 직접 확인한 뒤 영업일 기준 하루 안에 잘 맞는 검증된 튜터와 첫 수업 가능한 시간을 안내해 드립니다. 첫 수업 후 맞지 않으면 다시 매칭해 드립니다." style="margin-top:12px; max-width:46ch; margin-inline:auto"></p>
            <div class="cta-row" style="justify-content:center; margin-top:24px">
              <a href={link('/how-it-works')} class="btn btn--secondary"><span><T en="See what happens next" ko="다음 과정 보기" /></span><span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .match-section { background: var(--canvas); padding-block: clamp(40px, 6vw, 88px); min-height: 70vh; }
  .match-wrap { max-width: 720px; margin-inline: auto; }
  .match-head { text-align: center; margin-bottom: 30px; }
  .match-head .eyebrow { justify-content: center; }
  .match-title { font-size: clamp(2.2rem, 4.4vw, 3.4rem); margin-top: 14px; }

  .match-card { background: var(--white); border: 1px solid var(--line-soft); border-radius: var(--r-xl); padding: clamp(24px, 3.5vw, 44px); box-shadow: var(--shadow-md); }

  .match-context {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin: -6px 0 24px; padding: 10px 12px; border: 1px solid color-mix(in srgb, var(--violet) 28%, transparent);
    border-radius: var(--r-sm); background: var(--violet-soft); color: var(--ink); font-size: .9rem;
  }
  .match-context[hidden] { display: none; }
  .match-context button { border: 0; background: none; color: var(--violet); font: inherit; font-weight: 750; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .match-context button:focus-visible { outline: 3px solid var(--mint); outline-offset: 2px; }

  .progress { display: flex; gap: 6px; margin-bottom: 30px; }
  .progress-seg { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; opacity: 0.5; transition: opacity 0.2s ease; }
  .progress-seg::before { content: ""; position: absolute; top: 15px; left: -50%; width: 100%; height: 2px; background: var(--line); z-index: 0; }
  .progress-seg:first-child::before { display: none; }
  .progress-seg.is-active, .progress-seg.is-done { opacity: 1; }
  .progress-dot {
    position: relative; z-index: 1;
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--violet-soft); color: var(--violet);
    font-family: var(--display); font-weight: 700; font-size: 0.92rem;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .progress-seg.is-active .progress-dot, .progress-seg.is-done .progress-dot { background: var(--violet); color: #fff; }
  .progress-label { font-size: 0.78rem; font-weight: 600; color: var(--muted); }

  .step-legend { font-family: var(--display); font-weight: 700; font-size: clamp(1.3rem, 2.4vw, 1.7rem); letter-spacing: -0.02em; margin-bottom: 22px; padding: 0; }
  .step { border: none; padding: 0; margin: 0; animation: stepIn 0.28s ease; }
  @keyframes stepIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .field-label { display: block; font-size: 0.86rem; font-weight: 600; color: var(--ink); margin-bottom: 10px; }

  .choice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .choice-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .choice--rich span { display: flex; flex-direction: column; gap: 3px; padding: 14px 16px; }
  .choice--rich strong { font-weight: 700; }
  .choice--rich em { font-style: normal; font-size: 0.82rem; color: var(--muted); }
  .choice--rich input:checked + span em { color: var(--violet); }

  .subject-combobox { position: relative; }
  .subject-combobox__menu {
    position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 30;
    max-height: 340px; overflow-y: auto; padding: 10px; border: 1px solid var(--line);
    border-radius: var(--r-md); background: var(--white); box-shadow: var(--shadow-md);
  }
  .subject-group + .subject-group { margin-top: 10px; }
  .subject-group h3 { position: sticky; top: -10px; z-index: 1; margin: 0 -2px 4px; padding: 8px 10px 5px; background: var(--white); color: var(--muted); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .subject-option {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    width: 100%; min-height: 48px; padding: 9px 10px; border: 0; border-radius: 7px;
    background: transparent; color: var(--ink); text-align: left; cursor: pointer;
  }
  .subject-option:hover, .subject-option:focus-visible, .subject-option.is-active { background: var(--violet-soft); outline: none; }
  .subject-option strong { font-size: .9rem; font-weight: 650; }
  .subject-option small { flex: none; color: var(--violet); font-size: .76rem; font-weight: 700; }
  .subject-option--unsure { border-bottom: 1px solid var(--line); border-radius: 0; margin-bottom: 8px; }
  .subject-option--unsure > * { display: block; }
  .subject-combobox__empty { padding: 14px 10px; color: var(--muted); font-size: .86rem; }
  .subject-confirm { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; padding: 10px 12px; border-radius: var(--r-sm); background: var(--mint-surface); font-size: .86rem; }
  .subject-confirm[hidden] { display: none; }
  .subject-confirm strong { color: var(--violet); white-space: nowrap; }

  .tutor-picker-field { margin-bottom: 20px; }
  .tutor-picker { position: relative; }
  .tutor-picker__trigger { display: flex; align-items: center; justify-content: space-between; text-align: left; cursor: pointer; }
  .tutor-picker__trigger svg { width: 18px; height: 18px; flex: none; transition: transform 0.18s ease; }
  .tutor-picker__trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .tutor-picker__menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 20;
    padding: 10px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
  }
  .tutor-picker__search { margin-bottom: 8px; }
  .tutor-picker__options { max-height: 280px; overflow-y: auto; display: grid; gap: 4px; }
  .tutor-option {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: center;
    width: 100%;
    min-height: 64px;
    padding: 9px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }
  .tutor-option:hover, .tutor-option.is-selected { background: var(--violet-soft); }
  .tutor-option__avatar { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--mint-surface); color: var(--violet); font-weight: 800; overflow: hidden; }
  .tutor-option__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .tutor-option strong, .tutor-option small { display: block; }
  .tutor-option strong { font-size: 0.94rem; color: var(--ink); }
  .tutor-option small { margin-top: 2px; color: var(--muted); font-size: 0.78rem; }
  .tutor-picker__empty { padding: 12px; color: var(--muted); font-size: 0.86rem; }

  .match-nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 30px; }
  .match-nav #btn-back[hidden] { display: none; }
  .match-nav #btn-next { margin-left: auto; }

