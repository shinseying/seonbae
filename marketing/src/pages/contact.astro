---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import T from '../components/T.astro';
import { localeFromPath, localePath } from '../i18n/locale';

const locale = localeFromPath(Astro.url.pathname);
const link = (href: string) => localePath(href, locale);
const isEnglish = locale === 'en';

const subjects = [
  ['IB Diploma', 'IB 디플로마'], ['Advanced Placement', 'AP'], ['A Level', 'A레벨'],
  ['IGCSE', 'IGCSE'], ['Standardized Tests', '표준화 시험'], ['English and Writing', '영어·글쓰기'], ['Not sure yet', '아직 잘 모르겠어요'],
];
const levels = [['Lower secondary', '중등 과정'], ['IGCSE', 'IGCSE'], ['IB or A Level', 'IB 또는 A레벨'], ['University prep', '대학 입시 준비'], ['Adult learner', '성인 학습자']];
---
<Base active="/contact" showConversion={false}>
  <PageHero
    eyebrow="Contact"
    eyebrowKo="문의"
    bg="cream"
    compact={true}
    copy="The more you tell us, the better the match. Share what you are working toward and we will reply within one business day."
    copyKo="상황을 자세히 알려주실수록 더 잘 맞는 선배를 찾을 수 있습니다. 목표를 남겨주시면 영업일 기준 하루 안에 답변드리겠습니다."
    contour={true}
  >
    <T en="Tell us what you would like help with." ko="어떤 도움이 필요한지 알려주세요." />
  </PageHero>

  <section class="section bg-white" style="padding-top:clamp(20px,3vw,40px)">
    <div class="container contact-layout">
      <form class="contact-form" id="contact-form" novalidate>
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-grid">
          <div class="form-field">
            <label for="student"><T en="Student name" ko="학생 이름" /> <span class="req">*</span></label>
            <input class="form-control" id="student" name="student" type="text" required placeholder={isEnglish ? 'Who are the lessons for?' : '수업을 받을 학생 이름'} />
          </div>
          <div class="form-field">
            <label for="email"><T en="Parent or learner email" ko="학부모 또는 학생 이메일" /> <span class="req">*</span></label>
            <input class="form-control" id="email" name="email" type="email" required placeholder="you@email.com" autocomplete="email" />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <label for="level"><T en="Grade or level" ko="학년·과정" /></label>
            <select class="form-control" id="level" name="level">
              <option value="" selected>{isEnglish ? 'Select a level' : '과정을 선택하세요'}</option>
              {levels.map((l) => <option value={l[0]}>{isEnglish ? l[0] : l[1]}</option>)}
            </select>
          </div>
          <div class="form-field">
            <label for="subject"><T en="Subject" ko="과목" /></label>
            <select class="form-control" id="subject" name="subject">
              <option value="" selected>{isEnglish ? 'Select a subject' : '과목을 선택하세요'}</option>
              {subjects.map((s) => <option value={s[0]}>{isEnglish ? s[0] : s[1]}</option>)}
            </select>
          </div>
        </div>

        <div class="form-field">
          <label for="goal"><T en="What is the goal?" ko="학습 목표" /></label>
          <input class="form-control" id="goal" name="goal" type="text" placeholder={isEnglish ? 'A grade, a test score, or steadier confidence' : '목표 등급, 시험 점수 또는 자신감 회복'} />
        </div>

        <div class="form-field">
          <label for="times"><T en="Preferred times" ko="희망 시간" /></label>
          <input class="form-control" id="times" name="times" type="text" placeholder={isEnglish ? 'Which evenings or weekends suit you, and your time zone' : '가능한 평일 저녁이나 주말, 거주 지역의 시간대'} />
        </div>

        <div class="form-field">
          <label for="context"><T en="Anything else" ko="추가로 알려주실 내용" /></label>
          <textarea class="form-control" id="context" name="context" placeholder={isEnglish ? 'Recent grades, a deadline coming up, or a subject that has been a struggle' : '최근 성적, 다가오는 마감일 또는 어려움을 겪는 과목'}></textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--lg contact-submit">
          <span><T en="Send message" ko="문의 보내기" /></span>
          <span class="btn__disc" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </button>

        <p class="form-done" role="status" hidden data-done>
          <strong><T en="Thank you." ko="감사합니다." /></strong> <T en="We have your details and will reply within one business day with next steps." ko="내용을 확인했으며 영업일 기준 하루 안에 다음 단계를 안내해 드리겠습니다." />
        </p>
      </form>

      <aside class="contact-aside">
        <div class="contact-card">
          <Eyebrow label="Standing facts" labelKo="기본 안내" />
          <ul class="fact-list">
            <li><span class="fact-k"><T en="Email" ko="이메일" /></span><span class="fact-v">admissions@seonbaetutor.com</span></li>
            <li><span class="fact-k"><T en="Reply time" ko="답변 시간" /></span><span class="fact-v"><T en="Within one business day" ko="영업일 기준 하루 안" /></span></li>
            <li><span class="fact-k"><T en="Based in" ko="운영 지역" /></span><span class="fact-v"><T en="Songdo, Incheon · lessons worldwide" ko="인천 송도 · 전 세계 온라인 수업" /></span></li>
            <li><span class="fact-k"><T en="Languages" ko="언어" /></span><span class="fact-v"><T en="Korean and English" ko="한국어·영어" /></span></li>
          </ul>
        </div>
        <div class="contact-card contact-card--soft">
          <h2 class="h3" style="font-size:1.25rem"><T en="Ready to start?" ko="바로 시작할까요?" /></h2>
          <p class="body" style="margin-top:10px"><T en="If you already know what you need, the matching form is the fastest way in." ko="필요한 내용을 알고 있다면 매칭 신청서가 가장 빠른 방법입니다." /></p>
          <a href={link('/get-matched')} class="textlink" style="margin-top:14px"><T en="Get matched" ko="매칭 시작하기" />
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: clamp(28px, 5vw, 72px); align-items: start; max-width: 1080px; }
  .contact-form { display: flex; flex-direction: column; gap: 16px; }
  .contact-submit { align-self: flex-start; margin-top: 8px; }
  .form-done {
    background: var(--mint-surface);
    color: #003a6c;
    padding: 16px 20px;
    border-radius: var(--r-md);
    font-size: 0.98rem;
  }
  .contact-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(22px, 2.6vw, 28px); margin-bottom: 16px; }
  .contact-card--soft { background: var(--p2); border-color: transparent; }
  .fact-list { display: flex; flex-direction: column; gap: 14px; margin-top: 18px; }
  .fact-list li { display: flex; flex-direction: column; gap: 2px; }
  .fact-k { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .fact-v { font-weight: 500; color: var(--ink); font-size: 0.95rem; }
  @media (max-width: 860px) { .contact-layout { grid-template-columns: 1fr; } }
</style>

<script>
  import { submitForm, validate } from '../lib/forms';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = form?.querySelector('.contact-submit') as HTMLButtonElement | null;
  const btnLabel = btn?.querySelector('span:first-child') as HTMLElement | null;
  const language = () => (document.documentElement.dataset.lang === 'ko' ? 'ko' : 'en');
  const localized = (en: string, ko: string) => (language() === 'ko' ? ko : en);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate(form)) return;

    const original = btnLabel?.textContent ?? '';
    let keepDisabled = false;
    if (btn) btn.disabled = true;
    if (btnLabel) btnLabel.textContent = localized('Sending…', '전송 중…');

    try {
      const mode = await submitForm(form, 'New enquiry from seonbaetutor.com');
      const done = form.querySelector('[data-done]') as HTMLElement | null;
      if (done) {
        done.textContent =
          mode === 'email'
            ? localized(
                'Your email app is opening with your answers filled in. Send it and we will reply within one business day.',
                '작성 내용이 담긴 이메일 앱을 열고 있습니다. 전송해 주시면 영업일 기준 하루 안에 답변드리겠습니다.',
              )
            : localized('Thank you. We will reply within one business day.', '감사합니다. 영업일 기준 하루 안에 답변드리겠습니다.');
        done.hidden = false;
        done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (mode === 'posted') {
        keepDisabled = true;
        form.querySelectorAll('input, select, textarea, .contact-submit').forEach((el) => {
          if (el instanceof HTMLElement && !el.closest('.form-done')) (el as HTMLInputElement).disabled = true;
        });
      }
    } catch {
      const done = form.querySelector('[data-done]') as HTMLElement | null;
      if (done) {
        done.textContent = localized(
          'Something went wrong. Please email admissions@seonbaetutor.com and we will pick it up straight away.',
          '문제가 발생했습니다. admissions@seonbaetutor.com으로 이메일을 보내주시면 바로 확인하겠습니다.',
        );
        done.hidden = false;
      }
    } finally {
      if (btn && !keepDisabled) btn.disabled = false;
      if (btnLabel && !keepDisabled) btnLabel.textContent = original;
    }
  });
</script>
