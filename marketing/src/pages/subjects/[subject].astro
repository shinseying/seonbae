---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import SubjectCard from '../../components/SubjectCard.astro';
import RateBrowser from '../../components/RateBrowser.astro';
import { won } from '../../lib/format';
import { ratesFor, priceRange, type CurriculumSlug } from '../../data/rates';
import { examsFor } from '../../data/exams';
import T from '../../components/T.astro';
import { subjectsKo } from '../../i18n/content';

export async function getStaticPaths() {
  const subjects = await getCollection('subjects');
  return subjects.map((entry) => ({ params: { subject: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const s = entry.data;
const { Content } = await render(entry);

const all = (await getCollection('subjects')).sort((a, b) => a.data.order - b.data.order);
const related = all.filter((x) => x.id !== entry.id).slice(0, 3);

// Prices are per subject, so this page publishes the whole sheet for this
// curriculum rather than a single "from" figure.
const slug = entry.id as CurriculumSlug;
const curriculumRates = ratesFor(slug);
const curriculumExams = examsFor(slug);
const span = curriculumRates.length ? priceRange(curriculumRates) : null;
const ko = subjectsKo[entry.id];
---
<Base title={`${s.title} tutoring | Seonbae`} description={s.summary} active="/subjects">
  <section class="subj-hero has-contour">
    <div class="container">
      <div class="reveal is-in subj-lead">
        <a href="/subjects" class="back-link">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <T en="All subjects" ko="전체 과목" />
        </a>
        <h1 class="subj-title"><T en={s.title} ko={ko?.title ?? s.title} /></h1>
        <p class="lead" style="margin-top:16px"><T en={s.summary} ko={ko?.summary ?? s.summary} /></p>
        <div class="subj-pills">
          {s.levels.map((l, i) => <span class="pill pill--violet"><T en={l} ko={ko?.levels[i] ?? l} /></span>)}
        </div>
        <div class="subj-meta">
          {curriculumRates.length > 0 && (
            <span class="subj-fact"><strong>{curriculumRates.length}</strong> <T en="subjects, each priced on its own" ko="개 과목, 과목별 개별 요금" /></span>
          )}
          {s.tutorCount > 0 && <span class="subj-fact"><strong>{s.tutorCount}</strong> <T en="verified tutors" ko="명의 검증된 튜터" /></span>}
        </div>
        <div class="cta-row" style="margin-top:26px">
          <Button href="/get-matched" label="Get matched" labelKo="매칭 시작하기" variant="primary" size="lg" arrow="diag" />
          {curriculumRates.length > 0 && <Button href="#rates" label="See every price" labelKo="전체 요금 보기" variant="text" arrow="right" />}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container subj-layout">
      <div class="subj-main prose">
        <div data-l="en"><Content /></div>
        <div data-l="ko" class="kr">{(ko?.body ?? []).map((paragraph) => <p>{paragraph}</p>)}</div>
      </div>
      <aside class="study-scope reveal">
        <h2><T en="What we will study together" ko="함께 공부할 내용" /></h2>
        <ul>
          {s.topics.map((topic, index) => (
            <li><T en={topic} ko={ko?.topics[index] ?? topic} /></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {curriculumRates.length > 0 && span && (
    <section class="section bg-cream" id="rates">
      <div class="container">
        <div class="sec-head reveal">
          <div>
            <Eyebrow label="Prices" labelKo="요금" />
            <h2 class="h2"><T en={`Every ${s.title} subject, priced.`} ko={`${ko?.title ?? s.title} 전 과목 요금.`} /></h2>
          </div>
          <p class="rates-note"><T en={`From ${won(span.min)} to ${won(span.max)} an hour. The rate depends on the subject, not the curriculum.`} ko={`시간당 ${won(span.min)}부터 ${won(span.max)}까지. 요금은 커리큘럼이 아니라 과목에 따라 달라집니다.`} /></p>
        </div>
        <div class="reveal">
          <RateBrowser curricula={[{ slug, label: s.title }]} id={`rates-${slug}`} surface="cream" />
        </div>
      </div>
    </section>
  )}

  {curriculumExams.length > 0 && (
    <section class="mock-subject bg-cream">
      <div class="container mock-subject__inner reveal">
        <div class="mock-subject__copy">
          <h2 class="h3"><T en="Practise before it counts." ko="실전 전에 먼저 연습하세요." /></h2>
          <p class="body"><T en={`Mock exams and level tests for ${s.title} are timed in the portal and returned with detailed feedback.`} ko={`${ko?.title ?? s.title} 모의고사와 레벨 테스트를 포털에서 응시하고 자세한 피드백을 받아보세요.`} /></p>
          <div class="cta-row">
            <Button href="/mock-exams" label="See mock exams" labelKo="모의고사 보기" variant="primary" arrow="right" class="mock-subject__cta" />
          </div>
        </div>
        <div class="available-mocks">
          <h3><T en="Available mocks" ko="응시 가능한 모의고사" /></h3>
          <ul>
            {curriculumExams.map((exam) => (
              <li>
                <span><T en={exam.name} ko={exam.nameKo} /></span>
                <strong>{won(exam.price)}</strong>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section bg-white section--tight">
    <div class="container subject-cta reveal">
      <div>
        <h2 class="h2"><T en="The right tutor is one conversation away." ko="나만의 선배를 지금 만나보세요." /></h2>
        <p class="lead"><T en="Tell us about your goals and we will match you with a tutor from Korea’s top universities." ko="목표를 알려주시면 대한민국 최상위 대학 출신의 선배와 매칭해 드립니다." /></p>
      </div>
      <Button href="/get-matched" label="Get matched" labelKo="매칭 시작하기" variant="primary" size="lg" arrow="diag" />
    </div>
  </section>


  <section class="section bg-cream">
    <div class="container">
      <div class="sec-head reveal">
        <div>
          <Eyebrow label="Keep exploring" labelKo="더 살펴보기" />
          <h2 class="h2"><T en="Other subjects." ko="다른 과목." /></h2>
        </div>
        <Button href="/subjects" label="Browse all" labelKo="전체 보기" variant="text" arrow="right" />
      </div>
      <div class="grid three-col">
        {related.map((r) => <div class="reveal"><SubjectCard entry={r} variant="grid" /></div>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .subj-hero { position: relative; background: var(--canvas); padding-block: clamp(44px, 7vw, 96px); overflow: hidden; }
  .subj-lead { max-width: 46rem; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 600; color: var(--muted); margin-bottom: 22px; }
  .back-link svg { width: 16px; height: 16px; }
  .back-link:hover { color: var(--violet); }
  .subj-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-top: 14px;
  }
  .subj-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .subj-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 26px; margin-top: 22px; }
  .subj-fact { font-size: 0.94rem; color: var(--muted); }
  .subj-fact strong { font-family: var(--display); font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--ink); margin-right: 4px; }
  .rates-note { font-size: 0.94rem; color: var(--muted); max-width: 34ch; }

  .mock-subject { padding-bottom: clamp(54px, 8vw, 104px); }
  .mock-subject__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 68px);
    align-items: center;
    padding-block: clamp(28px, 4vw, 44px);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .mock-subject__inner .body { margin-top: 10px; max-width: 34rem; }
  .mock-subject__copy .cta-row { margin-top: 22px; justify-content: flex-start; }
  /* Keep the CTA at its own intrinsic width: it sits in a grid column, and
     without this it stretches the full column and reads as a banner. */
  .mock-subject__copy .cta-row :global(.btn) { flex: 0 0 auto; width: auto; align-self: flex-start; }
  .mock-subject__copy :global(.mock-subject__cta) { padding: 10px 12px 10px 24px; }
  .available-mocks h3,
  .study-scope h2 { font-family: var(--display); font-size: 1rem; font-weight: 750; letter-spacing: -0.01em; }
  .available-mocks ul { margin-top: 14px; border-top: 1px solid var(--line); }
  .available-mocks li { display: flex; justify-content: space-between; gap: 20px; padding: 13px 0; border-bottom: 1px solid var(--line); color: var(--muted); line-height: 1.4; }
  .available-mocks strong { flex: none; color: var(--ink); font-variant-numeric: tabular-nums; }
  .subj-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 0.38fr); gap: clamp(34px, 7vw, 88px); align-items: start; }
  .subj-main { max-width: 54rem; }
  .study-scope { padding-top: 4px; border-top: 2px solid var(--ink); }
  .study-scope h2 { padding-top: 18px; }
  .study-scope ul { margin-top: 16px; }
  .study-scope li { padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--muted); }
  .prose :global(p) { color: var(--muted); font-size: 1.08rem; line-height: 1.7; margin-bottom: 1.1em; }
  .prose :global(p:first-child) { font-size: 1.2rem; color: var(--ink); }
  .subject-cta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(24px, 5vw, 64px); align-items: end; padding-top: clamp(28px, 4vw, 44px); border-top: 2px solid var(--ink); }
  .subject-cta .lead { margin-top: 16px; max-width: 46rem; }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(28px, 4vw, 44px); flex-wrap: wrap; }
  .sec-head .h2 { margin-top: 12px; }

  @media (max-width: 860px) {
    .mock-subject__inner,
    .subj-layout,
    .subject-cta { grid-template-columns: 1fr; align-items: start; }
  }
</style>
